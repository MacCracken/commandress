# Inside a table it is that table's key. Under [[prompt]] the allow-list says so.
fn test_palette_selector_must_be_top_level(): i64 {
    var c = _load_capturing_stderr("pal-misplaced", "[[prompt]]\npalette = \"day\"\n[[palettes.day]]\na = \"blue\"\n[[segments.cwd]]\nfg = \"palette:a\"\n");
    assert_eq(cfg_sgr_cwd(c), 0, "a selector under [[prompt]] selects nothing");
    _streq_or_dump(_captured_err, "warning: unknown config field 'palette' in [[prompt]] (ignored)\n", "and says why");
    return 0;
}

# ---- render_prompt, byte for byte ----

# What render_prompt writes to stdout, as a cstring. The suite never ran this function
# until 1.3.0, so nothing pinned a transition, a trailer or a call to the sanitizer.
fn _render_capture(cfg, ctx, side): i64 {
    var path = "/tmp/cmdrs-test-render-out";
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0x180);
    assert(fd >= 0, "open the capture file");
    var saved = syscall(SYS_DUP, 1);
    sys_dup2(fd, 1);
    file_close(fd);
    render_prompt(cfg, ctx, side);
    sys_dup2(saved, 1);
    file_close(saved);
    var buf = alloc(4096);
    var n = file_read_all(path, buf, 4095);
    syscall(SYS_UNLINK, path);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    return buf;
}

# Two blocks: `time` renders T on blue, `exit` renders [7]. `segs` is the line choosing
# the segments, and `extra` is any more of the exit section.
fn _powerline_config(segs, extra): i64 {
    var head = "[[prompt]]\n";
    var rest = "separator_style = \"powerline\"\nseparator_glyph = \">\"\nright_separator_glyph = \"<\"\ntrailer = \"$ \"\n[[segments.time]]\nformat = \"T\"\nfg = \"black\"\nbg = \"blue\"\n[[segments.exit]]\nfg = \"white\"\n";
    var buf = alloc(1024);
    var n = 0;
    memcpy(buf + n, head, strlen(head));
    n = n + strlen(head);
    memcpy(buf + n, segs, strlen(segs));
    n = n + strlen(segs);
    memcpy(buf + n, rest, strlen(rest));
    n = n + strlen(rest);
    memcpy(buf + n, extra, strlen(extra));
    n = n + strlen(extra);
    store8(buf + n, 0);
    var path = _write_test_config("powerline-render", buf);
    var c = config_load(path);
    syscall(SYS_UNLINK, path);
    return c;
}

# The left prompt must not move. These are the bytes it has always produced.
fn test_render_powerline_left(): i64 {
    var c = _powerline_config("segments = [\"time\", \"exit\"]\n", "bg = \"red\"\n");
    _streq_or_dump(_render_capture(c, context_new(0, 7), 0),
        "\x1b[30;44mT\x1b[0m\x1b[34;41m>\x1b[0m\x1b[37;41m[7]\x1b[0m\x1b[31m>\x1b[0m$ ",
        "left: glyph between blocks, closing glyph after the last");
    return 0;
}

# A left-pointing glyph is filled by the block on its RIGHT, over the block on its left.
# So it opens the first block, sits between blocks with those colours swapped, and
# nothing trails the last block.
fn test_render_powerline_right(): i64 {
    var c = _powerline_config("right_segments = [\"time\", \"exit\"]\n", "bg = \"red\"\n");
    _streq_or_dump(_render_capture(c, context_new(0, 7), 1),
        "\x1b[34m<\x1b[0m\x1b[30;44mT\x1b[0m\x1b[31;44m<\x1b[0m\x1b[37;41m[7]\x1b[0m",
        "right: glyph leads each block, nothing trails");
    return 0;
}

# A segment with no `bg` has no block to open. Same rule as the left prompt's closer.
fn test_render_powerline_right_no_block_no_glyph(): i64 {
    var c = _powerline_config("right_segments = [\"exit\", \"time\"]\n", "");
    _streq_or_dump(_render_capture(c, context_new(0, 7), 1),
        "\x1b[37m[7]\x1b[0m\x1b[34m<\x1b[0m\x1b[30;44mT\x1b[0m",
        "right: a first segment with no bg has no leading glyph");
    return 0;
}

# An empty segment paints nothing, so it must not leave a glyph behind.
fn test_render_powerline_right_skips_empty_segment(): i64 {
    var c = _powerline_config("right_segments = [\"exit\", \"time\"]\n", "bg = \"red\"\n");
    _streq_or_dump(_render_capture(c, context_new(0, 0), 1),
        "\x1b[34m<\x1b[0m\x1b[30;44mT\x1b[0m",
        "right: the hidden exit segment opens nothing");
    return 0;
}

fn test_render_plain_right_has_no_trailer(): i64 {
    var content = "[[prompt]]\nright_segments = [\"time\"]\ntrailer = \"$ \"\n[[segments.time]]\nformat = \"T\"\nfg = \"default\"\n";
    var path = _write_test_config("plain-right", content);
    var c = config_load(path);
    syscall(SYS_UNLINK, path);
    _streq_or_dump(_render_capture(c, context_new(0, 0), 1), "T", "right prompt: no trailer");
    return 0;
}

# The chokepoint itself, which only smoke.sh could see until this file included render.cyr.
fn test_render_sanitizes_segment_output(): i64 {
    var content = "[[prompt]]\nsegments = [\"time\"]\ntrailer = \"\"\n[[segments.time]]\nformat = \"a\\u001b[31mb\"\nfg = \"default\"\n";
    var path = _write_test_config("chokepoint", content);
    var c = config_load(path);
    syscall(SYS_UNLINK, path);
    _streq_or_dump(_render_capture(c, context_new(0, 0), 0), "a[31mb", "render_prompt filters what a segment returns");
    return 0;
}

# ---- hex and 256-colour values (ADR 0007 § 3) ----

fn test_color_256_index(): i64 {
    _streq_or_dump(sgr_open_for("33", 0, 0), "\x1b[38;5;33m", "fg index");
    _streq_or_dump(sgr_open_for(0, "200", 0), "\x1b[48;5;200m", "bg index");
    _streq_or_dump(sgr_open_for("0", 0, 0), "\x1b[38;5;0m", "index 0 is a colour, not an absence");
    _streq_or_dump(sgr_open_for("255", "0", 0), "\x1b[38;5;255;48;5;0m", "both ends of the range");
    return 0;
}

fn test_color_hex(): i64 {
    _streq_or_dump(sgr_open_for("#8be9fd", 0, 0), "\x1b[38;2;139;233;253m", "fg hex");
    _streq_or_dump(sgr_open_for(0, "#5FAFFF", 0), "\x1b[48;2;95;175;255m", "bg hex, upper case");
    _streq_or_dump(sgr_open_for("#000000", 0, 0), "\x1b[38;2;0;0;0m", "black is a colour, not an absence");
    return 0;
}

fn test_color_forms_combine(): i64 {
    _streq_or_dump(sgr_open_for("#010203", "200", "bold"), "\x1b[1;38;2;1;2;3;48;5;200m", "mods, then fg, then bg");
    _streq_or_dump(sgr_open_for("red", "#010203", 0), "\x1b[31;48;2;1;2;3m", "named beside hex");
    # The longest SGR this function can build.
    var longest = sgr_open_for("#ffffff", "#ffffff", "bold italic underline reverse");
    assert_eq(strlen(longest), 44, "every code at its longest fits the buffer");
    return 0;
}

# Reserved at 0.6.0 as "no code, never errors", and that still holds for anything that is
# not exactly these forms. Nothing from the value is copied into the escape: it is parsed
# to integers and formatted again, so `33;1` or `#ff0000m` cannot add a parameter.
fn test_color_malformed_is_no_code(): i64 {
    assert_eq(sgr_open_for("256", 0, 0), 0, "past the 256-colour range");
    assert_eq(sgr_open_for("999", 0, 0), 0, "well past it");
    assert_eq(sgr_open_for("1000", 0, 0), 0, "too many digits");
    assert_eq(sgr_open_for("0033", 0, 0), 0, "too many digits, even in range");
    assert_eq(sgr_open_for("33;1", 0, 0), 0, "no smuggled parameter");
    assert_eq(sgr_open_for("-1", 0, 0), 0, "no sign");
    assert_eq(sgr_open_for("3a", 0, 0), 0, "not all digits");
    assert_eq(sgr_open_for("#abc", 0, 0), 0, "the short form was not reserved");
    assert_eq(sgr_open_for("#ff00000", 0, 0), 0, "too long");
    assert_eq(sgr_open_for("#ff000", 0, 0), 0, "too short");
    assert_eq(sgr_open_for("#ff00g0", 0, 0), 0, "not all hex");
    assert_eq(sgr_open_for("#", 0, 0), 0, "a lone hash");
    assert_eq(sgr_open_for("ff0000", 0, 0), 0, "no hash");
    return 0;
}

# Every byte value in every position of each form, so a range check cannot be off by one.
fn test_color_parser_exhaustive(): i64 {
    var buf = alloc(8);
    var bad = 0;
    var pos = 1;
    while (pos < 7) {
        var b = 1;
        while (b < 256) {
            memcpy(buf, "#000000", 8);
            store8(buf + pos, b);
            var is_hex = 0;
            if (b >= 48) { if (b <= 57) { is_hex = 1; } }
            if (b >= 65) { if (b <= 70) { is_hex = 1; } }
            if (b >= 97) { if (b <= 102) { is_hex = 1; } }
            var got = sgr_open_for(buf, 0, 0);
            if (is_hex == 1) { if (got == 0) { bad = bad + 1; } }
            if (is_hex == 0) { if (got != 0) { bad = bad + 1; } }
            b = b + 1;
        }
        pos = pos + 1;
    }
    assert_eq(bad, 0, "exactly the hex digits are accepted, in every position");
    var n = 0;
    while (n < 1000) {
        var len = fmt_int_buf(n, buf);
        store8(buf + len, 0);
        var got = sgr_open_for(buf, 0, 0);
        if (n <= 255) { if (got == 0) { bad = bad + 1; } }
        if (n > 255) { if (got != 0) { bad = bad + 1; } }
        n = n + 1;
    }
    assert_eq(bad, 0, "exactly 0..255 are accepted");
    return 0;
}

fn test_config_colors_through_palette_and_blocks(): i64 {
    var content = "[[palette]]\naccent = \"#8be9fd\"\nmuted = \"244\"\n[[prompt]]\nsegments = [\"time\"]\ntrailer = \"\"\n[[segments.time]]\nformat = \"T\"\nfg = \"palette:accent\"\nbg = \"palette:muted\"\n";
    var path = _write_test_config("palette-hex", content);
    var c = config_load(path);
    syscall(SYS_UNLINK, path);
    _streq_or_dump(cfg_sgr_time(c), "\x1b[38;2;139;233;253;48;5;244m", "a palette slot can hold either form");
    return 0;
}

# A transition reuses the raw bg value, so the new forms must work there too.
fn test_render_powerline_with_new_colors(): i64 {
    var content = "[[prompt]]\nsegments = [\"time\", \"exit\"]\nseparator_style = \"powerline\"\nseparator_glyph = \">\"\ntrailer = \"\"\n[[segments.time]]\nformat = \"T\"\nfg = \"default\"\nbg = \"#010203\"\n[[segments.exit]]\nfg = \"default\"\nbg = \"33\"\n";
    var path = _write_test_config("powerline-hex", content);
    var c = config_load(path);
    syscall(SYS_UNLINK, path);
    _streq_or_dump(_render_capture(c, context_new(0, 7), 0),
        "\x1b[48;2;1;2;3mT\x1b[0m\x1b[38;2;1;2;3;48;5;33m>\x1b[0m\x1b[48;5;33m[7]\x1b[0m\x1b[38;5;33m>\x1b[0m",
        "a block's colour becomes the glyph's fg");
    return 0;
}

fn test_config_load_full_override(): i64 {
    var content = "[[prompt]]\nsegments = [\"exit\", \"cwd\"]\nseparator = \" | \"\ntrailer = \" > \"\n\n[[segments.cwd]]\nhome_shorten = false\n\n[[segments.exit]]\nhide_zero = false\n";
    var path = _write_test_config("full", content);
    var c = config_load(path);
    _streq_or_dump(cfg_separator(c), " | ", "override separator");
    _streq_or_dump(cfg_trailer(c), " > ", "override trailer");
    assert_eq(cfg_cwd_home_shorten(c), 0, "override cwd_home_shorten == 0");
    assert_eq(cfg_exit_hide_zero(c), 0, "override exit_hide_zero == 0");
    var segs = cfg_segments(c);
    assert_eq(vec_len(segs), 2, "override segments length == 2");
    _streq_or_dump(vec_get(segs, 0), "exit", "override segments[0] == \"exit\"");
    _streq_or_dump(vec_get(segs, 1), "cwd", "override segments[1] == \"cwd\"");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_partial_override(): i64 {
    # Only separator set — everything else must fall back to defaults.
    var content = "[[prompt]]\nseparator = \"::\"\n";
    var path = _write_test_config("partial", content);
    var c = config_load(path);
    _streq_or_dump(cfg_separator(c), "::", "partial override separator");
    _streq_or_dump(cfg_trailer(c), " $ ", "partial override trailer == default");
    assert_eq(cfg_cwd_home_shorten(c), 1, "partial override cwd_home_shorten == default");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_vcs_section(): i64 {
    var content = "[[segments.vcs]]\nshow_dirty = false\ndirty_marker = \"!\"\n";
    var path = _write_test_config("vcs", content);
    var c = config_load(path);
    assert_eq(cfg_vcs_show_dirty(c), 0, "vcs show_dirty override == 0");
    _streq_or_dump(cfg_vcs_dirty_marker(c), "!", "vcs dirty_marker override == \"!\"");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_default_vcs_fields(): i64 {
    var c = config_default();
    assert_eq(cfg_vcs_show_dirty(c), 1, "default vcs show_dirty == 1");
    _streq_or_dump(cfg_vcs_dirty_marker(c), "*", "default vcs dirty_marker == \"*\"");
    return 0;
}

# ---- config: default theme ----

fn test_config_default_theme_bakes_sgr(): i64 {
    var c = config_default();
    # Spot-check that every segment got an SGR string baked in. The
    # exact bytes are validated against the color module's known output
    # — anchored on cwd (cyan + bold) and exit (red + bold).
    _streq_or_dump(cfg_sgr_cwd(c),  "\x1b[1;36m", "default theme cwd == bold cyan");
    _streq_or_dump(cfg_sgr_exit(c), "\x1b[1;31m", "default theme exit == bold red");
    assert_neq(cfg_sgr_vcs(c),        0, "default theme vcs != 0");
    assert_neq(cfg_sgr_time(c),       0, "default theme time != 0");
    assert_neq(cfg_sgr_hostname(c),   0, "default theme hostname != 0");
    assert_neq(cfg_sgr_user(c),       0, "default theme user != 0");
    assert_neq(cfg_sgr_cyrius_env(c), 0, "default theme cyrius_env != 0");
    assert_neq(cfg_sgr_python_env(c), 0, "default theme python_env != 0");
    assert_neq(cfg_sgr_node_env(c),   0, "default theme node_env != 0");
    assert_neq(cfg_sgr_rustup_env(c), 0, "default theme rustup_env != 0");
    return 0;
}

# Partial-override safety: a [[segments.cwd]] block that only sets
# home_shorten (no color fields) must NOT clobber the default theme SGR.
fn test_config_load_color_partial_keeps_default(): i64 {
    var content = "[[segments.cwd]]\nhome_shorten = false\n";
    var path = _write_test_config("color-partial", content);
    var c = config_load(path);
    assert_eq(cfg_cwd_home_shorten(c), 0, "home_shorten override applied");
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[1;36m", "default cwd theme survives boolean-only override");
    syscall(SYS_UNLINK, path);
    return 0;
}

# Color override: touching any color field replaces the SGR entirely
# (full-override semantic — see schema comment in config.cyr).
fn test_config_load_color_fg_only_overrides(): i64 {
    var content = "[[segments.cwd]]\nfg = \"red\"\n";
    var path = _write_test_config("color-fg-only", content);
    var c = config_load(path);
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[31m", "fg=red overrides default cwd theme to plain red");
    syscall(SYS_UNLINK, path);
    return 0;
}

# Full reset: fg=default + style="" strips colors entirely.
fn test_config_load_color_reset_to_plain(): i64 {
    var content = "[[segments.cwd]]\nfg = \"default\"\nstyle = \"\"\n";
    var path = _write_test_config("color-reset", content);
    var c = config_load(path);
    assert_eq(cfg_sgr_cwd(c), 0, "fg=default + empty style clears cwd SGR");
    syscall(SYS_UNLINK, path);
    return 0;
}

# Color-only section (hostname has no other knobs in v0.6.0).
fn test_config_load_color_only_hostname(): i64 {
    var content = "[[segments.hostname]]\nfg = \"yellow\"\nstyle = \"underline\"\n";
    var path = _write_test_config("color-hostname", content);
    var c = config_load(path);
    _streq_or_dump(cfg_sgr_hostname(c), "\x1b[4;33m", "hostname fg+style override");
    syscall(SYS_UNLINK, path);
    return 0;
}

# Env-segment color override exercises the same _load_color_only_section
# code path as hostname/user, ensuring all four env segments are wired.
fn test_config_load_color_only_python_env(): i64 {
    var content = "[[segments.python_env]]\nfg = \"bright_blue\"\n";
    var path = _write_test_config("color-py", content);
    var c = config_load(path);
    _streq_or_dump(cfg_sgr_python_env(c), "\x1b[94m", "python_env fg override");
    syscall(SYS_UNLINK, path);
    return 0;
}

# ---- config: palette ----

fn test_config_load_palette_resolves_ref(): i64 {
    var content = "[[palette]]\nprimary = \"cyan\"\n\n[[segments.cwd]]\nfg = \"palette:primary\"\nstyle = \"bold\"\n";
    var path = _write_test_config("palette-ref", content);
    var c = config_load(path);
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[1;36m", "palette:primary → cyan resolves to bold cyan SGR");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_palette_multi_slot(): i64 {
    var content = "[[palette]]\nprimary = \"cyan\"\nerror   = \"red\"\n\n[[segments.cwd]]\nfg = \"palette:primary\"\n\n[[segments.exit]]\nfg = \"palette:error\"\nstyle = \"bold\"\n";
    var path = _write_test_config("palette-multi", content);
    var c = config_load(path);
    _streq_or_dump(cfg_sgr_cwd(c),  "\x1b[36m",   "palette:primary → cyan (cwd)");
    _streq_or_dump(cfg_sgr_exit(c), "\x1b[1;31m", "palette:error → red bold (exit)");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_palette_unknown_ref(): i64 {
    # Unknown palette name → resolves to 0 → SGR emits no fg code. With
    # no other styling, the segment ends up unstyled.
    var content = "[[palette]]\nprimary = \"cyan\"\n\n[[segments.cwd]]\nfg = \"palette:typo\"\n";
    var path = _write_test_config("palette-unknown", content);
    var c = config_load(path);
    assert_eq(cfg_sgr_cwd(c), 0, "unknown palette ref leaves segment unstyled");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_palette_mixed_with_raw(): i64 {
    # Mixing palette refs and raw colors in the same config works —
    # raw values pass through `_resolve_color_value` unchanged.
    var content = "[[palette]]\naccent = \"magenta\"\n\n[[segments.cwd]]\nfg = \"yellow\"\n\n[[segments.cyrius_env]]\nfg = \"palette:accent\"\n";
    var path = _write_test_config("palette-mixed", content);
    var c = config_load(path);
    _streq_or_dump(cfg_sgr_cwd(c),        "\x1b[33m", "raw \"yellow\" on cwd");
    _streq_or_dump(cfg_sgr_cyrius_env(c), "\x1b[35m", "palette:accent → magenta on cyrius_env");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_palette_absent_behaves_like_before(): i64 {
    # No [[palette]] section; raw color still works.
    var content = "[[segments.cwd]]\nfg = \"red\"\n";
    var path = _write_test_config("no-palette", content);
    var c = config_load(path);
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[31m", "absent palette doesn't break raw color");
    syscall(SYS_UNLINK, path);
    return 0;
}

# ---- config: right-prompt ----

fn test_config_default_right_segments_empty(): i64 {
    var c = config_default();
    var rsegs = cfg_right_segments(c);
    assert_neq(rsegs, 0, "default right_segments returns a vec (not null)");
    assert_eq(vec_len(rsegs), 0, "default right_segments is empty");
    return 0;
}

fn test_config_load_right_segments(): i64 {
    var content = "[[prompt]]\nright_segments = [\"time\", \"cyrius_env\"]\n";
    var path = _write_test_config("rprompt", content);
    var c = config_load(path);
    var rsegs = cfg_right_segments(c);
