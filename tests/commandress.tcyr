# TOML: `[[palettes.day.warm]]` defines `palettes.day` as well, with no header of its own.
fn test_palette_implicit_table_is_a_palette(): i64 {
    var c = _load_capturing_stderr("pal-implicit", "palette = \"day\"\n[[palettes.day.warm]]\nx = \"red\"\n[[segments.cwd]]\nfg = \"palette:warm.x\"\n");
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[31m", "its slots load as dotted names");
    _streq_or_dump(_captured_err, "", "and it is no typo");
