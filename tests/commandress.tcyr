fn _streq_or_dump(got, want, name): i64 {
    if (streq(got, want) == 1) {
        assert(1, name);
    } else {
        assert(0, name);
        syscall(1, 2, "    got:  ", 10);
        syscall(1, 2, got, strlen(got));
        syscall(1, 2, "\n    want: ", 11);
        syscall(1, 2, want, strlen(want));
        syscall(1, 2, "\n", 1);
    }
    return 0;
}

# ---- exit segment ----

fn test_exit_zero_empty(): i64 {
    var out = exit_render(0);
    assert_eq(out, 0, "exit(0) renders empty");
    return 0;
}

fn test_exit_nonzero_brackets(): i64 {
    var out = exit_render(42);
    assert_neq(out, 0, "exit(42) not empty");
    _streq_or_dump(out, "[42]", "exit(42) == \"[42]\"");
    return 0;
}

fn test_exit_negative(): i64 {
    var out = exit_render(0 - 1);
    assert_neq(out, 0, "exit(-1) not empty");
    _streq_or_dump(out, "[-1]", "exit(-1) == \"[-1]\"");
    return 0;
}

# ---- cwd segment ----

fn test_cwd_no_home(): i64 {
    var out = cwd_render(0, 0);
    assert_neq(out, 0, "cwd_render(home=0) returns a path");
    assert_eq(load8(out), 47, "cwd_render(home=0) starts with '/'");
    return 0;
}

fn test_cwd_home_mismatch(): i64 {
    var out = cwd_render("/nonexistent/never/matches/this", 0);
    assert_neq(out, 0, "cwd_render(bad-home) returns a path");
    assert_eq(load8(out), 47, "cwd_render(bad-home) keeps absolute path");
    return 0;
}

fn test_cwd_home_prefix_exact(): i64 {
    var buf[4096];
    var n = syscall(SYS_GETCWD, &buf, 4096);
    if (n <= 2) { assert(1, "cwd_home_prefix_exact skipped (cwd too short)"); return 0; }
    n = n - 1;
    var fake = alloc(n + 1);
    memcpy(fake, &buf, n);
    store8(fake + n, 0);
    var out = cwd_render(fake, 0);
    _streq_or_dump(out, "~", "cwd_render(home==cwd) == \"~\"");
    return 0;
}

fn test_cwd_home_strict_prefix(): i64 {
    var buf[4096];
    var n = syscall(SYS_GETCWD, &buf, 4096);
    if (n <= 2) { assert(1, "cwd_home_strict_prefix skipped"); return 0; }
    n = n - 1;
    var sep = 0 - 1;
    var si = 0;
    while (si < n) {
        if (load8(&buf + si) == 47) { sep = si; }
        si = si + 1;
    }
    if (sep <= 0) { assert(1, "cwd_home_strict_prefix skipped (cwd is root)"); return 0; }
    var fake = alloc(sep + 1);
    memcpy(fake, &buf, sep);
    store8(fake + sep, 0);
    var out = cwd_render(fake, 0);
    assert_neq(out, 0, "cwd_render(home==parent) not empty");
    assert_eq(load8(out), 126, "cwd_render(home==parent) starts '~'");
    assert_eq(load8(out + 1), 47, "cwd_render(home==parent) byte 1 == '/'");
    return 0;
}

# max_length truncation — driven by the pure _truncate_cwd helper so
# we can assert exact bytes without depending on the test process's
# actual cwd length.

fn test_truncate_cwd_no_op_zero(): i64 {
    var p = "/home/user/Repos/commandress";
    var out = _truncate_cwd(p, strlen(p), 0);
    assert_eq(out, p, "max_length=0 returns input unchanged");
    return 0;
}

fn test_truncate_cwd_no_op_within_budget(): i64 {
    var p = "/short";
    var out = _truncate_cwd(p, strlen(p), 40);
    assert_eq(out, p, "path within budget returns input unchanged");
    return 0;
}

fn test_truncate_cwd_collapses_at_slash(): i64 {
    var p = "/home/macro/Repos/commandress/src";    # 33 bytes
    var out = _truncate_cwd(p, strlen(p), 20);
    # budget = 17. Earliest '/' with suffix <= 17 is at index 17 ('/'
    # before "commandress"). Result: "..." + "/commandress/src" = 19.
    _streq_or_dump(out, ".../commandress/src", "truncate(20) keeps suffix at '/' boundary");
    return 0;
}

fn test_truncate_cwd_exact_budget(): i64 {
    var p = "/a/bb/ccc/dddd";       # 14 bytes
    var out = _truncate_cwd(p, strlen(p), 14);
    assert_eq(out, p, "exact-length path returns unchanged");
    return 0;
}

fn test_truncate_cwd_keeps_only_leaf(): i64 {
    var p = "/home/user/Repos/very/deep/nested/project";   # 41 bytes
    var out = _truncate_cwd(p, strlen(p), 11);
    # budget = 8. Earliest '/' with suffix <= 8 is at index 33
    # ('/' before "project"). Result: "..." + "/project" = 11 bytes.
    _streq_or_dump(out, ".../project", "truncate(11) keeps just leaf");
    return 0;
}

fn test_truncate_cwd_pathologically_small(): i64 {
    var p = "/some/path";
    var out = _truncate_cwd(p, strlen(p), 3);
    _streq_or_dump(out, "...", "max_length=3 emits three dots");

    var out2 = _truncate_cwd(p, strlen(p), 1);
    _streq_or_dump(out2, ".", "max_length=1 emits one dot");
    return 0;
}

fn test_truncate_cwd_no_slash_fits_in_budget(): i64 {
    # A path with one early '/' and a long tail past budget — no
    # qualifying '/' exists, so we chop into the tail mid-component.
    var p = "/longComponentNameThatHasNoSlashes";   # 34 bytes
    var out = _truncate_cwd(p, strlen(p), 10);
    # budget = 7. Earliest '/' is at index 0; suffix len = 34 > 7.
    # No more '/'s. Fallback: "..." + last 7 bytes = ".." + "Slashes" → "...Slashes" (10).
    _streq_or_dump(out, "...Slashes", "fallback chops mid-component when no '/' fits");
    return 0;
}

fn test_truncate_cwd_via_render(): i64 {
    # Exercise the full cwd_render path with max_length set. Use a
    # bogus HOME so home-shorten is bypassed and we get the absolute
    # cwd, then truncate it. We don't assert the exact output (depends
    # on the runner's cwd length) — just that the returned cstring is
    # bounded by max_length.
    var out = cwd_render("/nonexistent/never/matches/this", 10);
    assert_neq(out, 0, "cwd_render(_, 10) returns non-null");
    var olen = strlen(out);
    var ok = 0;
    if (olen <= 10) { ok = 1; }
    assert(ok, "cwd_render with max_length=10 bounded under 10 bytes");
    return 0;
}

# ---- config loader ----

fn test_config_defaults(): i64 {
    var c = config_default();
    assert_neq(c, 0, "config_default() returns non-null");
    _streq_or_dump(cfg_separator(c), " ", "default separator == \" \"");
    _streq_or_dump(cfg_trailer(c), " $ ", "default trailer == \" $ \"");
    assert_eq(cfg_cwd_home_shorten(c), 1, "default cwd_home_shorten == 1");
    assert_eq(cfg_exit_hide_zero(c), 1, "default exit_hide_zero == 1");
    var segs = cfg_segments(c);
    assert_eq(vec_len(segs), 3, "default segments length == 3");
    _streq_or_dump(vec_get(segs, 0), "cwd",  "default segments[0] == \"cwd\"");
    _streq_or_dump(vec_get(segs, 1), "vcs",  "default segments[1] == \"vcs\" (M6: cache makes default-on)");
    _streq_or_dump(vec_get(segs, 2), "exit", "default segments[2] == \"exit\"");
    return 0;
}

fn test_config_load_missing_returns_defaults(): i64 {
    var c = config_load("/nonexistent/path/.commandress.cyml");
    assert_neq(c, 0, "config_load(missing) returns non-null");
    _streq_or_dump(cfg_separator(c), " ", "config_load(missing) separator == default");
    assert_eq(cfg_cwd_home_shorten(c), 1, "config_load(missing) cwd_home_shorten == default");
    return 0;
}

fn test_config_load_null_path_returns_defaults(): i64 {
    var c = config_load(0);
    assert_neq(c, 0, "config_load(0) returns non-null");
    _streq_or_dump(cfg_trailer(c), " $ ", "config_load(0) trailer == default");
    return 0;
}

# Write `content` to /tmp/cmdrs-test-<name>.cyml and return the path
# (heap-allocated). Tests use unique names so they can run in any order
# without interfering.
fn _write_test_config(name, content): i64 {
    var path = alloc(64);
    memcpy(path, "/tmp/cmdrs-test-", 16);
    var nlen = strlen(name);
    memcpy(path + 16, name, nlen);
    memcpy(path + 16 + nlen, ".cyml", 5);
    store8(path + 16 + nlen + 5, 0);
    var clen = strlen(content);
    file_write_all(path, content, clen);
    return path;
}

fn test_config_load_full_override(): i64 {
    var content = "[[prompt]]\nsegments = [\"exit\", \"cwd\"]\nseparator = \" | \"\ntrailer = \" > \"\n\n[[segments.cwd]]\nhome_shorten = false\n\n[[segments.exit]]\nhide_zero = false\n";
    var path = _write_test_config("full", content);
    var c = config_load(path);
    _streq_or_dump(cfg_separator(c), " | ", "override separator");
    _streq_or_dump(cfg_trailer(c), " > ", "override trailer");
    assert_eq(cfg_cwd_home_shorten(c), 0, "override cwd_home_shorten == 0");
    assert_eq(cfg_exit_hide_zero(c), 0, "override exit_hide_zero == 0");
    var segs = cfg_segments(c);
    assert_eq(vec_len(segs), 2, "override segments length == 2");
    _streq_or_dump(vec_get(segs, 0), "exit", "override segments[0] == \"exit\"");
    _streq_or_dump(vec_get(segs, 1), "cwd", "override segments[1] == \"cwd\"");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_partial_override(): i64 {
    # Only separator set — everything else must fall back to defaults.
    var content = "[[prompt]]\nseparator = \"::\"\n";
    var path = _write_test_config("partial", content);
    var c = config_load(path);
    _streq_or_dump(cfg_separator(c), "::", "partial override separator");
    _streq_or_dump(cfg_trailer(c), " $ ", "partial override trailer == default");
    assert_eq(cfg_cwd_home_shorten(c), 1, "partial override cwd_home_shorten == default");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_vcs_section(): i64 {
    var content = "[[segments.vcs]]\nshow_dirty = false\ndirty_marker = \"!\"\n";
    var path = _write_test_config("vcs", content);
    var c = config_load(path);
    assert_eq(cfg_vcs_show_dirty(c), 0, "vcs show_dirty override == 0");
    _streq_or_dump(cfg_vcs_dirty_marker(c), "!", "vcs dirty_marker override == \"!\"");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_default_vcs_fields(): i64 {
    var c = config_default();
    assert_eq(cfg_vcs_show_dirty(c), 1, "default vcs show_dirty == 1");
    _streq_or_dump(cfg_vcs_dirty_marker(c), "*", "default vcs dirty_marker == \"*\"");
    return 0;
}

# ---- config: default theme ----

fn test_config_default_theme_bakes_sgr(): i64 {
    var c = config_default();
    # Spot-check that every segment got an SGR string baked in. The
    # exact bytes are validated against the color module's known output
    # — anchored on cwd (cyan + bold) and exit (red + bold).
    _streq_or_dump(cfg_sgr_cwd(c),  "\x1b[1;36m", "default theme cwd == bold cyan");
    _streq_or_dump(cfg_sgr_exit(c), "\x1b[1;31m", "default theme exit == bold red");
    assert_neq(cfg_sgr_vcs(c),        0, "default theme vcs != 0");
    assert_neq(cfg_sgr_time(c),       0, "default theme time != 0");
    assert_neq(cfg_sgr_hostname(c),   0, "default theme hostname != 0");
    assert_neq(cfg_sgr_user(c),       0, "default theme user != 0");
    assert_neq(cfg_sgr_cyrius_env(c), 0, "default theme cyrius_env != 0");
    assert_neq(cfg_sgr_python_env(c), 0, "default theme python_env != 0");
    assert_neq(cfg_sgr_node_env(c),   0, "default theme node_env != 0");
    assert_neq(cfg_sgr_rustup_env(c), 0, "default theme rustup_env != 0");
    return 0;
}

# Partial-override safety: a [[segments.cwd]] block that only sets
# home_shorten (no color fields) must NOT clobber the default theme SGR.
fn test_config_load_color_partial_keeps_default(): i64 {
    var content = "[[segments.cwd]]\nhome_shorten = false\n";
    var path = _write_test_config("color-partial", content);
    var c = config_load(path);
    assert_eq(cfg_cwd_home_shorten(c), 0, "home_shorten override applied");
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[1;36m", "default cwd theme survives boolean-only override");
    syscall(SYS_UNLINK, path);
    return 0;
}

# Color override: touching any color field replaces the SGR entirely
# (full-override semantic — see schema comment in config.cyr).
fn test_config_load_color_fg_only_overrides(): i64 {
    var content = "[[segments.cwd]]\nfg = \"red\"\n";
    var path = _write_test_config("color-fg-only", content);
    var c = config_load(path);
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[31m", "fg=red overrides default cwd theme to plain red");
    syscall(SYS_UNLINK, path);
    return 0;
}

# Full reset: fg=default + style="" strips colors entirely.
fn test_config_load_color_reset_to_plain(): i64 {
    var content = "[[segments.cwd]]\nfg = \"default\"\nstyle = \"\"\n";
    var path = _write_test_config("color-reset", content);
    var c = config_load(path);
    assert_eq(cfg_sgr_cwd(c), 0, "fg=default + empty style clears cwd SGR");
    syscall(SYS_UNLINK, path);
    return 0;
}

# Color-only section (hostname has no other knobs in v0.6.0).
fn test_config_load_color_only_hostname(): i64 {
    var content = "[[segments.hostname]]\nfg = \"yellow\"\nstyle = \"underline\"\n";
    var path = _write_test_config("color-hostname", content);
    var c = config_load(path);
    _streq_or_dump(cfg_sgr_hostname(c), "\x1b[4;33m", "hostname fg+style override");
    syscall(SYS_UNLINK, path);
    return 0;
}

# Env-segment color override exercises the same _load_color_only_section
# code path as hostname/user, ensuring all four env segments are wired.
fn test_config_load_color_only_python_env(): i64 {
    var content = "[[segments.python_env]]\nfg = \"bright_blue\"\n";
    var path = _write_test_config("color-py", content);
    var c = config_load(path);
    _streq_or_dump(cfg_sgr_python_env(c), "\x1b[94m", "python_env fg override");
    syscall(SYS_UNLINK, path);
    return 0;
}

# ---- config: palette ----

fn test_config_load_palette_resolves_ref(): i64 {
    var content = "[[palette]]\nprimary = \"cyan\"\n\n[[segments.cwd]]\nfg = \"palette:primary\"\nstyle = \"bold\"\n";
    var path = _write_test_config("palette-ref", content);
    var c = config_load(path);
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[1;36m", "palette:primary → cyan resolves to bold cyan SGR");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_palette_multi_slot(): i64 {
    var content = "[[palette]]\nprimary = \"cyan\"\nerror   = \"red\"\n\n[[segments.cwd]]\nfg = \"palette:primary\"\n\n[[segments.exit]]\nfg = \"palette:error\"\nstyle = \"bold\"\n";
    var path = _write_test_config("palette-multi", content);
    var c = config_load(path);
    _streq_or_dump(cfg_sgr_cwd(c),  "\x1b[36m",   "palette:primary → cyan (cwd)");
    _streq_or_dump(cfg_sgr_exit(c), "\x1b[1;31m", "palette:error → red bold (exit)");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_palette_unknown_ref(): i64 {
    # Unknown palette name → resolves to 0 → SGR emits no fg code. With
    # no other styling, the segment ends up unstyled.
    var content = "[[palette]]\nprimary = \"cyan\"\n\n[[segments.cwd]]\nfg = \"palette:typo\"\n";
    var path = _write_test_config("palette-unknown", content);
    var c = config_load(path);
    assert_eq(cfg_sgr_cwd(c), 0, "unknown palette ref leaves segment unstyled");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_palette_mixed_with_raw(): i64 {
    # Mixing palette refs and raw colors in the same config works —
    # raw values pass through `_resolve_color_value` unchanged.
    var content = "[[palette]]\naccent = \"magenta\"\n\n[[segments.cwd]]\nfg = \"yellow\"\n\n[[segments.cyrius_env]]\nfg = \"palette:accent\"\n";
    var path = _write_test_config("palette-mixed", content);
    var c = config_load(path);
    _streq_or_dump(cfg_sgr_cwd(c),        "\x1b[33m", "raw \"yellow\" on cwd");
    _streq_or_dump(cfg_sgr_cyrius_env(c), "\x1b[35m", "palette:accent → magenta on cyrius_env");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_palette_absent_behaves_like_before(): i64 {
    # No [[palette]] section; raw color still works.
    var content = "[[segments.cwd]]\nfg = \"red\"\n";
    var path = _write_test_config("no-palette", content);
    var c = config_load(path);
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[31m", "absent palette doesn't break raw color");
    syscall(SYS_UNLINK, path);
    return 0;
}

# ---- config: right-prompt ----

fn test_config_default_right_segments_empty(): i64 {
    var c = config_default();
    var rsegs = cfg_right_segments(c);
    assert_neq(rsegs, 0, "default right_segments returns a vec (not null)");
    assert_eq(vec_len(rsegs), 0, "default right_segments is empty");
    return 0;
}

fn test_config_load_right_segments(): i64 {
    var content = "[[prompt]]\nright_segments = [\"time\", \"cyrius_env\"]\n";
    var path = _write_test_config("rprompt", content);
    var c = config_load(path);
    var rsegs = cfg_right_segments(c);
    assert_eq(vec_len(rsegs), 2, "right_segments parsed length == 2");
    _streq_or_dump(vec_get(rsegs, 0), "time",       "right_segments[0] == \"time\"");
    _streq_or_dump(vec_get(rsegs, 1), "cyrius_env", "right_segments[1] == \"cyrius_env\"");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_right_segments_empty_array(): i64 {
    # Explicit empty array — user opting out of right-prompt. Should
    # overwrite default (which is already empty, but the parse path
    # still needs to accept the empty case).
    var content = "[[prompt]]\nright_segments = []\n";
    var path = _write_test_config("rprompt-empty", content);
    var c = config_load(path);
    assert_eq(vec_len(cfg_right_segments(c)), 0, "right_segments = [] stays empty");
    syscall(SYS_UNLINK, path);
    return 0;
}

# ---- config: powerline ----

fn test_config_default_separator_style_plain(): i64 {
    var c = config_default();
    assert_eq(cfg_separator_style(c), 0, "default separator_style == 0 (plain)");
    _streq_or_dump(cfg_separator_glyph(c),       "", "default separator_glyph == \"\"");
    _streq_or_dump(cfg_right_separator_glyph(c), "", "default right_separator_glyph == \"\"");
    return 0;
}

fn test_config_default_bg_slots_unset(): i64 {
    # Default theme is fg-only; raw bg slots are all 0 so powerline mode
    # without per-segment bg overrides produces no transitions.
    var c = config_default();
    assert_eq(cfg_bg_cwd(c),        0, "default bg_cwd == 0");
    assert_eq(cfg_bg_exit(c),       0, "default bg_exit == 0");
    assert_eq(cfg_bg_vcs(c),        0, "default bg_vcs == 0");
    assert_eq(cfg_bg_cyrius_env(c), 0, "default bg_cyrius_env == 0");
    return 0;
}

fn test_config_load_powerline_enable(): i64 {
    var content = "[[prompt]]\nseparator_style = \"powerline\"\nseparator_glyph = \">\"\nright_separator_glyph = \"<\"\n";
    var path = _write_test_config("powerline-on", content);
    var c = config_load(path);
    assert_eq(cfg_separator_style(c), 1, "separator_style = \"powerline\" → 1");
    _streq_or_dump(cfg_separator_glyph(c),       ">", "separator_glyph parsed");
    _streq_or_dump(cfg_right_separator_glyph(c), "<", "right_separator_glyph parsed");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_powerline_plain_explicit(): i64 {
    # Anything other than "powerline" → 0. Verifies the int mapping
    # doesn't accidentally treat unknown values as powerline.
    var content = "[[prompt]]\nseparator_style = \"plain\"\n";
    var path = _write_test_config("powerline-plain", content);
    var c = config_load(path);
    assert_eq(cfg_separator_style(c), 0, "separator_style = \"plain\" → 0");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_bg_stored_raw(): i64 {
    # Raw bg is stashed for use by the powerline render path. Verify
    # the parser fills the slot (and doesn't try to bake it into SGR
    # only).
    var content = "[[segments.cwd]]\nfg = \"white\"\nbg = \"blue\"\n";
    var path = _write_test_config("bg-raw", content);
    var c = config_load(path);
    _streq_or_dump(cfg_bg_cwd(c), "blue", "bg=blue stored raw for powerline transitions");
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[37;44m", "fg+bg also baked into SGR");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_bg_via_palette(): i64 {
    # bg can reference the palette too.
    var content = "[[palette]]\nbase = \"green\"\n\n[[segments.cwd]]\nbg = \"palette:base\"\n";
    var path = _write_test_config("bg-palette", content);
    var c = config_load(path);
    _streq_or_dump(cfg_bg_cwd(c), "green", "bg resolves through palette");
    syscall(SYS_UNLINK, path);
    return 0;
}

# ---- vcs parser ----
# We don't fork `sit` in tests — vcs_parse_render is the pure-fn target.
# Fabricated `sit status` outputs cover the four cases: clean, dirty
# (staged), dirty (unstaged), and parse failure (wrong prefix).

fn test_vcs_parse_clean(): i64 {
    var s = "On branch main\n\nnothing to commit, working tree clean\n";
    var out = vcs_parse_render(s, strlen(s), "*");
    _streq_or_dump(out, "main", "vcs clean tree → \"main\"");
    return 0;
}

fn test_vcs_parse_dirty_staged(): i64 {
    var s = "On branch feature-x\n\nStaged for commit:\n  new file:  foo.txt\n";
    var out = vcs_parse_render(s, strlen(s), "*");
    _streq_or_dump(out, "feature-x*", "vcs staged → \"feature-x*\"");
    return 0;
}

fn test_vcs_parse_dirty_unstaged(): i64 {
    var s = "On branch trunk\n\nUnstaged changes:\n  modified:  bar.txt\n";
    var out = vcs_parse_render(s, strlen(s), "*");
    _streq_or_dump(out, "trunk*", "vcs unstaged → \"trunk*\"");
    return 0;
}

fn test_vcs_parse_custom_marker(): i64 {
    var s = "On branch main\n\nUnstaged changes:\n  modified:  bar.txt\n";
    var out = vcs_parse_render(s, strlen(s), "!");
    _streq_or_dump(out, "main!", "vcs custom marker → \"main!\"");
    return 0;
}

fn test_vcs_parse_no_marker_when_disabled(): i64 {
    var s = "On branch main\n\nUnstaged changes:\n  modified:  bar.txt\n";
    var out = vcs_parse_render(s, strlen(s), 0);
    _streq_or_dump(out, "main", "vcs disabled marker (0) → \"main\"");
    return 0;
}

fn test_vcs_parse_wrong_prefix_returns_empty(): i64 {
    var s = "sit: not a sit repository\n";
    var out = vcs_parse_render(s, strlen(s), "*");
    assert_eq(out, 0, "vcs wrong-prefix → 0 (empty segment)");
    return 0;
}

fn test_vcs_parse_short_buffer_returns_empty(): i64 {
    var s = "On";  # shorter than the prefix
    var out = vcs_parse_render(s, strlen(s), "*");
    assert_eq(out, 0, "vcs short-buffer → 0");
    return 0;
}

# ---- time segment ----

fn test_time_format_hh_mm(): i64 {
    # epoch 3725 = 01:02:05 on 1970-01-01.
    var out = time_format(3725, "%H:%M");
    _streq_or_dump(out, "01:02", "time_format(3725, %H:%M) == \"01:02\"");
    return 0;
}

fn test_time_format_hh_mm_ss(): i64 {
    var out = time_format(3725, "%H:%M:%S");
    _streq_or_dump(out, "01:02:05", "time_format(3725, %H:%M:%S) == \"01:02:05\"");
    return 0;
}

fn test_time_format_date(): i64 {
    # epoch 0 = 1970-01-01 00:00:00 UTC.
    var out = time_format(0, "%Y-%m-%d");
    _streq_or_dump(out, "1970-01-01", "time_format(0, %Y-%m-%d) == \"1970-01-01\"");
    return 0;
}

fn test_time_format_two_digit_year(): i64 {
    # epoch 1767225600 = 2026-01-01 00:00:00 UTC.
    var out = time_format(1767225600, "%y");
    _streq_or_dump(out, "26", "time_format(2026-..., %y) == \"26\"");
    return 0;
}

fn test_time_format_literal_percent(): i64 {
    var out = time_format(0, "%%");
    _streq_or_dump(out, "%", "time_format(_, %%) == \"%\"");
    return 0;
}

fn test_time_format_unknown_spec(): i64 {
    # Unsupported specs pass through verbatim.
    var out = time_format(0, "%Q");
    _streq_or_dump(out, "%Q", "time_format(_, %Q) passes through");
    return 0;
}

fn test_time_format_mixed_literals(): i64 {
    var out = time_format(3725, "at %H:%M");
    _streq_or_dump(out, "at 01:02", "time_format mixes literals + specs");
    return 0;
}

fn test_time_format_null_returns_empty(): i64 {
    var out = time_format(3725, 0);
    assert_eq(out, 0, "time_format(_, 0) → 0");
    return 0;
}

fn test_time_format_empty_returns_empty(): i64 {
    var out = time_format(3725, "");
    assert_eq(out, 0, "time_format(_, \"\") → 0");
    return 0;
}

# ---- hostname segment ----

fn test_hostname_renders_nonnull(): i64 {
    var out = hostname_render();
    assert_neq(out, 0, "hostname_render() returns non-null on Linux");
    if (out != 0) {
        var len = strlen(out);
        var nonzero_len = 0;
        if (len > 0) { nonzero_len = 1; }
        assert(nonzero_len, "hostname_render() returns nonempty cstring");
    }
    return 0;
}

fn test_hostname_matches_uname_nodename(): i64 {
    var uts[390];
    var r = syscall(SYS_UNAME, &uts);
    if (r != 0) {
        assert(1, "hostname_matches_uname_nodename skipped (uname failed)");
        return 0;
    }
    var nodename = &uts + 65;
    var out = hostname_render();
    _streq_or_dump(out, nodename, "hostname_render() == uname.nodename");
    return 0;
}

# ---- user segment ----

fn test_user_renders_nonnull(): i64 {
    var out = user_render();
    # On any Linux dev/test host either /etc/passwd or $USER will
    # resolve. Skipped only on the (theoretical) box where both are
    # missing — there's no useful render in that case.
    var skip = 0;
    if (out == 0) {
        if (getenv("USER") == 0) {
            skip = 1;
            assert(1, "user_renders_nonnull skipped (no /etc/passwd, no $USER)");
        }
    }
    if (skip == 0) {
        assert_neq(out, 0, "user_render() returns non-null when uid resolvable or $USER set");
        if (out != 0) {
            var len = strlen(out);
            var nonzero_len = 0;
            if (len > 0) { nonzero_len = 1; }
            assert(nonzero_len, "user_render() returns nonempty cstring");
        }
    }
    return 0;
}

# ---- shellout watchdog ----
# Each test skips cleanly when the host binary isn't present, so the
# suite stays green on stripped containers / non-coreutils systems.

# ---- cyrius_env ----

# `cyrius_env_parse_version` is a pure parser. Drive it with fabricated
# `cyrius --version` outputs to verify shape handling without forking
# a real cyrius process (same pattern as test_vcs_parse_*).
fn test_cyrius_env_parse_basic(): i64 {
    var input = "cyrius 5.11.63\nmanifest-pin: 5.11.63\n";
    var out = cyrius_env_parse_version(input, strlen(input));
    assert_neq(out, 0, "cyrius_env_parse_version basic returns non-null");
    _streq_or_dump(out, "5.11.63", "parse \"cyrius 5.11.63\\n...\" → \"5.11.63\"");
    return 0;
}

fn test_cyrius_env_parse_no_trailing_newline(): i64 {
    var input = "cyrius 0.5.0";
    var out = cyrius_env_parse_version(input, strlen(input));
    assert_neq(out, 0, "parse without trailing newline returns non-null");
    _streq_or_dump(out, "0.5.0", "parse \"cyrius 0.5.0\" → \"0.5.0\"");
    return 0;
}

fn test_cyrius_env_parse_wrong_prefix(): i64 {
    var input = "rustc 1.75.0\n";
    var out = cyrius_env_parse_version(input, strlen(input));
    assert_eq(out, 0, "parse non-cyrius output returns 0");
    return 0;
}

fn test_cyrius_env_parse_empty_version(): i64 {
    var input = "cyrius \n";
    var out = cyrius_env_parse_version(input, strlen(input));
    assert_eq(out, 0, "parse \"cyrius \\n\" (empty version) returns 0");
    return 0;
}

# `cyrius_env_find_root` walks upward looking for cyrius.cyml. Drive it
# with a temp tree under /tmp so the test is hermetic.
fn test_cyrius_env_find_root_hit(): i64 {
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_dir/sub");
    syscall(SYS_UNLINK, "/tmp/cmdrs_env_tst_dir/cyrius.cyml");
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_dir");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_env_tst_dir", 0x1FF), 0, "mkdir tmp project root");
    var fd = file_open("/tmp/cmdrs_env_tst_dir/cyrius.cyml", O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(fd >= 0, "open tmp cyrius.cyml for write");
    file_close(fd);

    var root = cyrius_env_find_root("/tmp/cmdrs_env_tst_dir");
    assert_neq(root, 0, "find_root from project root returns non-null");
    _streq_or_dump(root, "/tmp/cmdrs_env_tst_dir", "find_root(project root) == itself");

    # Subdir walk-up.
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_env_tst_dir/sub", 0x1FF), 0, "mkdir subdir");
    var root2 = cyrius_env_find_root("/tmp/cmdrs_env_tst_dir/sub");
    assert_neq(root2, 0, "find_root from subdir returns non-null");
    _streq_or_dump(root2, "/tmp/cmdrs_env_tst_dir", "find_root(subdir) walks up to project root");

    # Trailing slash on input shouldn't matter.
    var root3 = cyrius_env_find_root("/tmp/cmdrs_env_tst_dir/sub/");
    _streq_or_dump(root3, "/tmp/cmdrs_env_tst_dir", "find_root tolerates trailing slash");

    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_dir/sub");
    syscall(SYS_UNLINK, "/tmp/cmdrs_env_tst_dir/cyrius.cyml");
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_dir");
    return 0;
}

fn test_cyrius_env_find_root_miss(): i64 {
    # /tmp is unlikely to contain a cyrius.cyml. Skip if it somehow does
    # so the suite stays green on dev-host weirdness.
    if (syscall(SYS_ACCESS, "/tmp/cyrius.cyml", 0) == 0) {
        assert(1, "find_root_miss skipped (/tmp/cyrius.cyml exists)");
        return 0;
    }
    var root = cyrius_env_find_root("/tmp");
    assert_eq(root, 0, "find_root(/tmp) returns 0 (no cyrius.cyml on the walk)");
    return 0;
}

# `cyrius_env_read_version` reads + trims <root>/VERSION.
fn test_cyrius_env_read_version_trims(): i64 {
    syscall(SYS_UNLINK, "/tmp/cmdrs_env_tst_v/VERSION");
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_v");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_env_tst_v", 0x1FF), 0, "mkdir tmp root");
    var fd = file_open("/tmp/cmdrs_env_tst_v/VERSION", O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(fd >= 0, "open tmp VERSION for write");
    var contents = "  0.5.0\n\n";
    file_write(fd, contents, strlen(contents));
    file_close(fd);

    var ver = cyrius_env_read_version("/tmp/cmdrs_env_tst_v");
    assert_neq(ver, 0, "read_version returns non-null");
    _streq_or_dump(ver, "0.5.0", "read_version trims surrounding whitespace");

    syscall(SYS_UNLINK, "/tmp/cmdrs_env_tst_v/VERSION");
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_v");
    return 0;
}

fn test_cyrius_env_read_version_missing(): i64 {
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_no_v");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_env_tst_no_v", 0x1FF), 0, "mkdir empty root");
    var ver = cyrius_env_read_version("/tmp/cmdrs_env_tst_no_v");
    assert_eq(ver, 0, "read_version on missing VERSION returns 0");
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_no_v");
    return 0;
}

fn test_cyrius_env_read_version_whitespace_only(): i64 {
    syscall(SYS_UNLINK, "/tmp/cmdrs_env_tst_ws/VERSION");
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_ws");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_env_tst_ws", 0x1FF), 0, "mkdir tmp root");
    var fd = file_open("/tmp/cmdrs_env_tst_ws/VERSION", O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(fd >= 0, "open VERSION for write");
    file_write(fd, "   \n\t\n", 6);
    file_close(fd);

    var ver = cyrius_env_read_version("/tmp/cmdrs_env_tst_ws");
    assert_eq(ver, 0, "read_version on whitespace-only file returns 0 (falls through to shellout)");

    syscall(SYS_UNLINK, "/tmp/cmdrs_env_tst_ws/VERSION");
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_ws");
    return 0;
}

# End-to-end: the test process runs from the commandress project root,
# which has both cyrius.cyml and VERSION — the segment must paint.
