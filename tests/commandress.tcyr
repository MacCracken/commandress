include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/cyml.cyr"
include "lib/toml.cyr"
include "lib/tagged.cyr"
include "lib/chrono.cyr"
include "lib/pwd.cyr"
include "lib/process.cyr"
include "lib/assert.cyr"
include "lib/args.cyr"
include "lib/cmdit.cyr"

include "src/pathlookup.cyr"
include "src/fslookup.cyr"
include "src/color.cyr"
include "src/cache.cyr"
include "src/cli.cyr"
include "src/context.cyr"
include "src/shellout.cyr"
include "src/segments/cwd.cyr"
