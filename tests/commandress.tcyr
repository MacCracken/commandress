    _streq_or_dump(vec_get(rsegs, 1), "cyrius_env", "right_segments[1] == \"cyrius_env\"");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_right_segments_empty_array(): i64 {
    # Explicit empty array — user opting out of right-prompt. Should
