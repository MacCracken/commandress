    var c = _load_capturing_stderr("pal-hex", "palette = \"day\"\n[[palettes.day]]\na = \"#8be9fd\"\nb = \"244\"\n[[segments.cwd]]\nfg = \"palette:a\"\nbg = \"palette:b\"\n");
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[38;2;139;233;253;48;5;244m", "hex and 256 work in a selected palette");
