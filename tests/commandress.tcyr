# TOML parks `ui.primary` in a sub-table, and palette names may hold dots (ADR 0007 § 2).
fn test_palette_dotted_slots_in_a_selected_palette(): i64 {
    var c = _load_capturing_stderr("pal-dotted", "palette = \"day\"\n[[palettes.day]]\nui.primary = \"cyan\"\n[[segments.cwd]]\nfg = \"palette:ui.primary\"\n");
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[36m", "a dotted slot resolves");
    _streq_or_dump(_captured_err, "", "and warns about nothing");
