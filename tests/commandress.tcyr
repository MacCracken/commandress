fn test_config_array_comment_is_not_an_element(): i64 {
    var content = "[[prompt]]\nsegments = [\"cwd\", # not \"vcs\" ] here\n  \"exit\"]\ntrailer = \"> \"\n";
    var path = _write_test_config("arrcmt", content);
