# `cyrius_env_find_root` walks upward looking for cyrius.cyml. Drive it
# with a temp tree under /tmp so the test is hermetic.
fn test_cyrius_env_find_root_hit(): i64 {
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_dir/sub");
    syscall(SYS_UNLINK, "/tmp/cmdrs_env_tst_dir/cyrius.cyml");
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_dir");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_env_tst_dir", 0x1FF), 0, "mkdir tmp project root");
    var fd = file_open("/tmp/cmdrs_env_tst_dir/cyrius.cyml", O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(fd >= 0, "open tmp cyrius.cyml for write");
    file_close(fd);

    var root = cyrius_env_find_root("/tmp/cmdrs_env_tst_dir");
    assert_neq(root, 0, "find_root from project root returns non-null");
    _streq_or_dump(root, "/tmp/cmdrs_env_tst_dir", "find_root(project root) == itself");

    # Subdir walk-up.
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_env_tst_dir/sub", 0x1FF), 0, "mkdir subdir");
    var root2 = cyrius_env_find_root("/tmp/cmdrs_env_tst_dir/sub");
    assert_neq(root2, 0, "find_root from subdir returns non-null");
    _streq_or_dump(root2, "/tmp/cmdrs_env_tst_dir", "find_root(subdir) walks up to project root");

    # Trailing slash on input shouldn't matter.
    var root3 = cyrius_env_find_root("/tmp/cmdrs_env_tst_dir/sub/");
    _streq_or_dump(root3, "/tmp/cmdrs_env_tst_dir", "find_root tolerates trailing slash");

    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_dir/sub");
    syscall(SYS_UNLINK, "/tmp/cmdrs_env_tst_dir/cyrius.cyml");
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_dir");
    return 0;
}

fn test_cyrius_env_find_root_miss(): i64 {
    # /tmp is unlikely to contain a cyrius.cyml. Skip if it somehow does
    # so the suite stays green on dev-host weirdness.
    if (syscall(SYS_ACCESS, "/tmp/cyrius.cyml", 0) == 0) {
        assert(1, "find_root_miss skipped (/tmp/cyrius.cyml exists)");
        return 0;
    }
    var root = cyrius_env_find_root("/tmp");
    assert_eq(root, 0, "find_root(/tmp) returns 0 (no cyrius.cyml on the walk)");
    return 0;
}

# `cyrius_env_read_version` reads + trims <root>/VERSION.
fn test_cyrius_env_read_version_trims(): i64 {
    syscall(SYS_UNLINK, "/tmp/cmdrs_env_tst_v/VERSION");
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_v");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_env_tst_v", 0x1FF), 0, "mkdir tmp root");
    var fd = file_open("/tmp/cmdrs_env_tst_v/VERSION", O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(fd >= 0, "open tmp VERSION for write");
    var contents = "  0.5.0\n\n";
    file_write(fd, contents, strlen(contents));
    file_close(fd);

    var ver = cyrius_env_read_version("/tmp/cmdrs_env_tst_v");
    assert_neq(ver, 0, "read_version returns non-null");
    _streq_or_dump(ver, "0.5.0", "read_version trims surrounding whitespace");

    syscall(SYS_UNLINK, "/tmp/cmdrs_env_tst_v/VERSION");
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_v");
    return 0;
}

fn test_cyrius_env_read_version_missing(): i64 {
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_no_v");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_env_tst_no_v", 0x1FF), 0, "mkdir empty root");
    var ver = cyrius_env_read_version("/tmp/cmdrs_env_tst_no_v");
    assert_eq(ver, 0, "read_version on missing VERSION returns 0");
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_no_v");
    return 0;
}

fn test_cyrius_env_read_version_whitespace_only(): i64 {
    syscall(SYS_UNLINK, "/tmp/cmdrs_env_tst_ws/VERSION");
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_ws");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_env_tst_ws", 0x1FF), 0, "mkdir tmp root");
    var fd = file_open("/tmp/cmdrs_env_tst_ws/VERSION", O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(fd >= 0, "open VERSION for write");
    file_write(fd, "   \n\t\n", 6);
    file_close(fd);

    var ver = cyrius_env_read_version("/tmp/cmdrs_env_tst_ws");
    assert_eq(ver, 0, "read_version on whitespace-only file returns 0 (falls through to shellout)");

    syscall(SYS_UNLINK, "/tmp/cmdrs_env_tst_ws/VERSION");
    syscall(SYS_RMDIR, "/tmp/cmdrs_env_tst_ws");
    return 0;
}

