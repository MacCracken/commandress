# commandress test suite — M1 segments + config loader.
#
# Unit tests for the cwd + exit segments and the CYML config loader.
# Each segment is a pure fn of its inputs (per ADR 0002), so the
# harness fabricates inputs and inspects the returned cstring directly.
# Config-loader tests write a temp config file under /tmp, load it, and
# inspect the resulting Config struct.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/cyml.cyr"
include "lib/toml.cyr"
include "lib/tagged.cyr"
include "lib/process.cyr"
include "lib/assert.cyr"

include "src/segments/cwd.cyr"
include "src/segments/exit.cyr"
include "src/segments/vcs.cyr"
include "src/config.cyr"

fn _streq_or_dump(got, want, name): i64 {
    if (streq(got, want) == 1) {
        assert(1, name);
    } else {
        assert(0, name);
        syscall(1, 2, "    got:  ", 10);
        syscall(1, 2, got, strlen(got));
        syscall(1, 2, "\n    want: ", 11);
        syscall(1, 2, want, strlen(want));
        syscall(1, 2, "\n", 1);
    }
    return 0;
}

# ---- exit segment ----

fn test_exit_zero_empty(): i64 {
    var out = exit_render(0);
    assert_eq(out, 0, "exit(0) renders empty");
    return 0;
}

fn test_exit_nonzero_brackets(): i64 {
    var out = exit_render(42);
    assert_neq(out, 0, "exit(42) not empty");
    _streq_or_dump(out, "[42]", "exit(42) == \"[42]\"");
    return 0;
}

fn test_exit_negative(): i64 {
    var out = exit_render(0 - 1);
    assert_neq(out, 0, "exit(-1) not empty");
    _streq_or_dump(out, "[-1]", "exit(-1) == \"[-1]\"");
    return 0;
}

# ---- cwd segment ----

fn test_cwd_no_home(): i64 {
    var out = cwd_render(0);
    assert_neq(out, 0, "cwd_render(home=0) returns a path");
    assert_eq(load8(out), 47, "cwd_render(home=0) starts with '/'");
    return 0;
}

fn test_cwd_home_mismatch(): i64 {
    var out = cwd_render("/nonexistent/never/matches/this");
    assert_neq(out, 0, "cwd_render(bad-home) returns a path");
    assert_eq(load8(out), 47, "cwd_render(bad-home) keeps absolute path");
    return 0;
}

fn test_cwd_home_prefix_exact(): i64 {
    var buf[4096];
    var n = syscall(SYS_GETCWD, &buf, 4096);
    if (n <= 2) { assert(1, "cwd_home_prefix_exact skipped (cwd too short)"); return 0; }
    n = n - 1;
    var fake = alloc(n + 1);
    memcpy(fake, &buf, n);
    store8(fake + n, 0);
    var out = cwd_render(fake);
    _streq_or_dump(out, "~", "cwd_render(home==cwd) == \"~\"");
    return 0;
}

fn test_cwd_home_strict_prefix(): i64 {
    var buf[4096];
    var n = syscall(SYS_GETCWD, &buf, 4096);
    if (n <= 2) { assert(1, "cwd_home_strict_prefix skipped"); return 0; }
    n = n - 1;
    var sep = 0 - 1;
    var si = 0;
    while (si < n) {
        if (load8(&buf + si) == 47) { sep = si; }
        si = si + 1;
    }
    if (sep <= 0) { assert(1, "cwd_home_strict_prefix skipped (cwd is root)"); return 0; }
    var fake = alloc(sep + 1);
    memcpy(fake, &buf, sep);
    store8(fake + sep, 0);
    var out = cwd_render(fake);
    assert_neq(out, 0, "cwd_render(home==parent) not empty");
    assert_eq(load8(out), 126, "cwd_render(home==parent) starts '~'");
    assert_eq(load8(out + 1), 47, "cwd_render(home==parent) byte 1 == '/'");
    return 0;
}

# ---- config loader ----

fn test_config_defaults(): i64 {
    var c = config_default();
    assert_neq(c, 0, "config_default() returns non-null");
    _streq_or_dump(cfg_separator(c), " ", "default separator == \" \"");
    _streq_or_dump(cfg_trailer(c), " $ ", "default trailer == \" $ \"");
    assert_eq(cfg_cwd_home_shorten(c), 1, "default cwd_home_shorten == 1");
    assert_eq(cfg_exit_hide_zero(c), 1, "default exit_hide_zero == 1");
    var segs = cfg_segments(c);
    assert_eq(vec_len(segs), 2, "default segments length == 2");
    _streq_or_dump(vec_get(segs, 0), "cwd", "default segments[0] == \"cwd\"");
    _streq_or_dump(vec_get(segs, 1), "exit", "default segments[1] == \"exit\"");
    return 0;
}

fn test_config_load_missing_returns_defaults(): i64 {
    var c = config_load("/nonexistent/path/.commandress.cyml");
    assert_neq(c, 0, "config_load(missing) returns non-null");
    _streq_or_dump(cfg_separator(c), " ", "config_load(missing) separator == default");
    assert_eq(cfg_cwd_home_shorten(c), 1, "config_load(missing) cwd_home_shorten == default");
    return 0;
}

fn test_config_load_null_path_returns_defaults(): i64 {
    var c = config_load(0);
    assert_neq(c, 0, "config_load(0) returns non-null");
    _streq_or_dump(cfg_trailer(c), " $ ", "config_load(0) trailer == default");
    return 0;
}

# Write `content` to /tmp/cmdrs-test-<name>.cyml and return the path
# (heap-allocated). Tests use unique names so they can run in any order
# without interfering.
fn _write_test_config(name, content): i64 {
    var path = alloc(64);
    memcpy(path, "/tmp/cmdrs-test-", 16);
    var nlen = strlen(name);
    memcpy(path + 16, name, nlen);
    memcpy(path + 16 + nlen, ".cyml", 5);
    store8(path + 16 + nlen + 5, 0);
    var clen = strlen(content);
    file_write_all(path, content, clen);
    return path;
}

fn test_config_load_full_override(): i64 {
    var content = "[[prompt]]\nsegments = [\"exit\", \"cwd\"]\nseparator = \" | \"\ntrailer = \" > \"\n\n[[segments.cwd]]\nhome_shorten = false\n\n[[segments.exit]]\nhide_zero = false\n";
    var path = _write_test_config("full", content);
    var c = config_load(path);
    _streq_or_dump(cfg_separator(c), " | ", "override separator");
    _streq_or_dump(cfg_trailer(c), " > ", "override trailer");
    assert_eq(cfg_cwd_home_shorten(c), 0, "override cwd_home_shorten == 0");
    assert_eq(cfg_exit_hide_zero(c), 0, "override exit_hide_zero == 0");
    var segs = cfg_segments(c);
    assert_eq(vec_len(segs), 2, "override segments length == 2");
    _streq_or_dump(vec_get(segs, 0), "exit", "override segments[0] == \"exit\"");
    _streq_or_dump(vec_get(segs, 1), "cwd", "override segments[1] == \"cwd\"");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_partial_override(): i64 {
    # Only separator set — everything else must fall back to defaults.
    var content = "[[prompt]]\nseparator = \"::\"\n";
    var path = _write_test_config("partial", content);
    var c = config_load(path);
    _streq_or_dump(cfg_separator(c), "::", "partial override separator");
    _streq_or_dump(cfg_trailer(c), " $ ", "partial override trailer == default");
    assert_eq(cfg_cwd_home_shorten(c), 1, "partial override cwd_home_shorten == default");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_load_vcs_section(): i64 {
    var content = "[[segments.vcs]]\nshow_dirty = false\ndirty_marker = \"!\"\n";
    var path = _write_test_config("vcs", content);
    var c = config_load(path);
    assert_eq(cfg_vcs_show_dirty(c), 0, "vcs show_dirty override == 0");
    _streq_or_dump(cfg_vcs_dirty_marker(c), "!", "vcs dirty_marker override == \"!\"");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_default_vcs_fields(): i64 {
    var c = config_default();
    assert_eq(cfg_vcs_show_dirty(c), 1, "default vcs show_dirty == 1");
    _streq_or_dump(cfg_vcs_dirty_marker(c), "*", "default vcs dirty_marker == \"*\"");
    return 0;
}

# ---- vcs parser ----
# We don't fork `sit` in tests — vcs_parse_render is the pure-fn target.
# Fabricated `sit status` outputs cover the four cases: clean, dirty
# (staged), dirty (unstaged), and parse failure (wrong prefix).

fn test_vcs_parse_clean(): i64 {
    var s = "On branch main\n\nnothing to commit, working tree clean\n";
    var out = vcs_parse_render(s, strlen(s), "*");
    _streq_or_dump(out, "main", "vcs clean tree → \"main\"");
    return 0;
}

fn test_vcs_parse_dirty_staged(): i64 {
    var s = "On branch feature-x\n\nStaged for commit:\n  new file:  foo.txt\n";
    var out = vcs_parse_render(s, strlen(s), "*");
    _streq_or_dump(out, "feature-x*", "vcs staged → \"feature-x*\"");
    return 0;
}

fn test_vcs_parse_dirty_unstaged(): i64 {
    var s = "On branch trunk\n\nUnstaged changes:\n  modified:  bar.txt\n";
    var out = vcs_parse_render(s, strlen(s), "*");
    _streq_or_dump(out, "trunk*", "vcs unstaged → \"trunk*\"");
    return 0;
}

fn test_vcs_parse_custom_marker(): i64 {
    var s = "On branch main\n\nUnstaged changes:\n  modified:  bar.txt\n";
    var out = vcs_parse_render(s, strlen(s), "!");
    _streq_or_dump(out, "main!", "vcs custom marker → \"main!\"");
    return 0;
}

fn test_vcs_parse_no_marker_when_disabled(): i64 {
    var s = "On branch main\n\nUnstaged changes:\n  modified:  bar.txt\n";
    var out = vcs_parse_render(s, strlen(s), 0);
    _streq_or_dump(out, "main", "vcs disabled marker (0) → \"main\"");
    return 0;
}

fn test_vcs_parse_wrong_prefix_returns_empty(): i64 {
    var s = "sit: not a sit repository\n";
    var out = vcs_parse_render(s, strlen(s), "*");
    assert_eq(out, 0, "vcs wrong-prefix → 0 (empty segment)");
    return 0;
}

fn test_vcs_parse_short_buffer_returns_empty(): i64 {
    var s = "On";  # shorter than the prefix
    var out = vcs_parse_render(s, strlen(s), "*");
    assert_eq(out, 0, "vcs short-buffer → 0");
    return 0;
}

# ---- harness ----

fn main(): i64 {
    alloc_init();

    test_group("exit segment");
    test_exit_zero_empty();
    test_exit_nonzero_brackets();
    test_exit_negative();

    test_group("cwd segment");
    test_cwd_no_home();
    test_cwd_home_mismatch();
    test_cwd_home_prefix_exact();
    test_cwd_home_strict_prefix();

    test_group("config loader");
    test_config_defaults();
    test_config_default_vcs_fields();
    test_config_load_missing_returns_defaults();
    test_config_load_null_path_returns_defaults();
    test_config_load_full_override();
    test_config_load_partial_override();
    test_config_load_vcs_section();

    test_group("vcs parser");
    test_vcs_parse_clean();
    test_vcs_parse_dirty_staged();
    test_vcs_parse_dirty_unstaged();
    test_vcs_parse_custom_marker();
    test_vcs_parse_no_marker_when_disabled();
    test_vcs_parse_wrong_prefix_returns_empty();
    test_vcs_parse_short_buffer_returns_empty();

    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
