fn test_palette_single_bracket_table(): i64 {
    var c = _load_capturing_stderr("pal-single", "palette = \"day\"\n[palettes.day]\na = \"blue\"\n[segments.cwd]\nfg = \"palette:a\"\n");
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[34m", "both section spellings work here too");
