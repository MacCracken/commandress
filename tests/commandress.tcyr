}

fn test_palette_dotted_palette_name(): i64 {
    var c = _load_capturing_stderr("pal-dotname", "palette = \"day.warm\"\n[[palettes.day]]\na = \"red\"\n[[palettes.day.warm]]\na = \"yellow\"\n[[segments.cwd]]\nfg = \"palette:a\"\n");
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[33m", "a palette name can hold a dot");
