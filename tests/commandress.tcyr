}

# An empty table is a palette that changes nothing, not a missing one.
fn test_palette_empty_table_is_a_palette(): i64 {
    var c = _load_capturing_stderr("pal-emptyt", "palette = \"plain\"\n[[palette]]\na = \"red\"\n[[palettes.plain]]\n[[segments.cwd]]\nfg = \"palette:a\"\n");
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[31m", "the base still applies");
    _streq_or_dump(_captured_err, "", "an empty palette exists");
