fn test_config_basic_string_escapes(): i64 {
    var content = "[[prompt]]\ntrailer = \"\\\"hi\\\"\\t\"\nseparator = \"\\n\"\n[[segments.vcs]]\ndirty_marker = \"\\d\"\n";
    var path = _write_test_config("escapes", content);
