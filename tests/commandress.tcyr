}

# Helpers-against-temp-tree to verify the rust-toolchain marker walks
# + reads cleanly. Mirrors test_node_env_helpers_against_temp_tree.
fn test_rustup_env_helpers_against_temp_tree(): i64 {
    syscall(SYS_UNLINK, "/tmp/cmdrs_rustup_tst/rust-toolchain");
    syscall(SYS_RMDIR, "/tmp/cmdrs_rustup_tst/sub");
    syscall(SYS_RMDIR, "/tmp/cmdrs_rustup_tst");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_rustup_tst", 0x1FF), 0, "mkdir tmp root");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_rustup_tst/sub", 0x1FF), 0, "mkdir subdir");
    var fd = file_open("/tmp/cmdrs_rustup_tst/rust-toolchain", O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(fd >= 0, "open rust-toolchain for write");
    file_write(fd, "1.75.0\n", 7);
    file_close(fd);

    var root = find_ancestor_with("/tmp/cmdrs_rustup_tst/sub", "/rust-toolchain");
    assert_neq(root, 0, "find_ancestor_with(sub, /rust-toolchain) returns non-null");
    _streq_or_dump(root, "/tmp/cmdrs_rustup_tst", "walked up to root containing rust-toolchain");

    var ver = read_trimmed_file_at(root, "/rust-toolchain");
    _streq_or_dump(ver, "1.75.0", "rust-toolchain contents trimmed");

    # Channel-name style content (`stable`, `nightly`) should pass.
    fd = file_open("/tmp/cmdrs_rustup_tst/rust-toolchain", O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(fd >= 0, "reopen rust-toolchain for channel name");
    file_write(fd, "stable\n", 7);
    file_close(fd);
    var ch = read_trimmed_file_at(root, "/rust-toolchain");
    _streq_or_dump(ch, "stable", "rust-toolchain passes channel names verbatim");

    syscall(SYS_UNLINK, "/tmp/cmdrs_rustup_tst/rust-toolchain");
    syscall(SYS_RMDIR, "/tmp/cmdrs_rustup_tst/sub");
    syscall(SYS_RMDIR, "/tmp/cmdrs_rustup_tst");
    return 0;
}

# ---- color ----

fn test_color_fg_standard_eight(): i64 {
    assert_eq(color_to_sgr_fg("black"),   30, "fg(black) == 30");
    assert_eq(color_to_sgr_fg("red"),     31, "fg(red) == 31");
    assert_eq(color_to_sgr_fg("green"),   32, "fg(green) == 32");
    assert_eq(color_to_sgr_fg("yellow"),  33, "fg(yellow) == 33");
    assert_eq(color_to_sgr_fg("blue"),    34, "fg(blue) == 34");
    assert_eq(color_to_sgr_fg("magenta"), 35, "fg(magenta) == 35");
    assert_eq(color_to_sgr_fg("cyan"),    36, "fg(cyan) == 36");
    assert_eq(color_to_sgr_fg("white"),   37, "fg(white) == 37");
    return 0;
}

fn test_color_fg_bright_eight(): i64 {
    assert_eq(color_to_sgr_fg("bright_black"),   90, "fg(bright_black) == 90");
    assert_eq(color_to_sgr_fg("bright_red"),     91, "fg(bright_red) == 91");
    assert_eq(color_to_sgr_fg("bright_green"),   92, "fg(bright_green) == 92");
    assert_eq(color_to_sgr_fg("bright_yellow"),  93, "fg(bright_yellow) == 93");
    assert_eq(color_to_sgr_fg("bright_blue"),    94, "fg(bright_blue) == 94");
    assert_eq(color_to_sgr_fg("bright_magenta"), 95, "fg(bright_magenta) == 95");
    assert_eq(color_to_sgr_fg("bright_cyan"),    96, "fg(bright_cyan) == 96");
    assert_eq(color_to_sgr_fg("bright_white"),   97, "fg(bright_white) == 97");
    return 0;
}

fn test_color_fg_absent_or_default(): i64 {
    assert_eq(color_to_sgr_fg(0),         0, "fg(null) == 0 (no code)");
    assert_eq(color_to_sgr_fg(""),        0, "fg(\"\") == 0");
    assert_eq(color_to_sgr_fg("default"), 0, "fg(default) == 0");
    assert_eq(color_to_sgr_fg("xyzzy"),   0, "fg(unknown) == 0");
    return 0;
}

fn test_color_bg_is_fg_plus_ten(): i64 {
    assert_eq(color_to_sgr_bg("black"),         40, "bg(black) == 40");
    assert_eq(color_to_sgr_bg("red"),           41, "bg(red) == 41");
    assert_eq(color_to_sgr_bg("white"),         47, "bg(white) == 47");
    assert_eq(color_to_sgr_bg("bright_black"), 100, "bg(bright_black) == 100");
    assert_eq(color_to_sgr_bg("bright_white"), 107, "bg(bright_white) == 107");
    assert_eq(color_to_sgr_bg("default"),       0, "bg(default) == 0");
    assert_eq(color_to_sgr_bg(0),               0, "bg(null) == 0");
    return 0;
}

fn test_style_single_mod(): i64 {
    var codes[32];
    assert_eq(style_to_sgr_mods("bold",      &codes, 4), 1, "style(bold) writes 1 code");
    assert_eq(load64(&codes), 1, "  → code is 1");
    assert_eq(style_to_sgr_mods("italic",    &codes, 4), 1, "style(italic) writes 1 code");
    assert_eq(load64(&codes), 3, "  → code is 3");
    assert_eq(style_to_sgr_mods("underline", &codes, 4), 1, "style(underline) writes 1 code");
    assert_eq(load64(&codes), 4, "  → code is 4");
    assert_eq(style_to_sgr_mods("reverse",   &codes, 4), 1, "style(reverse) writes 1 code");
    assert_eq(load64(&codes), 7, "  → code is 7");
    return 0;
}

fn test_style_multi_mod_preserves_order(): i64 {
    var codes[32];
    assert_eq(style_to_sgr_mods("bold italic", &codes, 4), 2, "style(bold italic) writes 2 codes");
    assert_eq(load64(&codes),     1, "  first code is bold (1)");
    assert_eq(load64(&codes + 8), 3, "  second code is italic (3)");
    return 0;
}

fn test_style_unknown_words_skipped(): i64 {
    var codes[32];
    assert_eq(style_to_sgr_mods("bogus bold xyzzy", &codes, 4), 1, "unknown words skipped");
    assert_eq(load64(&codes), 1, "  only bold made it in");
    return 0;
}

fn test_style_absent_or_empty(): i64 {
    var codes[32];
    assert_eq(style_to_sgr_mods(0,    &codes, 4), 0, "style(null) == 0");
    assert_eq(style_to_sgr_mods("",   &codes, 4), 0, "style(\"\") == 0");
    assert_eq(style_to_sgr_mods("   ", &codes, 4), 0, "style(whitespace) == 0");
    return 0;
}

fn test_sgr_open_all_default_returns_zero(): i64 {
    assert_eq(sgr_open_for(0, 0, 0),                       0, "sgr_open(null,null,null) == 0");
    assert_eq(sgr_open_for("default", "default", ""),      0, "sgr_open(default,default,empty) == 0");
    assert_eq(sgr_open_for("xyzzy", "abcde", "bogus"),     0, "sgr_open(unknowns) == 0");
    return 0;
}

fn test_sgr_open_fg_only(): i64 {
    var out = sgr_open_for("red", 0, 0);
    assert_neq(out, 0, "sgr_open(red,_,_) returns non-null");
    _streq_or_dump(out, "\x1b[31m", "sgr_open(red) == \"\\x1b[31m\"");
    return 0;
}

fn test_sgr_open_bg_only(): i64 {
    var out = sgr_open_for(0, "blue", 0);
    _streq_or_dump(out, "\x1b[44m", "sgr_open(_,blue,_) == \"\\x1b[44m\"");
    return 0;
}

fn test_sgr_open_style_only(): i64 {
    var out = sgr_open_for(0, 0, "bold");
    _streq_or_dump(out, "\x1b[1m", "sgr_open(_,_,bold) == \"\\x1b[1m\"");
    return 0;
}

fn test_sgr_open_combined_order(): i64 {
    # Order: modifiers first, then fg, then bg (matches starship + most
    # terminal style guides).
    var out = sgr_open_for("cyan", "black", "bold");
    _streq_or_dump(out, "\x1b[1;36;40m", "sgr_open(cyan/black/bold) == \"\\x1b[1;36;40m\"");
    return 0;
}

fn test_sgr_open_three_digit_codes(): i64 {
    # bright_white bg is 107 — exercises the 3-digit emit branch.
    var out = sgr_open_for(0, "bright_white", 0);
    _streq_or_dump(out, "\x1b[107m", "sgr_open(_,bright_white,_) == \"\\x1b[107m\"");
    return 0;
}

fn test_sgr_open_multi_mod_plus_color(): i64 {
    var out = sgr_open_for("yellow", 0, "bold underline");
    _streq_or_dump(out, "\x1b[1;4;33m", "sgr_open(yellow,_,bold underline) == \"\\x1b[1;4;33m\"");
    return 0;
}

fn test_sgr_reset_constant(): i64 {
    _streq_or_dump(SGR_RESET, "\x1b[0m", "SGR_RESET == \"\\x1b[0m\"");
    return 0;
}

# ---- sanitize_segment_output (audit F-1) ----

fn test_sanitize_strips_esc_mid_string(): i64 {
    # The classic vcs-branch-name attack: `evil\x1b[2J` would clear
    # the user's terminal screen on every redraw without sanitization.
    var out = sanitize_segment_output("evil\x1b[2Jbad");
    _streq_or_dump(out, "evil[2Jbad", "ESC stripped, surrounding text preserved");
    return 0;
}

# Audit 2026-08-26, A-05. The filter used to pass every byte >= 0x80 on the
# reasoning that they are UTF-8 continuation bytes, not controls. True of the
# bytes, false of the codepoints: U+0080–U+009F is the C1 control set, and a
# UTF-8 terminal honouring C1 reads U+009B as CSI and U+009D as OSC — F-1's
# whole threat, smuggled past it two bytes at a time. Verified reaching stdout
# byte-for-byte before the fix.
fn test_sanitize_strips_utf8_c1_controls(): i64 {
    # \xc2\x9b = U+009B (CSI), \xc2\x9d = U+009D (OSC), \xc2\x9c = U+009C (ST).
    var out = sanitize_segment_output("v\xc2\x9b31mRED\xc2\x9d0;t\xc2\x9c");
    _streq_or_dump(out, "v31mRED0;t", "UTF-8-encoded C1 controls stripped");
    return 0;
}

# The other half of A-05: the fix must not eat legitimate text. 0xC2 followed
# by 0xA0..0xBF is ordinary Latin-1 punctuation, and 0xC3 sequences are not
# C1 at all.
fn test_sanitize_keeps_legitimate_utf8(): i64 {
    # caf\xc3\xa9 = "café"; \xc2\xa0 = NO-BREAK SPACE (U+00A0, just past C1).
    var out = sanitize_segment_output("caf\xc3\xa9\xc2\xa0ok");
    _streq_or_dump(out, "caf\xc3\xa9\xc2\xa0ok", "é and U+00A0 survive the C1 filter");
    return 0;
}

# Audit 2026-08-26, A-01. `read_regular_file` must refuse anything that is not
# a regular file — that is what stops a FIFO in a hostile project directory
# from parking the prompt in open(2) forever. A directory is the portable
# stand-in a test can create without mknod: open(2) on it succeeds, so only the
# fstat/S_IFREG gate rejects it. If this returns bytes, the gate is gone and
# the FIFO hang is back.
fn test_read_regular_file_rejects_non_regular(): i64 {
    var buf[64];
    var n = read_regular_file("/tmp", &buf, 64);
    var rejected = 0;
    if (n <= 0) { rejected = 1; }
    assert(rejected, "read_regular_file refuses a directory (S_IFREG gate live)");
    return 0;
}

fn test_sanitize_strips_all_c0_bytes(): i64 {
    # Every C0 control byte (0x00..0x1F) must be filtered.
    var input = "a\x01b\x02c\x07d\x0Ae\x0Df\x1bg\x1fh";
    var out = sanitize_segment_output(input);
    _streq_or_dump(out, "abcdefgh", "all C0 control bytes stripped");
    return 0;
}

fn test_sanitize_strips_del(): i64 {
    var out = sanitize_segment_output("hello\x7Fworld");
    _streq_or_dump(out, "helloworld", "DEL (0x7F) stripped");
    return 0;
}

fn test_sanitize_passes_through_utf8(): i64 {
    # UTF-8 continuation bytes (0x80–0xBF) must pass — they're part
    # of multi-byte sequences, not standalone control characters.
    # "café" = 63 61 66 c3 a9
    var out = sanitize_segment_output("caf\xc3\xa9");
    _streq_or_dump(out, "caf\xc3\xa9", "UTF-8 \"café\" passes through intact");
    return 0;
}

fn test_sanitize_empty_input(): i64 {
    var out = sanitize_segment_output("");
    assert_neq(out, 0, "sanitize(\"\") returns non-null pointer");
    assert_eq(strlen(out), 0, "sanitize(\"\") returns empty cstring");
    return 0;
}

fn test_sanitize_null_input(): i64 {
    assert_eq(sanitize_segment_output(0), 0, "sanitize(null) returns 0");
    return 0;
}

fn test_sanitize_all_controls_yields_empty(): i64 {
    # Pure-malice input: every byte is a control. Result is an empty
    # cstring — the F-1 render guard treats this as "skip the paint
    # entirely" so a downstream segment doesn't get a stray separator.
    var out = sanitize_segment_output("\x1b\x07\x0a\x0d\x00");
    # NB: \x00 means we can't use strlen on the ORIGINAL "input"
    # because the cstring terminates early; the helper sees the byte
    # via load8 + strlen on `s` (which already stops at the first
    # NUL anyway). So this test actually exercises the four bytes
    # before the NUL: ESC, BEL, LF, CR. All stripped.
    assert_neq(out, 0, "sanitize(all controls) returns non-null pointer");
    assert_eq(strlen(out), 0, "sanitize(all controls) returns empty cstring");
    return 0;
}

fn test_sanitize_no_change_for_clean_input(): i64 {
    var out = sanitize_segment_output("clean-branch-name-1.2.3");
    _streq_or_dump(out, "clean-branch-name-1.2.3", "clean input passes through");
    return 0;
}

# ---- cache ----

# Roundtrip: write a value, read it back within the TTL window.
fn test_cache_roundtrip(): i64 {
    cache_init();
    cache_put("tst_rt", "/some/cwd", "hello", 5);
    var v = cache_get("tst_rt", "/some/cwd", 1);
    assert_neq(v, 0, "cache_get returns non-null after put");
    _streq_or_dump(v, "hello", "cache roundtrip preserves bytes");
    return 0;
}

# Distinct cwds → distinct cache files; one's writes don't leak.
fn test_cache_per_cwd_isolation(): i64 {
    cache_init();
    cache_put("tst_iso", "/cwd/a", "AAA", 3);
    cache_put("tst_iso", "/cwd/b", "BBB", 3);
    var va = cache_get("tst_iso", "/cwd/a", 1);
    var vb = cache_get("tst_iso", "/cwd/b", 1);
    _streq_or_dump(va, "AAA", "cwd a returns AAA");
    _streq_or_dump(vb, "BBB", "cwd b returns BBB");
    return 0;
}

# Empty value caching: the "no sit repo here" case stashes "" so
# subsequent redraws short-circuit the find_in_path + shellout.
fn test_cache_empty_value(): i64 {
    cache_init();
    cache_put("tst_empty", "/cwd/none", "", 0);
    var v = cache_get("tst_empty", "/cwd/none", 1);
    assert_neq(v, 0, "cached empty returns non-null pointer");
    assert_eq(strlen(v), 0, "cached empty content has length 0");
    return 0;
}

# Cache miss when no entry exists.
fn test_cache_miss_when_absent(): i64 {
    cache_init();
    var v = cache_get("tst_miss", "/cwd/never-written", 1);
    assert_eq(v, 0, "missing cache entry returns 0");
    return 0;
}

# F-5 audit: cache_put writes the file atomically via temp+rename
# with mode 0o600. After put, stat the file and check the mode bits.
fn test_cache_put_writes_mode_0600(): i64 {
    cache_init();
    cache_put("tst_mode", "/cwd/mode-check", "x", 1);

    # Rebuild the cache file path via the same helper render uses, then
    # stat it.
    var path = _cache_path("tst_mode", "/cwd/mode-check");
    var stbuf[144];
    assert_eq(sys_stat(path, &stbuf), 0, "stat the cache file");
    var mode = load32(&stbuf + 24);
    # 0x1ff masks the 9 permission bits; 0x180 = 0o600.
    assert_eq(mode & 0x1ff, 0x180, "cache file mode == 0o600 (audit F-5/F-11)");
    return 0;
}

# F-4 audit: O_NOFOLLOW on cache_get refuses to traverse a symlink.
# Pre-write a legitimate cache, replace it with a symlink to a file
# we definitely shouldn't read through the cache (/etc/passwd is
# world-readable so this isn't a real exfiltration — we just verify
# the read REFUSES, not that confidentiality holds against a tool
# we could otherwise just `cat` directly).
# ---- audit F-7: parse_last_exit ----

fn test_parse_last_exit_null(): i64 {
    assert_eq(parse_last_exit(0), 0, "parse_last_exit(null) == 0");
    return 0;
}

fn test_parse_last_exit_empty(): i64 {
    assert_eq(parse_last_exit(""), 0, "parse_last_exit(\"\") == 0");
    return 0;
}

fn test_parse_last_exit_normal(): i64 {
    assert_eq(parse_last_exit("0"), 0, "parse_last_exit(\"0\") == 0");
    assert_eq(parse_last_exit("1"), 1, "parse_last_exit(\"1\") == 1");
    assert_eq(parse_last_exit("42"), 42, "parse_last_exit(\"42\") == 42");
    assert_eq(parse_last_exit("255"), 255, "parse_last_exit(\"255\") == 255");
    return 0;
}

# > 10 digits → reject (returns 0, the segment-empty path).
fn test_parse_last_exit_clamps_overlong_input(): i64 {
    assert_eq(parse_last_exit("99999999999"), 0, "11-digit input returns 0");
    assert_eq(parse_last_exit("9999999999999999999999"), 0, "22-digit input returns 0");
    return 0;
}

# Within 10 digits but > 65535 → clamp to 65535.
fn test_parse_last_exit_clamps_overlarge_value(): i64 {
    assert_eq(parse_last_exit("65536"), 65535, "65536 clamps to 65535");
    assert_eq(parse_last_exit("999999"), 65535, "999999 clamps to 65535");
    return 0;
}

fn test_parse_last_exit_rejects_negative(): i64 {
    assert_eq(parse_last_exit("-1"),  0, "\"-1\" returns 0");
    assert_eq(parse_last_exit("-99"), 0, "\"-99\" returns 0");
    return 0;
}

# ---- audit F-8: find_in_path_with rejects relative entries ----

fn test_find_in_path_rejects_relative(): i64 {
    # PATH is just "bin" (relative). Walker must skip it.
    assert_eq(find_in_path_with("bin", "sh"), 0, "relative PATH entry skipped");
    return 0;
}

fn test_find_in_path_rejects_dot(): i64 {
    # `.` and `..` are the canonical attacker entries. Skip them.
    assert_eq(find_in_path_with(".",  "sh"), 0, "PATH=\".\" skipped");
    assert_eq(find_in_path_with("..", "sh"), 0, "PATH=\"..\" skipped");
    # Mix: PATH=":./bin" should skip both the empty and the relative.
    assert_eq(find_in_path_with(":./bin", "sh"), 0, "PATH=\":./bin\" skipped");
    return 0;
}

fn test_find_in_path_absolute_works(): i64 {
    # PATH with one valid absolute entry should still find `sh`.
    var hit = find_in_path_with("/bin", "sh");
    assert_neq(hit, 0, "absolute PATH entry resolves");
    if (hit != 0) {
        _streq_or_dump(hit, "/bin/sh", "PATH=\"/bin\" finds /bin/sh");
    }
    # Even with a leading relative entry, the absolute one downstream
    # wins: `bin:/bin` → skip `bin`, hit `/bin`.
    var hit2 = find_in_path_with("bin:/bin", "sh");
    _streq_or_dump(hit2, "/bin/sh", "relative entry skipped, absolute entry resolves");
    return 0;
}

fn test_cache_get_refuses_symlink(): i64 {
    cache_init();
    cache_put("tst_nofollow", "/cwd/nofollow", "legit", 5);
    var path = _cache_path("tst_nofollow", "/cwd/nofollow");

    # Replace the cache file with a symlink. unlink + symlink as a pair
    # is the canonical attacker move.
    assert_eq(syscall(SYS_UNLINK, path), 0, "unlink legitimate cache file");
    assert_eq(syscall(88, "/etc/passwd", path), 0, "create symlink to /etc/passwd");   # SYS_SYMLINK

    var v = cache_get("tst_nofollow", "/cwd/nofollow", 60);
    assert_eq(v, 0, "cache_get on a symlink refuses (O_NOFOLLOW → 0)");

    # Cleanup the symlink so the test is hermetic.
    syscall(SYS_UNLINK, path);
    return 0;
}

# ---- pathlookup ----

# Find `sh` on PATH — present on every conceivable POSIX host. Skip
# when PATH itself is unset (stripped-container case) so the suite
# stays green outside a normal shell environment.
fn test_pathlookup_finds_sh(): i64 {
    if (getenv("PATH") == 0) {
        assert(1, "pathlookup_finds_sh skipped (PATH unset)");
        return 0;
    }
    var hit = find_in_path("sh");
    assert_neq(hit, 0, "find_in_path(\"sh\") returns non-null");
    if (hit != 0) {
        var n = strlen(hit);
        var ok = 0;
        if (n >= 3) {
            if (load8(hit + n - 3) == 47) {                  # '/'
                if (load8(hit + n - 2) == 115) {             # 's'
                    if (load8(hit + n - 1) == 104) {         # 'h'
                        ok = 1;
                    }
                }
            }
        }
        assert(ok, "find_in_path(\"sh\") result ends in \"/sh\"");
        assert_eq(syscall(SYS_ACCESS, hit, 1), 0, "find_in_path(\"sh\") result passes access(X_OK)");
    }
    return 0;
}

# Garbage name that nobody would ship: returns 0, no crash.
fn test_pathlookup_misses_unknown(): i64 {
    if (getenv("PATH") == 0) {
        assert(1, "pathlookup_misses_unknown skipped (PATH unset)");
        return 0;
    }
    var hit = find_in_path("__cmdrs_does_not_exist_xyz__");
    assert_eq(hit, 0, "find_in_path(garbage) returns 0");
    return 0;
}

fn test_shellout_happy_path(): i64 {
    if (syscall(SYS_ACCESS, "/bin/echo", 1) != 0) {
        assert(1, "shellout_happy_path skipped (no /bin/echo)");
        return 0;
    }
    var argv = alloc(24);
    store64(argv, "/bin/echo");
    store64(argv + 8, "hello");
    store64(argv + 16, 0);
    var envp = alloc(8);
    store64(envp, 0);
    var buf[64];
    var n = shellout_capture("/bin/echo", argv, envp, 1000, &buf, 64);
    assert_eq(n, 6, "echo hello → 6 bytes (h e l l o \\n)");
    if (n == 6) {
        var ok = 1;
        if (load8(&buf) != 104)  { ok = 0; }  # h
        if (load8(&buf + 1) != 101) { ok = 0; } # e
        if (load8(&buf + 2) != 108) { ok = 0; } # l
        if (load8(&buf + 3) != 108) { ok = 0; } # l
        if (load8(&buf + 4) != 111) { ok = 0; } # o
        if (load8(&buf + 5) != 10)  { ok = 0; } # \n
        assert(ok, "echo hello → buf == \"hello\\n\"");
    }
    return 0;
}

fn test_shellout_timeout_kills_child(): i64 {
    if (syscall(SYS_ACCESS, "/bin/sleep", 1) != 0) {
        assert(1, "shellout_timeout_kills_child skipped (no /bin/sleep)");
        return 0;
    }
    var argv = alloc(24);
    store64(argv, "/bin/sleep");
    store64(argv + 8, "1");                 # 1 second
    store64(argv + 16, 0);
    var envp = alloc(8);
    store64(envp, 0);
    var buf[64];
    var start_ms = clock_now_ms();
    var n = shellout_capture("/bin/sleep", argv, envp, 10, &buf, 64);
    var elapsed_ms = clock_now_ms() - start_ms;
    assert_eq(n, 0 - 2, "sleep 1 with 10ms budget → -2 (timeout)");
    var fast_enough = 0;
    if (elapsed_ms < 200) { fast_enough = 1; }
    assert(fast_enough, "sleep 1 returned in well under 1s (child was killed, not waited out)");
    return 0;
}

# Regression guard for a load-bearing ORDERING in shellout_capture
# (audit 2026-08-26, P-05 — investigated as a suspected deadlock, confirmed
# SAFE, and pinned here so it stays that way).
#
# When a child writes MORE than the capture buffer holds, the read loop stops
# early with `timed_out == 0`, so the child is never SIGKILLed. The child is
# still writing, and once the 64 KB pipe buffer fills it blocks in write().
# If the parent then called waitpid() while still holding the read end open,
# both sides would block forever and the shell's prompt would hang — exactly
# what the watchdog exists to prevent.
#
# It does not hang, for one reason: `sys_close(rfd)` runs BEFORE
# `sys_waitpid` in src/shellout.cyr. Closing the last read end makes the
# blocked child's next write fail with EPIPE/SIGPIPE, so it dies and waitpid
# reaps it immediately. Swap those two lines and the prompt deadlocks.
#
# Verified live at audit time: a child flooding 200 KB through a 256-byte
# buffer returned in 5 ms. This test keeps that true.
fn test_shellout_oversized_child_does_not_hang(): i64 {
    if (syscall(SYS_ACCESS, "/bin/sh", 1) != 0) {
        assert(1, "shellout_oversized_child skipped (no /bin/sh)");
        return 0;
    }
    var argv = alloc(32);
    store64(argv, "/bin/sh");
    store64(argv + 8, "-c");
    # ~256 KB of output, far past both the capture buffer and the pipe.
    store64(argv + 16, "i=0; while [ $i -lt 4096 ]; do printf '%064d' $i; i=$((i+1)); done");
    store64(argv + 24, 0);
    var envp = alloc(8);
    store64(envp, 0);
    var buf[256];
    var start_ms = clock_now_ms();
    # Generous 2 s budget: we are NOT testing the timeout here. If the
    # buffer-full path deadlocked, the budget would not save us either —
    # the parent blocks in waitpid, which no deadline covers.
    var n = shellout_capture("/bin/sh", argv, envp, 2000, &buf, 256);
    var elapsed_ms = clock_now_ms() - start_ms;
    var bounded = 0;
    if (n <= 256) { bounded = 1; }
    assert(bounded, "oversized child output is capped at the buffer size");
    var no_hang = 0;
    if (elapsed_ms < 1500) { no_hang = 1; }
    assert(no_hang, "buffer-full path returns promptly (close(rfd) precedes waitpid)");
    return 0;
}

# The hang the buffer-full test does NOT cover (audit 2026-08-26, A-02 HIGH).
#
# A child that closes or redirects its stdout and then keeps running makes the
# read loop exit on EOF (`n <= 0`) with `timed_out == 0`. Before A-02 the child
# was only killed when the deadline fired, so this path went straight to
# waitpid on a live child — and the EPIPE trick that rescues the buffer-full
# case does nothing here, because the child is not writing and never notices
# the closed pipe. Nothing covers a parent parked in waitpid: the budget is
# enforced by epoll_wait, which we have already left.
#
# Measured before the fix with a fake `cyrius` doing `exec 1>&-; sleep 30`:
# the prompt blocked for the full 30 s against a 5 ms budget. Fixed by killing
# the child unconditionally before the wait.
fn test_shellout_eof_with_live_child_does_not_hang(): i64 {
    if (syscall(SYS_ACCESS, "/bin/sh", 1) != 0) {
        assert(1, "shellout_eof_with_live_child skipped (no /bin/sh)");
        return 0;
    }
    var argv = alloc(32);
    store64(argv, "/bin/sh");
    store64(argv + 8, "-c");
    # Close stdout, then outlive the budget by a wide margin.
    store64(argv + 16, "exec 1>&-; sleep 5");
    store64(argv + 24, 0);
    var envp = alloc(8);
    store64(envp, 0);
    var buf[256];
    var start_ms = clock_now_ms();
    var n = shellout_capture("/bin/sh", argv, envp, 20, &buf, 256);
    var elapsed_ms = clock_now_ms() - start_ms;
    # The child produced nothing before closing stdout.
    var empty = 0;
    if (n <= 0) { empty = 1; }
    assert(empty, "child that closes stdout yields no captured bytes");
    # The point of the test: we must not have waited out the child's 5 s.
    var no_hang = 0;
    if (elapsed_ms < 1000) { no_hang = 1; }
    assert(no_hang, "EOF-with-live-child returns promptly (child killed before waitpid)");
    return 0;
}

# ---- cli (cmdit adoption, 1.1.5) ----
#
# These drive cmdit's PURE core, `cmdit_parse_argv`, over a synthetic argv:
# no /proc read, no environment, no process spawn. That is the whole reason
# `src/cli.cyr` exists as a module — the hand-rolled `_parse_side` it replaced
# read the real process argv from inside `src/main.cyr` (a file no test can
# include, since it ends in a bare `_agnos_entry();`), so it had zero coverage.

fn _mk_argv(a0, a1, a2): i64 {
    var n = 1;
    if (a1 != 0) { n = 2; }
    if (a2 != 0) { n = 3; }
    var v = alloc(n * 8);
    store64(v, a0);
    if (a1 != 0) { store64(v + 8, a1); }
    if (a2 != 0) { store64(v + 16, a2); }
    return v;
}

fn _argc_of(a1, a2): i64 {
    if (a2 != 0) { return 3; }
    if (a1 != 0) { return 2; }
    return 1;
}

# Full pipeline under test: register the table, parse synthetic argv, map the
# result to a side through the degrade policy.
fn _side_of(a1, a2): i64 {
    var cli = cmdit_new("cmdrs");
    var f = cli_register(cli);
    var pr = cmdit_parse_argv(cli, _argc_of(a1, a2), _mk_argv("cmdrs", a1, a2));
    return cli_side_for(cli, f, pr);
}

# The raw cmdit result, for the cases where the RESULT is the assertion.
fn _parse_result_of(a1, a2): i64 {
    var cli = cmdit_new("cmdrs");
    cli_register(cli);
    return cmdit_parse_argv(cli, _argc_of(a1, a2), _mk_argv("cmdrs", a1, a2));
}

# The guard that makes the compiled-in version literal trustworthy: if someone
# bumps VERSION and forgets src/cli.cyr, `cmdrs --version` would confidently
# print the old number. Fail the suite instead.
fn test_cli_version_matches_version_file(): i64 {
    var from_file = read_trimmed_file_at(".", "/VERSION");
    assert_nonnull(from_file, "VERSION file readable from repo root");
    assert_streq(cmdrs_version(), from_file,
                 "cmdrs_version() matches the VERSION file (bump both)");
    return 0;
}

fn test_cli_default_is_left(): i64 {
    assert_eq(_side_of(0, 0), 0, "no flags → left (side 0)");
    return 0;
}

fn test_cli_side_right(): i64 {
    assert_eq(_side_of("--side=right", 0), 1, "--side=right → right (side 1)");
    return 0;
}

fn test_cli_side_left_explicit(): i64 {
    assert_eq(_side_of("--side=left", 0), 0, "--side=left → left (side 0)");
    return 0;
}

# getopt-long space form. The hand-rolled walk only ever matched the single
# attached string `--side=right`, so this shape is new in 1.1.5 — additive,
# and free with the parser.
fn test_cli_side_space_form(): i64 {
    assert_eq(_side_of("--side", "right"), 1, "--side right (space form) → right");
    return 0;
}

# The degrade policy. Both of these rendered the left prompt in 1.1.4 by
# falling through; they still do, but now via an explicit parse error that
# cmdit_print_error names on stderr.
fn test_cli_bad_enum_degrades_to_left(): i64 {
    assert_eq(_parse_result_of("--side=bogus", 0), CMDIT_RESULT_ERR,
              "--side=bogus → parse error (choice set validated)");
    assert_eq(_side_of("--side=bogus", 0), 0, "--side=bogus still renders left, not empty");
    return 0;
}

fn test_cli_unknown_flag_degrades_to_left(): i64 {
    assert_eq(_parse_result_of("--nope", 0), CMDIT_RESULT_ERR, "--nope → parse error");
    assert_eq(_side_of("--nope", 0), 0, "unknown flag still renders left, not empty");
    return 0;
}

# Audit 2026-08-26, A-07 — the case the 1.1.5 CLI tests missed. They checked
# that a bad flag ALONE renders the left prompt, which is just the default, and
# so passed for the wrong reason. The real question is what happens when a VALID
# `--side=right` is combined with a bad flag: the old code discarded the parsed
# side and rendered the LEFT prompt, which the zsh adapter would paste into
# RPROMPT.
fn test_cli_side_survives_an_unrelated_parse_error(): i64 {
    assert_eq(_parse_result_of("--side=right", "--nope"), CMDIT_RESULT_ERR,
              "--side=right --nope is still a parse error");
    assert_eq(_side_of("--side=right", "--nope"), 1,
              "a successfully parsed --side=right survives an unrelated bad flag");
    return 0;
}

fn test_cli_help_short_circuits(): i64 {
    assert_eq(_parse_result_of("--help", 0), CMDIT_HELP, "--help → CMDIT_HELP");
    assert_eq(_parse_result_of("-h", 0), CMDIT_HELP, "-h → CMDIT_HELP");
    return 0;
}

fn test_cli_version_short_circuits(): i64 {
    assert_eq(_parse_result_of("--version", 0), CMDIT_VERSION, "--version → CMDIT_VERSION");
    assert_eq(_parse_result_of("-V", 0), CMDIT_VERSION, "-V → CMDIT_VERSION");
    return 0;
}

# A bare positional is not an error and must not disturb the side. agnoshi's
# adapter contract passes no positionals, but a user experimenting at the shell
# should still get their prompt.
fn test_cli_positional_ignored(): i64 {
    assert_eq(_parse_result_of("somearg", 0), CMDIT_OK, "positional parses clean");
    assert_eq(_side_of("somearg", 0), 0, "positional → left, no error");
    return 0;
}

