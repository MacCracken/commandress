# End-to-end smoke. The test process runs from the commandress tree
# (no .python-version on any ancestor) and we can't setenv from within
# cyrius. So we can only verify that when VIRTUAL_ENV happens to be
# set in the parent shell, the segment paints something; when it's
# unset and no .python-version is in the ancestry, the segment is
# empty. Both branches are accepted — the assertion just guards
# against crashes / unexpected non-empty output.
fn test_python_env_render_smoke(): i64 {
    var venv = getenv("VIRTUAL_ENV");
    var out = python_env_render(0);
    if (venv != 0) {
        if (strlen(venv) > 0) {
            assert_neq(out, 0, "render: VIRTUAL_ENV set → non-empty");
            return 0;
        }
    }
    # Without VIRTUAL_ENV, the segment may still paint if any ancestor
    # of the test cwd has a .python-version. Don't assert — just call
    # to verify it doesn't crash.
    assert(1, "render: no-VIRTUAL_ENV path executed (no crash)");
    return 0;
}

# ---- version probes (ADR 0014) ----

# A stand-in tool: logs each run with its cwd, the arguments, the exact environment it was
# exec'd with and what its stdin is, then prints `line`.
fn _probe_tool(path, line): i64 {
    var head = "#!/bin/sh\npwd >> /tmp/cmdrs_probe_tst/log\n/usr/bin/cat /proc/$$/environ > /tmp/cmdrs_probe_tst/rawenv\n/usr/bin/readlink /proc/$$/fd/0 > /tmp/cmdrs_probe_tst/stdin\necho $* >> /tmp/cmdrs_probe_tst/args\necho '";
    var tail = "'\n";
    var buf = alloc(1024);
    var n = strlen(head);
    memcpy(buf, head, n);
    memcpy(buf + n, line, strlen(line));
    n = n + strlen(line);
    memcpy(buf + n, tail, strlen(tail));
    n = n + strlen(tail);
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0x1C0);
    assert(fd >= 0, "open the stand-in tool");
    file_write(fd, buf, n);
    file_close(fd);
    return 0;
}

fn _probe_tree_clean(): i64 {
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_tst/log");
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_tst/rawenv");
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_tst/stdin");
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_tst/args");
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_tst/tool");
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_tst/tool2");
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_tst/pyproject.toml");
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_tst/requirements.txt");
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_tst/Cargo.toml");
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_tst/package.json");
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_tst/.nvmrc");
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_tst/rust-toolchain");
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_tst/rust-toolchain.toml");
    syscall(SYS_RMDIR, "/tmp/cmdrs_probe_tst");
    syscall(SYS_UNLINK, _cache_path("tst_probe", "/tmp/cmdrs_probe_tst/tool"));
    syscall(SYS_UNLINK, _cache_path("tst_probe", "/tmp/cmdrs_probe_tst/tool2"));
    syscall(SYS_UNLINK, _cache_path("python_env", "/tmp/cmdrs_probe_tst/tool"));
    syscall(SYS_UNLINK, _cache_path("node_env", "/tmp/cmdrs_probe_tst/tool"));
    syscall(SYS_UNLINK, _cache_path("rustup_env", "/tmp/cmdrs_probe_tst/tool"));
    return 0;
}

# A stand-in tool with this exact script.
fn _probe_tool_body(path, body): i64 {
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0x1C0);
    assert(fd >= 0, "open the stand-in tool");
    file_write(fd, body, strlen(body));
    file_close(fd);
    return 0;
}

fn _probe_tree_new(): i64 {
    _probe_tree_clean();
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_probe_tst", 0x1FF), 0, "mkdir probe root");
    cache_init();
    return 0;
}

fn _probe_runs(): i64 {
    var buf = alloc(4096);
    var n = file_read_all("/tmp/cmdrs_probe_tst/log", buf, 4095);
    if (n <= 0) { return 0; }
    var runs = 0;
    var i = 0;
    while (i < n) {
        if (load8(buf + i) == 10) { runs = runs + 1; }
        i = i + 1;
    }
    return runs;
}

fn _probe_file(path): i64 {
    var buf = alloc(4096);
    var n = file_read_all(path, buf, 4095);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    return buf;
}

fn test_shellout_in_a_directory(): i64 {
    var envp = alloc(8);
    store64(envp, 0);
    var buf[64];
    var n = shellout_capture_in("/", "/bin/sh", _sh_argv("pwd"), envp, 2000, &buf, 63);
    assert_eq(n, 2, "the child reports one short line");
    assert_eq(load8(&buf), 47, "and runs in /");
    return 0;
}

# Failing to leave the repo must mean not running, never running where we stand.
fn test_shellout_in_refuses_a_bad_directory(): i64 {
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_ran");
    var envp = alloc(8);
    store64(envp, 0);
    var buf[64];
    var n = shellout_capture_in("/nonexistent/x", "/bin/sh", _sh_argv("touch /tmp/cmdrs_probe_ran; echo ran"), envp, 2000, &buf, 63);
    assert(n <= 0, "no output");
    assert_neq(syscall(SYS_ACCESS, "/tmp/cmdrs_probe_ran", 0), 0, "the command never ran");
    return 0;
}

fn test_probe_parsers(): i64 {
    _streq_or_dump(probe_parse_python("Python 3.14.9\n", 14), "3.14.9", "python");
    _streq_or_dump(probe_parse_python("Python 3.13.0rc2\n", 17), "3.13.0rc2", "a python pre-release");
    assert_eq(probe_parse_python("python 3.1\n", 11), 0, "the wrong prefix");
    assert_eq(probe_parse_python("Python \n", 8), 0, "no version");
    _streq_or_dump(probe_parse_node("v26.13.0\n", 9), "26.13.0", "node");
    assert_eq(probe_parse_node("26.13.0\n", 8), 0, "node prints a v");
    _streq_or_dump(probe_parse_rustup("stable-x86_64-unknown-linux-gnu (default)\n", 42), "stable", "a channel, without the host triple");
    _streq_or_dump(probe_parse_rustup("nightly-2026-01-01-x86_64-unknown-linux-gnu (default)\n", 54), "nightly-2026-01-01", "a dated channel");
    _streq_or_dump(probe_parse_rustup("1.89-x86_64-unknown-linux-gnu (default)\n", 40), "1.89", "a numbered channel");
    _streq_or_dump(probe_parse_rustup("mytoolchain (default)\n", 22), "mytoolchain", "a linked toolchain has no triple");
    assert_eq(probe_parse_rustup("error: no default\n", 18), 0, "an error is not a version");
    return 0;
}

# A tool can print anything. Only something shaped like a version gets through.
fn test_probe_output_must_look_like_a_version(): i64 {
    assert_eq(probe_parse_python("Python 3.1;rm\n", 14), 0, "a semicolon");
    assert_eq(probe_parse_python("Python $(id)\n", 13), 0, "a substitution");
    assert_eq(probe_parse_node("v1\x1b[31m\n", 9), 0, "an escape");
    var w = "Python not found\n";
    assert_eq(probe_parse_python(w, strlen(w)), 0, "words are made of version characters too");
    w = "version\n";
    assert_eq(probe_parse_node(w, strlen(w)), 0, "so is a word that starts with v");
    w = "y\ny\ny\n";
    assert_eq(probe_parse_rustup(w, strlen(w)), 0, "rustup always says why, so a bare word is not it");
    w = "stable-x86_64-unknown-linux-gnu\n";
    assert_eq(probe_parse_rustup(w, strlen(w)), 0, "a toolchain with no reason");
    w = "stable-x86_64-unknown-linux-gnu (overridden by '/x')\n";
    _streq_or_dump(probe_parse_rustup(w, strlen(w)), "stable", "any reason will do");
    w = "Python -1\n";
    assert_eq(probe_parse_python(w, strlen(w)), 0, "a version starts with a digit, not a sign");
    w = "v.5\n";
    assert_eq(probe_parse_node(w, strlen(w)), 0, "or a dot");
    w = "stable more\n";
    assert_eq(probe_parse_rustup(w, strlen(w)), 0, "the next word is not a reason");
    w = "stable\n(default)\n";
    assert_eq(probe_parse_rustup(w, strlen(w)), 0, "a reason is on the same line");
    assert_eq(probe_parse_rustup("stable (default)", 6), 0, "nothing past n is read");
    assert_eq(probe_parse_rustup("stable (default)", 7), 0, "nor the bracket after the space");
    var long = alloc(200);
    memcpy(long, "Python ", 7);
    memset(long + 7, 49, PROBE_VERSION_MAX);
    store8(long + 7 + PROBE_VERSION_MAX, 10);
    assert_neq(probe_parse_python(long, 8 + PROBE_VERSION_MAX), 0, "at the cap");
    memset(long + 7, 49, PROBE_VERSION_MAX + 1);
    store8(long + 8 + PROBE_VERSION_MAX, 10);
    assert_eq(probe_parse_python(long, 9 + PROBE_VERSION_MAX), 0, "past the cap");
    return 0;
}

fn test_probe_runs_from_root_with_a_fixed_environment(): i64 {
    _probe_tree_new();
    _probe_tool("/tmp/cmdrs_probe_tst/tool", "Python 3.12.1");
    var out = probe_run("tst_probe", "/tmp/cmdrs_probe_tst/tool", "--version", 0, 2000, &probe_parse_python);
    _streq_or_dump(out, "3.12.1", "the version comes back");
    _streq_or_dump(_probe_file("/tmp/cmdrs_probe_tst/log"), "/\n", "it ran in /, not in the repo");
    # The exact bytes execve was given, not what a shell chose to show.
    var raw = alloc(4096);
    var n = file_read_all("/tmp/cmdrs_probe_tst/rawenv", raw, 4095);
    var want = "RUSTUP_AUTO_INSTALL=0";
    var wlen = strlen(want) + 1;
    assert_eq(memeq(raw, want, wlen), 1, "a tool may not install anything");
    if (getenv("RUSTUP_HOME") == 0) { assert_eq(n, wlen, "and it gets nothing else: no HOME, no PATH"); }
    _streq_or_dump(_probe_file("/tmp/cmdrs_probe_tst/stdin"), "/dev/null\n", "it cannot read what the user is typing");
    _probe_tree_clean();
    return 0;
}

fn test_probe_commands(): i64 {
    _probe_tree_new();
    var cwd = "/tmp/cmdrs_probe_tst";
    file_write_all("/tmp/cmdrs_probe_tst/requirements.txt", "x\n", 2);
    file_write_all("/tmp/cmdrs_probe_tst/package.json", "{}", 2);
    file_write_all("/tmp/cmdrs_probe_tst/Cargo.toml", "x\n", 2);
    _probe_tool("/tmp/cmdrs_probe_tst/tool", "anything");
    python_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 2000);
    node_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 2000);
    rustup_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 2000);
    _streq_or_dump(_probe_file("/tmp/cmdrs_probe_tst/args"), "--version\n--version\nshow active-toolchain\n", "what each one asks");
    _probe_tree_clean();
    return 0;
}

# 60 seconds, not one: prompts arrive further apart than a second, so a 1 s cache would
# run `node` on nearly every redraw.
fn test_probe_cached_per_tool(): i64 {
    _probe_tree_new();
    _probe_tool("/tmp/cmdrs_probe_tst/tool", "Python 3.12.1");
    _probe_tool("/tmp/cmdrs_probe_tst/tool2", "Python 3.9.0");
    probe_run("tst_probe", "/tmp/cmdrs_probe_tst/tool", "--version", 0, 2000, &probe_parse_python);
    var again = probe_run("tst_probe", "/tmp/cmdrs_probe_tst/tool", "--version", 0, 2000, &probe_parse_python);
    _streq_or_dump(again, "3.12.1", "a repeat reads the cache");
    assert_eq(_probe_runs(), 1, "and does not run the tool");
    _streq_or_dump(probe_run("tst_probe", "/tmp/cmdrs_probe_tst/tool2", "--version", 0, 2000, &probe_parse_python), "3.9.0", "another binary is another entry");
    assert_eq(_probe_runs(), 2, "so it does run");
    _probe_tree_clean();
    return 0;
}

fn _age_entry(seg, tool, secs): i64 {
    var times[32];
    store64(&times, 0);
    store64(&times + 8, 0);
    store64(&times + 16, clock_epoch_secs() - secs);
    store64(&times + 24, 0);
    return syscall(SYS_UTIMENSAT, 0 - 100, _cache_path(seg, tool), &times, 0);
}

fn test_probe_runs_again_after_the_ttl(): i64 {
    _probe_tree_new();
    _probe_tool("/tmp/cmdrs_probe_tst/tool", "Python 3.12.1");
    probe_run("tst_probe", "/tmp/cmdrs_probe_tst/tool", "--version", 0, 2000, &probe_parse_python);
    assert_eq(_age_entry("tst_probe", "/tmp/cmdrs_probe_tst/tool", 45), 0, "age the entry");
    probe_run("tst_probe", "/tmp/cmdrs_probe_tst/tool", "--version", 0, 2000, &probe_parse_python);
    assert_eq(_probe_runs(), 1, "under a minute old is still an answer");
    assert_eq(_age_entry("tst_probe", "/tmp/cmdrs_probe_tst/tool", 65), 0, "age it past a minute");
    probe_run("tst_probe", "/tmp/cmdrs_probe_tst/tool", "--version", 0, 2000, &probe_parse_python);
    assert_eq(_probe_runs(), 2, "an old entry runs the tool again");
    _probe_tree_clean();
    return 0;
}

# A tool that fails or stalls must cost one budget a minute, not one per redraw.
fn test_probe_failure_is_cached(): i64 {
    _probe_tree_new();
    _probe_tool("/tmp/cmdrs_probe_tst/tool", "not a version");
    assert_eq(probe_run("tst_probe", "/tmp/cmdrs_probe_tst/tool", "--version", 0, 2000, &probe_parse_python), 0, "bad output renders nothing");
    assert_eq(probe_run("tst_probe", "/tmp/cmdrs_probe_tst/tool", "--version", 0, 2000, &probe_parse_python), 0, "and again");
    assert_eq(_probe_runs(), 1, "without running the tool again");
    _probe_tree_clean();
    return 0;
}

fn test_probe_silence_is_cached(): i64 {
    _probe_tree_new();
    _probe_tool_body("/tmp/cmdrs_probe_tst/tool", "#!/bin/sh\necho x >> /tmp/cmdrs_probe_tst/log\n");
    assert_eq(probe_run("tst_probe", "/tmp/cmdrs_probe_tst/tool", "--version", 0, 2000, &probe_parse_python), 0, "no output");
    assert_eq(probe_run("tst_probe", "/tmp/cmdrs_probe_tst/tool", "--version", 0, 2000, &probe_parse_python), 0, "still none");
    assert_eq(_probe_runs(), 1, "a silent tool runs once");
    _probe_tree_clean();
    return 0;
}

fn test_probe_stall_is_bounded_and_cached(): i64 {
    _probe_tree_new();
    _probe_tool_body("/tmp/cmdrs_probe_tst/tool", "#!/bin/sh\necho x >> /tmp/cmdrs_probe_tst/log\nexec /usr/bin/sleep 30\n");
    var t0 = clock_now_ms();
    assert_eq(probe_run("tst_probe", "/tmp/cmdrs_probe_tst/tool", "--version", 0, 200, &probe_parse_python), 0, "a stall");
    assert_eq(probe_run("tst_probe", "/tmp/cmdrs_probe_tst/tool", "--version", 0, 200, &probe_parse_python), 0, "from the cache");
    assert(clock_now_ms() - t0 < 2000, "budget_ms is what bounds it");
    assert_eq(_probe_runs(), 1, "a stalling tool runs once");
    _probe_tree_clean();
    return 0;
}

# A full /tmp reads as a miss every time, so a probe that only wrote afterwards would run
# the tool on every redraw and a stalling tool would stall every prompt. The entry is
# claimed before the tool runs, and a claim that fails stops the probe.
fn test_probe_needs_a_cache_it_can_write(): i64 {
    _probe_tree_new();
    _probe_tool("/tmp/cmdrs_probe_tst/tool", "Python 3.12.1");
    var was = _cache_dir;
    _cache_dir = "/nonexistent/cmdrs_probe";
    assert_eq(cache_put("tst_probe", "/x", "v", 1), 0, "cache_put says when it could not write");
    var out = probe_run("tst_probe", "/tmp/cmdrs_probe_tst/tool", "--version", 0, 2000, &probe_parse_python);
    _cache_dir = was;
    assert_eq(out, 0, "no answer");
    assert_eq(_probe_runs(), 0, "and the tool did not run");
    assert_eq(cache_put("tst_probe", "/tmp/cmdrs_probe_tst/tool", "v", 1), 1, "and when it could");
    _probe_tree_clean();
    return 0;
}

# With no cache every redraw would pay for the tool, so a probe does not run at all.
fn test_probe_needs_the_cache(): i64 {
    _probe_tree_new();
    _probe_tool("/tmp/cmdrs_probe_tst/tool", "Python 3.12.1");
    var was = _cache_disabled;
    _cache_disabled = 1;
    var out = probe_run("tst_probe", "/tmp/cmdrs_probe_tst/tool", "--version", 0, 2000, &probe_parse_python);
    _cache_disabled = was;
    assert_eq(out, 0, "no cache, no probe");
    assert_eq(_probe_runs(), 0, "the tool never ran");
    _probe_tree_clean();
    return 0;
}

fn test_config_probes_default_off(): i64 {
    var c = config_default();
    assert_eq(cfg_probe_ms_python(c), 0, "python off by default");
    assert_eq(cfg_probe_ms_node(c), 0, "node off by default");
    assert_eq(cfg_probe_ms_rustup(c), 0, "rustup off by default");
    return 0;
}

fn test_config_probe_flag_and_budget(): i64 {
    var c = _load_capturing_stderr("probe-on", "[[segments.python_env]]\nshellout = true\n[[segments.node_env]]\nshellout = true\nbudget_ms = 200\n[[segments.rustup_env]]\nshellout = false\nbudget_ms = 200\n");
    assert_eq(cfg_probe_ms_python(c), PROBE_BUDGET_DEFAULT_MS, "on, with the default budget");
    assert_eq(cfg_probe_ms_node(c), 200, "on, with a chosen budget");
    assert_eq(cfg_probe_ms_rustup(c), 0, "a budget alone does not turn it on");
    _streq_or_dump(_captured_err, "", "both are known fields");
    return 0;
}

fn test_config_probe_bad_budget_keeps_the_default(): i64 {
    var c = _load_capturing_stderr("probe-bad", "[[segments.node_env]]\nshellout = true\nbudget_ms = 5000\n");
    assert_eq(cfg_probe_ms_node(c), PROBE_BUDGET_DEFAULT_MS, "the default stands");
    _streq_or_dump(_captured_err, "warning: budget_ms in [[segments.node_env]] must be 1..1000 (using the default)\n", "and it says so");
    return 0;
}

# The flag belongs to the three segments that have a tool to ask.
fn test_config_probe_flag_is_not_everywhere(): i64 {
    _load_capturing_stderr("probe-where", "[[segments.hostname]]\nshellout = true\n");
    _streq_or_dump(_captured_err, "warning: unknown config field 'shellout' in [[segments.hostname]] (ignored)\n", "hostname has no tool");
    return 0;
}

# A file pin answers first. A probe only runs in a project, and only if it is on.
fn test_probe_gates(): i64 {
    _probe_tree_new();
    _probe_tool("/tmp/cmdrs_probe_tst/tool", "Python 3.12.1");
    var cwd = "/tmp/cmdrs_probe_tst";
    assert_eq(python_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 2000), 0, "on, but no project here");
    file_write_all("/tmp/cmdrs_probe_tst/requirements.txt", "x\n", 2);
    assert_eq(python_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 0), 0, "a project, but off");
    assert_eq(_probe_runs(), 0, "neither ran the tool");
    _streq_or_dump(python_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 2000), "3.12.1", "requirements.txt is a project");
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_tst/requirements.txt");
    syscall(SYS_UNLINK, _cache_path("python_env", "/tmp/cmdrs_probe_tst/tool"));
    file_write_all("/tmp/cmdrs_probe_tst/pyproject.toml", "x\n", 2);
    _streq_or_dump(python_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 2000), "3.12.1", "so is pyproject.toml");
    syscall(SYS_UNLINK, _cache_path("python_env", "/tmp/cmdrs_probe_tst/tool"));
    _probe_tree_clean();
    return 0;
}

fn test_probe_gate_node_and_rustup(): i64 {
    _probe_tree_new();
    var cwd = "/tmp/cmdrs_probe_tst";
    _probe_tool("/tmp/cmdrs_probe_tst/tool", "v26.1.0");
    assert_eq(node_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 2000), 0, "node: no project");
    file_write_all("/tmp/cmdrs_probe_tst/package.json", "{}", 2);
    assert_eq(node_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 0), 0, "node: a project, but off");
    assert_eq(_probe_runs(), 0, "node: neither ran the tool");
    _streq_or_dump(node_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 2000), "26.1.0", "node: package.json is a project");
    syscall(SYS_UNLINK, _cache_path("node_env", "/tmp/cmdrs_probe_tst/tool"));
    _probe_tool("/tmp/cmdrs_probe_tst/tool", "stable-x86_64-unknown-linux-gnu (default)");
    assert_eq(rustup_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 2000), 0, "rustup: no project");
    file_write_all("/tmp/cmdrs_probe_tst/Cargo.toml", "x\n", 2);
    var before = _probe_runs();
    assert_eq(rustup_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 0), 0, "rustup: a project, but off");
    assert_eq(_probe_runs(), before, "rustup: neither ran the tool");
    _streq_or_dump(rustup_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 2000), "stable", "rustup: Cargo.toml is a project");
    syscall(SYS_UNLINK, _cache_path("rustup_env", "/tmp/cmdrs_probe_tst/tool"));
    _probe_tree_clean();
    return 0;
}

# A project with a pin file has said what it uses, and the machine's default may be wrong:
# for a `path` toolchain it certainly is. Empty is better than wrong.
fn test_probe_stops_at_a_pin_file_that_names_nothing(): i64 {
    _probe_tree_new();
    var cwd = "/tmp/cmdrs_probe_tst";
    _probe_tool("/tmp/cmdrs_probe_tst/tool", "v26.1.0");
    file_write_all("/tmp/cmdrs_probe_tst/package.json", "{}", 2);
    file_write_all("/tmp/cmdrs_probe_tst/.nvmrc", "\n", 1);
    assert_eq(node_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 2000), 0, "an empty .nvmrc");
    _probe_tool("/tmp/cmdrs_probe_tst/tool", "stable-x86_64-unknown-linux-gnu (default)");
    file_write_all("/tmp/cmdrs_probe_tst/Cargo.toml", "x\n", 2);
    file_write_all("/tmp/cmdrs_probe_tst/rust-toolchain", "", 0);
    assert_eq(rustup_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 2000), 0, "an empty rust-toolchain");
    syscall(SYS_UNLINK, "/tmp/cmdrs_probe_tst/rust-toolchain");
    var toml = "[toolchain]\npath = \"/x\"\n";
    file_write_all("/tmp/cmdrs_probe_tst/rust-toolchain.toml", toml, strlen(toml));
    assert_eq(rustup_env_probe(cwd, "/tmp/cmdrs_probe_tst/tool", 2000), 0, "a path toolchain");
    assert_eq(_probe_runs(), 0, "none of them ran the tool");
    _probe_tree_clean();
    return 0;
}

# ---- node_env: package.json (ADR 0013) ----

fn _pkg(json): i64 { return node_env_parse_package(json, strlen(json)); }

fn test_node_env_package_reads_engines_node(): i64 {
    _streq_or_dump(_pkg("{\"name\":\"x\",\"engines\":{\"node\":\">=18\"}}"), ">=18", "the usual shape");
    _streq_or_dump(_pkg("{\"engines\":{\"npm\":\">=9\",\"node\":\"^20 || ^22\"},\"version\":\"1\"}"), "^20 || ^22", "beside other keys, and first");
    _streq_or_dump(_pkg("{\n  \"engines\" : {\n    \"node\" : \"20.x\"\n  }\n}\n"), "20.x", "pretty-printed");
    return 0;
}

# Everything here renders nothing, and none of it is an error.
fn test_node_env_package_misses(): i64 {
    assert_eq(_pkg("{\"name\":\"x\"}"), 0, "no engines");
    assert_eq(_pkg("{\"engines\":\"node\"}"), 0, "engines is a string");
    assert_eq(_pkg("{\"engines\":[\"node\"]}"), 0, "engines is an array");
    assert_eq(_pkg("{\"engines\":{\"npm\":\"9\"}}"), 0, "no node key");
    assert_eq(_pkg("{\"engines\":{\"node\":18}}"), 0, "a number is not a range");
    assert_eq(_pkg("{\"engines\":{\"node\":true}}"), 0, "nor a bool");
    assert_eq(_pkg("{\"engines\":{\"node\":null}}"), 0, "nor null");
    assert_eq(_pkg("{\"engines\":{\"node\":[\"18\"]}}"), 0, "nor an array");
    assert_eq(_pkg("{\"engines\":{\"node\":{\"a\":\"b\"}}}"), 0, "nor an object");
    assert_eq(_pkg("{\"engines\":{\"node\":\"\"}}"), 0, "nor empty");
    assert_eq(_pkg("{\"node\":\"18\"}"), 0, "node must be under engines");
    assert_eq(_pkg("{\"x\":{\"engines\":{\"node\":\"18\"}}}"), 0, "engines must be top-level");
    assert_eq(_pkg(""), 0, "an empty file");
    assert_eq(_pkg("not json"), 0, "not JSON");
    assert_eq(_pkg("[]"), 0, "not an object");
    return 0;
}

# Values and keys come back as written. A backslash means an escape nobody would write
# in a version range, and rendering it undecoded would show `\\u001b` as text.
fn test_node_env_package_escapes_render_nothing(): i64 {
    assert_eq(_pkg("{\"engines\":{\"node\":\"a\\u001bb\"}}"), 0, "an escaped value");
    assert_eq(_pkg("{\"\\u0065ngines\":{\"node\":\"18\"}}"), 0, "an escaped key");
    return 0;
}

fn test_node_env_package_value_cap(): i64 {
    var body = alloc(600);
    var head = "{\"engines\":{\"node\":\"";
    var hl = strlen(head);
    memcpy(body, head, hl);
    memset(body + hl, 97, NODE_RANGE_MAX);
    memcpy(body + hl + NODE_RANGE_MAX, "\"}}", 4);
    var out = _pkg(body);
    assert_neq(out, 0, "a value at the cap renders");
    assert_eq(sanitized_len(out), NODE_RANGE_MAX, "whole");
    memset(body + hl, 97, NODE_RANGE_MAX + 1);
    memcpy(body + hl + NODE_RANGE_MAX + 1, "\"}}", 4);
    assert_eq(_pkg(body), 0, "past the cap renders nothing");
    return 0;
}

# bayan refuses a document with a repeated key, so nothing has to pick a winner.
fn test_node_env_package_duplicate_key(): i64 {
    assert_eq(_pkg("{\"engines\":{\"node\":\"a\"},\"engines\":{\"node\":\"b\"}}"), 0, "at the top");
    assert_eq(_pkg("{\"engines\":{\"node\":\"a\",\"node\":\"b\"}}"), 0, "under engines");
    return 0;
}

# The read cap can cut a file anywhere. What came before the cut still counts.
fn test_node_env_package_cut_document(): i64 {
    _streq_or_dump(_pkg("{\"engines\":{\"node\":\">=18\"},\"a\":\"unterminated"), ">=18", "a cut after the key");
    assert_eq(_pkg("{\"a\":\"unterminated"), 0, "a cut before it");
    assert_eq(_pkg("{\"engines\":{\"node\":\">=1"), 0, "a cut inside it");
    return 0;
}

# 300 brackets in a value. The depth cap must refuse it without recursing or crashing.
fn test_node_env_package_deep_nesting(): i64 {
    var d = 300;
    var head = "{\"a\":";
    var tail = ",\"engines\":{\"node\":\"18\"}}";
    var buf = alloc(strlen(head) + d * 2 + strlen(tail) + 1);
    var n = strlen(head);
    memcpy(buf, head, n);
    memset(buf + n, 91, d);
    memset(buf + n + d, 93, d);
    memcpy(buf + n + d * 2, tail, strlen(tail) + 1);
    assert_eq(_pkg(buf), 0, "a value past the depth cap ends the parse");
    return 0;
}

fn test_node_env_package_tolerates_a_bom(): i64 {
    _streq_or_dump(_pkg("\xef\xbb\xbf{\"engines\":{\"node\":\">=18\"}}"), ">=18", "a BOM is skipped");
    return 0;
}

fn _node_tree_clean(): i64 {
    syscall(SYS_UNLINK, "/tmp/cmdrs_node_pkg/.nvmrc");
    syscall(SYS_UNLINK, "/tmp/cmdrs_node_pkg/package.json");
    syscall(SYS_RMDIR, "/tmp/cmdrs_node_pkg/package.json");
    syscall(SYS_UNLINK, "/tmp/cmdrs_node_pkg/sub/.nvmrc");
    syscall(SYS_RMDIR, "/tmp/cmdrs_node_pkg/sub/package.json");
    syscall(SYS_UNLINK, "/tmp/cmdrs_node_pkg/sub/package.json");
    syscall(SYS_RMDIR, "/tmp/cmdrs_node_pkg/sub");
    syscall(SYS_RMDIR, "/tmp/cmdrs_node_pkg");
    return 0;
}

fn _node_tree_new(): i64 {
    _node_tree_clean();
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_node_pkg", 0x1FF), 0, "mkdir root");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_node_pkg/sub", 0x1FF), 0, "mkdir sub");
    return 0;
}

fn _node_write(path, content): i64 {
    file_write_all(path, content, strlen(content));
    return 0;
}

fn test_node_env_package_found_by_the_walk(): i64 {
    _node_tree_new();
    _node_write("/tmp/cmdrs_node_pkg/package.json", "{\"engines\":{\"node\":\">=18\"}}");
    _streq_or_dump(node_env_for("/tmp/cmdrs_node_pkg"), ">=18", "in the cwd");
    _streq_or_dump(node_env_for("/tmp/cmdrs_node_pkg/sub"), ">=18", "above the cwd");
    _node_tree_clean();
    return 0;
}

# .nvmrc is the pin and package.json is a fallback, so .nvmrc wins from anywhere above.
fn test_node_env_nvmrc_beats_package_json(): i64 {
    _node_tree_new();
    _node_write("/tmp/cmdrs_node_pkg/.nvmrc", "20.11.1\n");
    _node_write("/tmp/cmdrs_node_pkg/sub/package.json", "{\"engines\":{\"node\":\">=18\"}}");
    _streq_or_dump(node_env_for("/tmp/cmdrs_node_pkg/sub"), "20.11.1", "a farther .nvmrc beats a nearer package.json");
    _node_tree_clean();
    return 0;
}

# Only the nearest package.json is read. Climbing past one would let a hostile tree of
# them cost a parse per level on every redraw.
fn test_node_env_only_the_nearest_package_json(): i64 {
    _node_tree_new();
    _node_write("/tmp/cmdrs_node_pkg/package.json", "{\"engines\":{\"node\":\">=18\"}}");
    _node_write("/tmp/cmdrs_node_pkg/sub/package.json", "{\"name\":\"workspace\"}");
    assert_eq(node_env_for("/tmp/cmdrs_node_pkg/sub"), 0, "a nearer package.json with no engines stops the search");
    _node_tree_clean();
    return 0;
}

# A FIFO must not hang the prompt (audit A-01). The test would stall here if it did.
fn test_node_env_package_hostile_file_types(): i64 {
    _node_tree_new();
    assert_eq(syscall(SYS_MKNODAT, 0 - 100, "/tmp/cmdrs_node_pkg/package.json", 0x1180, 0), 0, "mkfifo fixture");
    assert_eq(node_env_for("/tmp/cmdrs_node_pkg"), 0, "a FIFO renders nothing");
    syscall(SYS_UNLINK, "/tmp/cmdrs_node_pkg/package.json");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_node_pkg/package.json", 0x1FF), 0, "directory fixture");
    assert_eq(node_env_for("/tmp/cmdrs_node_pkg"), 0, "a directory renders nothing");
    _node_tree_clean();
    return 0;
}

# The read stops at the cap: a key before it renders, and a key after it is not seen.
fn test_node_env_package_read_cap(): i64 {
    _node_tree_new();
    var size = PKG_FILE_CAP + 200;
    var buf = alloc(size + 1);
    var early = "{\"engines\":{\"node\":\">=18\"},\"pad\":\"";
    memset(buf, 120, size);
    memcpy(buf, early, strlen(early));
    memcpy(buf + size - 2, "\"}", 2);
    file_write_all("/tmp/cmdrs_node_pkg/package.json", buf, size);
    _streq_or_dump(node_env_for("/tmp/cmdrs_node_pkg"), ">=18", "a key before the cap renders");

    var late = "\",\"engines\":{\"node\":\">=18\"}}";
    memset(buf, 120, size);
    memcpy(buf, "{\"pad\":\"", 8);
    memcpy(buf + PKG_FILE_CAP, late, strlen(late));
    file_write_all("/tmp/cmdrs_node_pkg/package.json", buf, PKG_FILE_CAP + strlen(late));
    assert_eq(node_env_for("/tmp/cmdrs_node_pkg"), 0, "a key past the cap is not seen");
    _node_tree_clean();
    return 0;
}

# ---- node_env ----

# Smoke test: the test process runs from this project's tree (no
# .nvmrc on any ancestor), so the segment must render empty. Asserting
# this catches regressions like a stale find_ancestor_with hit on a
# different marker.
fn test_node_env_render_empty_outside_project(): i64 {
    var out = node_env_render(0);
    assert_eq(out, 0, "node_env_render outside any .nvmrc tree → empty");
    return 0;
}

# `node_env_render` walks cwd upward, so we can't easily fake "we're
# inside a .nvmrc tree" from within a test process. Instead, exercise
# the helpers it composes (find_ancestor_with + read_trimmed_file_at)
# against a temp tree — that's the real coverage; node_env_render is
# just five lines of glue over them. This test mirrors the canonical
# "subdir walks up to root" pattern from cyrius_env_find_root_hit.
fn test_node_env_helpers_against_temp_tree(): i64 {
    syscall(SYS_UNLINK, "/tmp/cmdrs_node_tst/.nvmrc");
    syscall(SYS_RMDIR, "/tmp/cmdrs_node_tst/sub");
    syscall(SYS_RMDIR, "/tmp/cmdrs_node_tst");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_node_tst", 0x1FF), 0, "mkdir tmp root");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_node_tst/sub", 0x1FF), 0, "mkdir subdir");
    var fd = file_open("/tmp/cmdrs_node_tst/.nvmrc", O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(fd >= 0, "open .nvmrc for write");
    var contents = "20.11.1\n";
    file_write(fd, contents, strlen(contents));
    file_close(fd);

    var root = find_ancestor_with("/tmp/cmdrs_node_tst/sub", "/.nvmrc");
    assert_neq(root, 0, "find_ancestor_with(sub, /.nvmrc) returns non-null");
    _streq_or_dump(root, "/tmp/cmdrs_node_tst", "walked up to root containing .nvmrc");

    var ver = read_trimmed_file_at(root, "/.nvmrc");
    assert_neq(ver, 0, "read_trimmed_file_at(.nvmrc) returns non-null");
    _streq_or_dump(ver, "20.11.1", ".nvmrc contents trimmed");

    # LTS-style content should pass through untouched (slash isn't ws).
    fd = file_open("/tmp/cmdrs_node_tst/.nvmrc", O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(fd >= 0, "reopen .nvmrc for lts content");
    var lts = "lts/iron\n";
    file_write(fd, lts, strlen(lts));
    file_close(fd);
    var ver2 = read_trimmed_file_at(root, "/.nvmrc");
    _streq_or_dump(ver2, "lts/iron", ".nvmrc passes lts/iron verbatim");

    syscall(SYS_UNLINK, "/tmp/cmdrs_node_tst/.nvmrc");
    syscall(SYS_RMDIR, "/tmp/cmdrs_node_tst/sub");
    syscall(SYS_RMDIR, "/tmp/cmdrs_node_tst");
    return 0;
}

# ---- rust-toolchain.toml (1.2.2) ----
# Follows rustup: the nearest directory wins, and within one directory the
# extensionless file wins. Everything else is what a hostile repo can put there.

fn _rustup_tree_clean(): i64 {
    syscall(SYS_UNLINK, "/tmp/cmdrs_rt_tst/rust-toolchain");
    syscall(SYS_UNLINK, "/tmp/cmdrs_rt_tst/rust-toolchain.toml");
    syscall(SYS_UNLINK, "/tmp/cmdrs_rt_tst/sub/rust-toolchain");
    syscall(SYS_UNLINK, "/tmp/cmdrs_rt_tst/sub/rust-toolchain.toml");
    syscall(SYS_RMDIR, "/tmp/cmdrs_rt_tst/sub");
    syscall(SYS_RMDIR, "/tmp/cmdrs_rt_tst");
    return 0;
}

fn _rustup_write(path, content): i64 {
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(fd >= 0, "open toolchain fixture");
    file_write(fd, content, strlen(content));
    file_close(fd);
    return 0;
}

fn test_rustup_env_parse_toml(): i64 {
    var a = "[toolchain]\nchannel = \"1.75.0\"\ncomponents = [\"rustfmt\"]\n";
    _streq_or_dump(rustup_env_parse_toml(a, strlen(a)), "1.75.0", "channel from [toolchain]");
    var b = "[[toolchain]]\nchannel = 'nightly-2026-01-01' # pinned\n";
    _streq_or_dump(rustup_env_parse_toml(b, strlen(b)), "nightly-2026-01-01", "literal string with a comment");
    var c = "[toolchain]\r\nchannel = \"stable\"\r\n";
    _streq_or_dump(rustup_env_parse_toml(c, strlen(c)), "stable", "CRLF file");
    var d = "[toolchain]\npath = \"/opt/rust\"\n";
    assert_eq(rustup_env_parse_toml(d, strlen(d)), 0, "a path toolchain has no channel");
    var e = "[other]\nchannel = \"1.75.0\"\n";
    assert_eq(rustup_env_parse_toml(e, strlen(e)), 0, "channel outside [toolchain] is ignored");
    var f = "[toolchain]\nchannel = \"\"\n";
    assert_eq(rustup_env_parse_toml(f, strlen(f)), 0, "an empty channel renders empty");
    var g = "[[[[ not toml \" at all\n";
    assert_eq(rustup_env_parse_toml(g, strlen(g)), 0, "garbage is not a channel");
    assert_eq(rustup_env_parse_toml("", 0), 0, "an empty file is not a channel");

    # A hostile file must not get more into the prompt than the plain format allows.
    var long_toml = alloc(RUSTUP_FILE_CAP);
    var prefix = "[toolchain]\nchannel = \"";
    var plen = strlen(prefix);
    memcpy(long_toml, prefix, plen);
    memset(long_toml + plen, 65, RUSTUP_CHANNEL_MAX);
    store8(long_toml + plen + RUSTUP_CHANNEL_MAX, 34);
    assert_eq(strlen(rustup_env_parse_toml(long_toml, plen + RUSTUP_CHANNEL_MAX + 1)), RUSTUP_CHANNEL_MAX, "a channel at the cap is kept");
    memset(long_toml + plen, 65, RUSTUP_CHANNEL_MAX + 1);
    store8(long_toml + plen + RUSTUP_CHANNEL_MAX + 1, 34);
    assert_eq(rustup_env_parse_toml(long_toml, plen + RUSTUP_CHANNEL_MAX + 2), 0, "one byte past the cap renders empty");
    return 0;
}

fn test_rustup_env_precedence(): i64 {
    _rustup_tree_clean();
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_rt_tst", 0x1FF), 0, "mkdir root");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_rt_tst/sub", 0x1FF), 0, "mkdir sub");

    _rustup_write("/tmp/cmdrs_rt_tst/rust-toolchain.toml", "[toolchain]\nchannel = \"1.80.0\"\n");
    _streq_or_dump(rustup_env_for("/tmp/cmdrs_rt_tst/sub"), "1.80.0", "toml found from a subdirectory");

    _rustup_write("/tmp/cmdrs_rt_tst/rust-toolchain", "1.75.0\n");
    _streq_or_dump(rustup_env_for("/tmp/cmdrs_rt_tst"), "1.75.0", "same directory: rust-toolchain wins");

    _rustup_write("/tmp/cmdrs_rt_tst/sub/rust-toolchain.toml", "[toolchain]\nchannel = \"1.85.0\"\n");
    _streq_or_dump(rustup_env_for("/tmp/cmdrs_rt_tst/sub"), "1.85.0", "a nearer toml beats a farther plain file");

    syscall(SYS_UNLINK, "/tmp/cmdrs_rt_tst/sub/rust-toolchain.toml");
    _rustup_write("/tmp/cmdrs_rt_tst/sub/rust-toolchain", "[toolchain]\nchannel = \"beta\"\n");
    _streq_or_dump(rustup_env_for("/tmp/cmdrs_rt_tst/sub"), "beta", "TOML under the extensionless name");

    _rustup_tree_clean();
    return 0;
}

fn test_rustup_env_hostile_files(): i64 {
    _rustup_tree_clean();
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_rt_tst", 0x1FF), 0, "mkdir root");
    # A FIFO must not hang the prompt (audit A-01). The test would stall here if it did.
    assert_eq(syscall(SYS_MKNODAT, 0 - 100, "/tmp/cmdrs_rt_tst/rust-toolchain.toml", 0x1180, 0), 0, "mkfifo fixture");
    assert_eq(rustup_env_for("/tmp/cmdrs_rt_tst"), 0, "a FIFO renders empty");
    syscall(SYS_UNLINK, "/tmp/cmdrs_rt_tst/rust-toolchain.toml");

    # Past the cap the parse stops, so a channel beyond it is simply not seen.
    var fd = file_open("/tmp/cmdrs_rt_tst/rust-toolchain.toml", O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(fd >= 0, "open oversized fixture");
    var pad = alloc(RUSTUP_FILE_CAP);
    memset(pad, 35, RUSTUP_FILE_CAP);
    store8(pad + RUSTUP_FILE_CAP - 1, 10);
    file_write(fd, pad, RUSTUP_FILE_CAP);
    file_write(fd, "[toolchain]\nchannel = \"late\"\n", 29);
    file_close(fd);
    assert_eq(rustup_env_for("/tmp/cmdrs_rt_tst"), 0, "bytes past the read cap are not parsed");

    _rustup_tree_clean();
    return 0;
}

# The legacy format keeps its 256-byte read cap now that the file is read only once.
fn test_rustup_env_plain_cap(): i64 {
    _rustup_tree_clean();
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_rt_tst", 0x1FF), 0, "mkdir root");
    var long = alloc(PROBE_FILE_CAP + 200);
    memset(long, 97, PROBE_FILE_CAP + 200);
    file_write_all("/tmp/cmdrs_rt_tst/rust-toolchain", long, PROBE_FILE_CAP + 200);
    var out = rustup_env_for("/tmp/cmdrs_rt_tst");
    assert_neq(out, 0, "a long plain file renders");
    assert_eq(strlen(out), PROBE_FILE_CAP, "a plain file stops at the probe cap");
    _rustup_tree_clean();
    return 0;
}

# One walk finds whichever name is nearest, and the first name wins inside a directory.
fn test_find_ancestor_with_either(): i64 {
    _rustup_tree_clean();
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_rt_tst", 0x1FF), 0, "mkdir root");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_rt_tst/a", 0x1FF), 0, "mkdir a");
    var which[8];
    assert_eq(find_ancestor_with_either("/tmp/cmdrs_rt_tst/a", "/rust-toolchain", "/rust-toolchain.toml", &which), 0, "no marker, no root");
    assert_eq(load64(&which), 0, "which is 0 on a miss");

    file_write_all("/tmp/cmdrs_rt_tst/rust-toolchain.toml", "x", 1);
    var root = find_ancestor_with_either("/tmp/cmdrs_rt_tst/a", "/rust-toolchain", "/rust-toolchain.toml", &which);
    _streq_or_dump(root, "/tmp/cmdrs_rt_tst", "the second name is found on the walk up");
    assert_eq(load64(&which), 2, "which reports the second name");

    file_write_all("/tmp/cmdrs_rt_tst/rust-toolchain", "x", 1);
    find_ancestor_with_either("/tmp/cmdrs_rt_tst/a", "/rust-toolchain", "/rust-toolchain.toml", &which);
    assert_eq(load64(&which), 1, "in one directory the first name wins");

    assert_eq(find_ancestor_with_either("relative/path", "/rust-toolchain", 0, &which), 0, "a relative path ends the walk");
    syscall(SYS_RMDIR, "/tmp/cmdrs_rt_tst/a");
    _rustup_tree_clean();
    return 0;
}

# The cut must land on a '/': the walk tests the parent, and never a truncated name.
fn test_find_ancestor_walks_every_parent(): i64 {
    _rustup_tree_clean();
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_rt_tst", 0x1FF), 0, "mkdir root");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_rt_tst/aa", 0x1FF), 0, "mkdir aa");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_rt_tst/aa/bb", 0x1FF), 0, "mkdir bb");
    file_write_all("/tmp/cmdrs_rt_tst/aa/.nvmrc", "20", 2);
    _streq_or_dump(find_ancestor_with("/tmp/cmdrs_rt_tst/aa/bb///", "/.nvmrc"), "/tmp/cmdrs_rt_tst/aa", "trailing slashes and one level up");
    syscall(SYS_UNLINK, "/tmp/cmdrs_rt_tst/aa/.nvmrc");
    syscall(SYS_RMDIR, "/tmp/cmdrs_rt_tst/aa/bb");
    syscall(SYS_RMDIR, "/tmp/cmdrs_rt_tst/aa");
    _rustup_tree_clean();
    return 0;
}

fn test_trimmed_copy(): i64 {
    _streq_or_dump(trimmed_copy(" \t\r\n1.2\n \r\t", 11), "1.2", "both ends, all four bytes");
    _streq_or_dump(trimmed_copy("a b", 3), "a b", "inner space stays");
    assert_eq(trimmed_copy(" \n ", 3), 0, "only whitespace is nothing");
    assert_eq(trimmed_copy("x", 0), 0, "zero bytes is nothing");
    return 0;
}

# Audit 2026-11-06, T-03. The invariant the filter owes the terminal, checked on its
# output: no C0, no DEL, and a byte in 0x80..0x9F only inside a well-formed sequence
# for a code point at or above U+00A0. Returns 1 when `s` (length `n`) holds it.
fn _sanitized_ok(s, n): i64 {
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c < 32) { return 0; }
        if (c == 127) { return 0; }
        if (c >= 128) {
            if (c <= 159) { return 0; }                 # a continuation byte with no lead
            var seq = _utf8_seq_len(s + i, n - i);
            if (seq > 0) {
                if (c == 194) {
                    if (load8(s + i + 1) < 160) { return 0; }
                }
                i = i + seq;
            } else { i = i + 1; }
        } else { i = i + 1; }
    }
    return 1;
}

# Every string of up to five bytes over the bytes that matter. Each output must hold
# the invariant and survive a second pass unchanged. Non-idempotence is the shape of
# this bug: one pass peeled a layer and joined the next one.
fn test_sanitize_invariant_exhaustive(): i64 {
    var alpha = "\x01\x1b\x7f\x80\x9b\x9d\x9f\xa0\xc2\xc3\xe0\xe2\xed\xf0\x41";
    var na = strlen(alpha);
    var buf = alloc(8);
    var bad = 0;
    var cases = 0;
    var total = 1;
    var len = 1;
    while (len <= 5) {
        total = total * na;
        var v = 0;
        while (v < total) {
            var x = v;
            var i = 0;
            while (i < len) {
                store8(buf + i, load8(alpha + (x % na)));
                x = x / na;
                i = i + 1;
            }
            store8(buf + len, 0);
            var once = sanitize_segment_output(buf);
            if (_sanitized_ok(once, strlen(once)) != 1) { bad = bad + 1; }
            if (streq(sanitize_segment_output(once), once) != 1) { bad = bad + 1; }
            cases = cases + 1;
            v = v + 1;
        }
        len = len + 1;
    }
    assert_eq(bad, 0, "every short hostile string holds the invariant and is idempotent");
    assert_eq(cases, 813615, "the sweep covered every string");
    return 0;
}

fn test_sanitize_c1_spellings(): i64 {
    _streq_or_dump(sanitize_segment_output("v\xc2\x01\x9b31m"), "v\xc2\x33\x31m", "a dropped C0 cannot join a C1 pair");
    _streq_or_dump(sanitize_segment_output("v\xc2\x7f\x9b31m"), "v\xc2\x33\x31m", "a dropped DEL cannot join a C1 pair");
    _streq_or_dump(sanitize_segment_output("v\xc2\xc2\x9b\x9b31m"), "v\xc2\x33\x31m", "a dropped pair cannot join a C1 pair");
    _streq_or_dump(sanitize_segment_output("v\xc2\xc2\xc2\x9b\x9b\x9bX"), "v\xc2\xc2X", "nesting does not survive either");
    _streq_or_dump(sanitize_segment_output("v\x9b31m"), "v31m", "a bare C1 byte is CSI to an 8-bit terminal");
    _streq_or_dump(sanitize_segment_output("v\xe0\x82\x9bX"), "v\xe0X", "an overlong C1 leaves no continuation bytes");
    return 0;
}

# Each segment is filtered alone, so the seam between two must be safe too.
fn test_sanitize_seam_between_segments(): i64 {
    var a = sanitize_segment_output("A\xc2");
    var b = sanitize_segment_output("\x9b31mB");
    var joined = alloc(strlen(a) + strlen(b) + 1);
    memcpy(joined, a, strlen(a));
    memcpy(joined + strlen(a), b, strlen(b) + 1);
    assert_eq(_sanitized_ok(joined, strlen(joined)), 1, "no C1 pair forms across two segments");
    return 0;
}

# Unicode's table of well-formed sequences, at each edge.
fn test_utf8_seq_len_bounds(): i64 {
    assert_eq(_utf8_seq_len("\xc2\x80", 2), 2, "U+0080 is the first two-byte value");
    assert_eq(_utf8_seq_len("\xc1\xbf", 2), 0, "C1 lead bytes are overlong");
    assert_eq(_utf8_seq_len("\xe0\xa0\x80", 3), 3, "U+0800 is the first three-byte value");
    assert_eq(_utf8_seq_len("\xe0\x9f\xbf", 3), 0, "below it is overlong");
    assert_eq(_utf8_seq_len("\xed\x9f\xbf", 3), 3, "U+D7FF is the last before the surrogates");
    assert_eq(_utf8_seq_len("\xed\xa0\x80", 3), 0, "a surrogate is not a sequence");
    assert_eq(_utf8_seq_len("\xf0\x90\x80\x80", 4), 4, "U+10000 is the first four-byte value");
    assert_eq(_utf8_seq_len("\xf0\x8f\xbf\xbf", 4), 0, "below it is overlong");
    assert_eq(_utf8_seq_len("\xf4\x8f\xbf\xbf", 4), 4, "U+10FFFF is the last value");
    assert_eq(_utf8_seq_len("\xf4\x90\x80\x80", 4), 0, "past it is not a sequence");
    assert_eq(_utf8_seq_len("\xf5\x80\x80\x80", 4), 0, "0xF5 is no lead byte");
    assert_eq(_utf8_seq_len("\xe2\x82\xac", 2), 0, "a sequence cut by the length is not one");
    assert_eq(_utf8_seq_len("\xe2\x82\x41", 3), 0, "nor is one with a bad last byte");
    return 0;
}

fn test_sanitized_len_takes_a_failed_sanitize(): i64 {
    assert_eq(sanitized_len(0), 0, "a refused alloc is nothing to paint, not a fault");
    assert_eq(sanitized_len("abc"), 3, "otherwise it is strlen");
    return 0;
}

fn test_sanitize_keeps_text(): i64 {
    _streq_or_dump(sanitize_segment_output("caf\xc3\xa9 \xe2\x82\xac \xf0\x9f\x98\x80"), "caf\xc3\xa9 \xe2\x82\xac \xf0\x9f\x98\x80", "UTF-8 text is untouched");
    _streq_or_dump(sanitize_segment_output("\xc2\xa0\xe0\xa0\x80\xef\xbf\xbf"), "\xc2\xa0\xe0\xa0\x80\xef\xbf\xbf", "the edges of each UTF-8 length survive");
    _streq_or_dump(sanitize_segment_output("\xe2\x80\x9c"), "\xe2\x80\x9c", "0x9C is fine as a real continuation byte");
    _streq_or_dump(sanitize_segment_output("caf\xe9"), "caf\xe9", "a Latin-1 name still renders");
    return 0;
}

# ---- rustup_env ----

# Same shape as node_env's empty-outside-project guard.
fn test_rustup_env_render_empty_outside_project(): i64 {
    var out = rustup_env_render(0);
    assert_eq(out, 0, "rustup_env_render outside any rust-toolchain tree → empty");
    return 0;
}

# Helpers-against-temp-tree to verify the rust-toolchain marker walks
# + reads cleanly. Mirrors test_node_env_helpers_against_temp_tree.
fn test_rustup_env_helpers_against_temp_tree(): i64 {
    syscall(SYS_UNLINK, "/tmp/cmdrs_rustup_tst/rust-toolchain");
    syscall(SYS_RMDIR, "/tmp/cmdrs_rustup_tst/sub");
    syscall(SYS_RMDIR, "/tmp/cmdrs_rustup_tst");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_rustup_tst", 0x1FF), 0, "mkdir tmp root");
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_rustup_tst/sub", 0x1FF), 0, "mkdir subdir");
    var fd = file_open("/tmp/cmdrs_rustup_tst/rust-toolchain", O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(fd >= 0, "open rust-toolchain for write");
    file_write(fd, "1.75.0\n", 7);
    file_close(fd);

    var root = find_ancestor_with("/tmp/cmdrs_rustup_tst/sub", "/rust-toolchain");
    assert_neq(root, 0, "find_ancestor_with(sub, /rust-toolchain) returns non-null");
    _streq_or_dump(root, "/tmp/cmdrs_rustup_tst", "walked up to root containing rust-toolchain");

    var ver = read_trimmed_file_at(root, "/rust-toolchain");
    _streq_or_dump(ver, "1.75.0", "rust-toolchain contents trimmed");

    # Channel-name style content (`stable`, `nightly`) should pass.
    fd = file_open("/tmp/cmdrs_rustup_tst/rust-toolchain", O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(fd >= 0, "reopen rust-toolchain for channel name");
    file_write(fd, "stable\n", 7);
    file_close(fd);
    var ch = read_trimmed_file_at(root, "/rust-toolchain");
    _streq_or_dump(ch, "stable", "rust-toolchain passes channel names verbatim");

    syscall(SYS_UNLINK, "/tmp/cmdrs_rustup_tst/rust-toolchain");
    syscall(SYS_RMDIR, "/tmp/cmdrs_rustup_tst/sub");
    syscall(SYS_RMDIR, "/tmp/cmdrs_rustup_tst");
    return 0;
}

# ---- color ----

fn test_color_fg_standard_eight(): i64 {
    assert_eq(color_to_sgr_fg("black"),   30, "fg(black) == 30");
    assert_eq(color_to_sgr_fg("red"),     31, "fg(red) == 31");
    assert_eq(color_to_sgr_fg("green"),   32, "fg(green) == 32");
    assert_eq(color_to_sgr_fg("yellow"),  33, "fg(yellow) == 33");
    assert_eq(color_to_sgr_fg("blue"),    34, "fg(blue) == 34");
    assert_eq(color_to_sgr_fg("magenta"), 35, "fg(magenta) == 35");
    assert_eq(color_to_sgr_fg("cyan"),    36, "fg(cyan) == 36");
    assert_eq(color_to_sgr_fg("white"),   37, "fg(white) == 37");
    return 0;
}

fn test_color_fg_bright_eight(): i64 {
    assert_eq(color_to_sgr_fg("bright_black"),   90, "fg(bright_black) == 90");
    assert_eq(color_to_sgr_fg("bright_red"),     91, "fg(bright_red) == 91");
    assert_eq(color_to_sgr_fg("bright_green"),   92, "fg(bright_green) == 92");
    assert_eq(color_to_sgr_fg("bright_yellow"),  93, "fg(bright_yellow) == 93");
    assert_eq(color_to_sgr_fg("bright_blue"),    94, "fg(bright_blue) == 94");
    assert_eq(color_to_sgr_fg("bright_magenta"), 95, "fg(bright_magenta) == 95");
    assert_eq(color_to_sgr_fg("bright_cyan"),    96, "fg(bright_cyan) == 96");
    assert_eq(color_to_sgr_fg("bright_white"),   97, "fg(bright_white) == 97");
    return 0;
}

fn test_color_fg_absent_or_default(): i64 {
    assert_eq(color_to_sgr_fg(0),         0, "fg(null) == 0 (no code)");
    assert_eq(color_to_sgr_fg(""),        0, "fg(\"\") == 0");
    assert_eq(color_to_sgr_fg("default"), 0, "fg(default) == 0");
    assert_eq(color_to_sgr_fg("xyzzy"),   0, "fg(unknown) == 0");
    return 0;
}

fn test_color_bg_is_fg_plus_ten(): i64 {
    assert_eq(color_to_sgr_bg("black"),         40, "bg(black) == 40");
    assert_eq(color_to_sgr_bg("red"),           41, "bg(red) == 41");
    assert_eq(color_to_sgr_bg("white"),         47, "bg(white) == 47");
    assert_eq(color_to_sgr_bg("bright_black"), 100, "bg(bright_black) == 100");
    assert_eq(color_to_sgr_bg("bright_white"), 107, "bg(bright_white) == 107");
    assert_eq(color_to_sgr_bg("default"),       0, "bg(default) == 0");
    assert_eq(color_to_sgr_bg(0),               0, "bg(null) == 0");
    return 0;
}

fn test_style_single_mod(): i64 {
    var codes[32];
    assert_eq(style_to_sgr_mods("bold",      &codes, 4), 1, "style(bold) writes 1 code");
    assert_eq(load64(&codes), 1, "  → code is 1");
    assert_eq(style_to_sgr_mods("italic",    &codes, 4), 1, "style(italic) writes 1 code");
    assert_eq(load64(&codes), 3, "  → code is 3");
    assert_eq(style_to_sgr_mods("underline", &codes, 4), 1, "style(underline) writes 1 code");
    assert_eq(load64(&codes), 4, "  → code is 4");
    assert_eq(style_to_sgr_mods("reverse",   &codes, 4), 1, "style(reverse) writes 1 code");
    assert_eq(load64(&codes), 7, "  → code is 7");
    return 0;
}

fn test_style_multi_mod_preserves_order(): i64 {
    var codes[32];
    assert_eq(style_to_sgr_mods("bold italic", &codes, 4), 2, "style(bold italic) writes 2 codes");
    assert_eq(load64(&codes),     1, "  first code is bold (1)");
    assert_eq(load64(&codes + 8), 3, "  second code is italic (3)");
    return 0;
}

fn test_style_unknown_words_skipped(): i64 {
    var codes[32];
    assert_eq(style_to_sgr_mods("bogus bold xyzzy", &codes, 4), 1, "unknown words skipped");
    assert_eq(load64(&codes), 1, "  only bold made it in");
    return 0;
}

fn test_style_absent_or_empty(): i64 {
    var codes[32];
    assert_eq(style_to_sgr_mods(0,    &codes, 4), 0, "style(null) == 0");
    assert_eq(style_to_sgr_mods("",   &codes, 4), 0, "style(\"\") == 0");
    assert_eq(style_to_sgr_mods("   ", &codes, 4), 0, "style(whitespace) == 0");
    return 0;
}

fn test_sgr_open_all_default_returns_zero(): i64 {
    assert_eq(sgr_open_for(0, 0, 0),                       0, "sgr_open(null,null,null) == 0");
    assert_eq(sgr_open_for("default", "default", ""),      0, "sgr_open(default,default,empty) == 0");
    assert_eq(sgr_open_for("xyzzy", "abcde", "bogus"),     0, "sgr_open(unknowns) == 0");
    return 0;
}

fn test_sgr_open_fg_only(): i64 {
    var out = sgr_open_for("red", 0, 0);
    assert_neq(out, 0, "sgr_open(red,_,_) returns non-null");
    _streq_or_dump(out, "\x1b[31m", "sgr_open(red) == \"\\x1b[31m\"");
    return 0;
}

fn test_sgr_open_bg_only(): i64 {
    var out = sgr_open_for(0, "blue", 0);
    _streq_or_dump(out, "\x1b[44m", "sgr_open(_,blue,_) == \"\\x1b[44m\"");
    return 0;
}

fn test_sgr_open_style_only(): i64 {
    var out = sgr_open_for(0, 0, "bold");
    _streq_or_dump(out, "\x1b[1m", "sgr_open(_,_,bold) == \"\\x1b[1m\"");
    return 0;
}

fn test_sgr_open_combined_order(): i64 {
    # Order: modifiers first, then fg, then bg (matches starship + most
    # terminal style guides).
    var out = sgr_open_for("cyan", "black", "bold");
    _streq_or_dump(out, "\x1b[1;36;40m", "sgr_open(cyan/black/bold) == \"\\x1b[1;36;40m\"");
    return 0;
}

fn test_sgr_open_three_digit_codes(): i64 {
    # bright_white bg is 107 — exercises the 3-digit emit branch.
    var out = sgr_open_for(0, "bright_white", 0);
    _streq_or_dump(out, "\x1b[107m", "sgr_open(_,bright_white,_) == \"\\x1b[107m\"");
    return 0;
}

fn test_sgr_open_multi_mod_plus_color(): i64 {
    var out = sgr_open_for("yellow", 0, "bold underline");
    _streq_or_dump(out, "\x1b[1;4;33m", "sgr_open(yellow,_,bold underline) == \"\\x1b[1;4;33m\"");
    return 0;
}

fn test_sgr_reset_constant(): i64 {
    _streq_or_dump(SGR_RESET, "\x1b[0m", "SGR_RESET == \"\\x1b[0m\"");
    return 0;
}

# ---- sanitize_segment_output (audit F-1) ----

fn test_sanitize_strips_esc_mid_string(): i64 {
    # The classic vcs-branch-name attack: `evil\x1b[2J` would clear
    # the user's terminal screen on every redraw without sanitization.
    var out = sanitize_segment_output("evil\x1b[2Jbad");
    _streq_or_dump(out, "evil[2Jbad", "ESC stripped, surrounding text preserved");
    return 0;
}

# Audit 2026-08-26, A-05. The filter used to pass every byte >= 0x80 on the
# reasoning that they are UTF-8 continuation bytes, not controls. True of the
# bytes, false of the codepoints: U+0080–U+009F is the C1 control set, and a
# UTF-8 terminal honouring C1 reads U+009B as CSI and U+009D as OSC — F-1's
# whole threat, smuggled past it two bytes at a time. Verified reaching stdout
# byte-for-byte before the fix.
fn test_sanitize_strips_utf8_c1_controls(): i64 {
    # \xc2\x9b = U+009B (CSI), \xc2\x9d = U+009D (OSC), \xc2\x9c = U+009C (ST).
    var out = sanitize_segment_output("v\xc2\x9b31mRED\xc2\x9d0;t\xc2\x9c");
    _streq_or_dump(out, "v31mRED0;t", "UTF-8-encoded C1 controls stripped");
    return 0;
}

# The other half of A-05: the fix must not eat legitimate text. 0xC2 followed
# by 0xA0..0xBF is ordinary Latin-1 punctuation, and 0xC3 sequences are not
# C1 at all.
fn test_sanitize_keeps_legitimate_utf8(): i64 {
    # caf\xc3\xa9 = "café"; \xc2\xa0 = NO-BREAK SPACE (U+00A0, just past C1).
    var out = sanitize_segment_output("caf\xc3\xa9\xc2\xa0ok");
    _streq_or_dump(out, "caf\xc3\xa9\xc2\xa0ok", "é and U+00A0 survive the C1 filter");
    return 0;
}

# Audit 2026-08-26, A-01. `read_regular_file` must refuse anything that is not
# a regular file — that is what stops a FIFO in a hostile project directory
# from parking the prompt in open(2) forever. A directory is the portable
# stand-in a test can create without mknod: open(2) on it succeeds, so only the
# fstat/S_IFREG gate rejects it. If this returns bytes, the gate is gone and
# the FIFO hang is back.
fn test_read_regular_file_rejects_non_regular(): i64 {
    var buf[64];
    var n = read_regular_file("/tmp", &buf, 64);
    var rejected = 0;
    if (n <= 0) { rejected = 1; }
    assert(rejected, "read_regular_file refuses a directory (S_IFREG gate live)");
    return 0;
}

fn test_sanitize_strips_all_c0_bytes(): i64 {
    # Every C0 control byte (0x00..0x1F) must be filtered.
    var input = "a\x01b\x02c\x07d\x0Ae\x0Df\x1bg\x1fh";
    var out = sanitize_segment_output(input);
    _streq_or_dump(out, "abcdefgh", "all C0 control bytes stripped");
    return 0;
}

fn test_sanitize_strips_del(): i64 {
    var out = sanitize_segment_output("hello\x7Fworld");
    _streq_or_dump(out, "helloworld", "DEL (0x7F) stripped");
    return 0;
}

fn test_sanitize_passes_through_utf8(): i64 {
    # UTF-8 continuation bytes (0x80–0xBF) must pass — they're part
    # of multi-byte sequences, not standalone control characters.
    # "café" = 63 61 66 c3 a9
    var out = sanitize_segment_output("caf\xc3\xa9");
    _streq_or_dump(out, "caf\xc3\xa9", "UTF-8 \"café\" passes through intact");
    return 0;
}

fn test_sanitize_empty_input(): i64 {
    var out = sanitize_segment_output("");
    assert_neq(out, 0, "sanitize(\"\") returns non-null pointer");
    assert_eq(strlen(out), 0, "sanitize(\"\") returns empty cstring");
    return 0;
}

fn test_sanitize_null_input(): i64 {
    assert_eq(sanitize_segment_output(0), 0, "sanitize(null) returns 0");
    return 0;
}

fn test_sanitize_all_controls_yields_empty(): i64 {
    # Pure-malice input: every byte is a control. Result is an empty
    # cstring — the F-1 render guard treats this as "skip the paint
    # entirely" so a downstream segment doesn't get a stray separator.
    var out = sanitize_segment_output("\x1b\x07\x0a\x0d\x00");
    # NB: \x00 means we can't use strlen on the ORIGINAL "input"
    # because the cstring terminates early; the helper sees the byte
    # via load8 + strlen on `s` (which already stops at the first
    # NUL anyway). So this test actually exercises the four bytes
    # before the NUL: ESC, BEL, LF, CR. All stripped.
    assert_neq(out, 0, "sanitize(all controls) returns non-null pointer");
    assert_eq(strlen(out), 0, "sanitize(all controls) returns empty cstring");
    return 0;
}

fn test_sanitize_no_change_for_clean_input(): i64 {
    var out = sanitize_segment_output("clean-branch-name-1.2.3");
    _streq_or_dump(out, "clean-branch-name-1.2.3", "clean input passes through");
    return 0;
}

# ---- cache ----

# Roundtrip: write a value, read it back within the TTL window.
fn test_cache_roundtrip(): i64 {
    cache_init();
    cache_put("tst_rt", "/some/cwd", "hello", 5);
    var v = cache_get("tst_rt", "/some/cwd", 1);
    assert_neq(v, 0, "cache_get returns non-null after put");
    _streq_or_dump(v, "hello", "cache roundtrip preserves bytes");
    return 0;
}

# Distinct cwds → distinct cache files; one's writes don't leak.
fn test_cache_per_cwd_isolation(): i64 {
    cache_init();
    cache_put("tst_iso", "/cwd/a", "AAA", 3);
    cache_put("tst_iso", "/cwd/b", "BBB", 3);
    var va = cache_get("tst_iso", "/cwd/a", 1);
    var vb = cache_get("tst_iso", "/cwd/b", 1);
    _streq_or_dump(va, "AAA", "cwd a returns AAA");
    _streq_or_dump(vb, "BBB", "cwd b returns BBB");
    return 0;
}

# Empty value caching: the "no sit repo here" case stashes "" so
# subsequent redraws short-circuit the find_in_path + shellout.
fn test_cache_empty_value(): i64 {
    cache_init();
    cache_put("tst_empty", "/cwd/none", "", 0);
    var v = cache_get("tst_empty", "/cwd/none", 1);
    assert_neq(v, 0, "cached empty returns non-null pointer");
    assert_eq(strlen(v), 0, "cached empty content has length 0");
    return 0;
}

# Cache miss when no entry exists.
fn test_cache_miss_when_absent(): i64 {
    cache_init();
    var v = cache_get("tst_miss", "/cwd/never-written", 1);
    assert_eq(v, 0, "missing cache entry returns 0");
    return 0;
}

# F-5 audit: cache_put writes the file atomically via temp+rename
# with mode 0o600. After put, stat the file and check the mode bits.
fn test_cache_put_writes_mode_0600(): i64 {
    cache_init();
    cache_put("tst_mode", "/cwd/mode-check", "x", 1);

    # Rebuild the cache file path via the same helper render uses, then
    # stat it.
    var path = _cache_path("tst_mode", "/cwd/mode-check");
    var stbuf[144];
    assert_eq(sys_stat(path, &stbuf), 0, "stat the cache file");
    var mode = load32(&stbuf + 24);
    # 0x1ff masks the 9 permission bits; 0x180 = 0o600.
    assert_eq(mode & 0x1ff, 0x180, "cache file mode == 0o600 (audit F-5/F-11)");
    return 0;
}

# F-4 audit: O_NOFOLLOW on cache_get refuses to traverse a symlink.
# Pre-write a legitimate cache, replace it with a symlink to a file
# we definitely shouldn't read through the cache (/etc/passwd is
# world-readable so this isn't a real exfiltration — we just verify
# the read REFUSES, not that confidentiality holds against a tool
# we could otherwise just `cat` directly).
# ---- audit F-7: parse_last_exit ----

fn test_parse_last_exit_null(): i64 {
    assert_eq(parse_last_exit(0), 0, "parse_last_exit(null) == 0");
    return 0;
}

fn test_parse_last_exit_empty(): i64 {
    assert_eq(parse_last_exit(""), 0, "parse_last_exit(\"\") == 0");
    return 0;
}

fn test_parse_last_exit_normal(): i64 {
    assert_eq(parse_last_exit("0"), 0, "parse_last_exit(\"0\") == 0");
    assert_eq(parse_last_exit("1"), 1, "parse_last_exit(\"1\") == 1");
    assert_eq(parse_last_exit("42"), 42, "parse_last_exit(\"42\") == 42");
    assert_eq(parse_last_exit("255"), 255, "parse_last_exit(\"255\") == 255");
    return 0;
}

# > 10 digits → reject (returns 0, the segment-empty path).
fn test_parse_last_exit_clamps_overlong_input(): i64 {
    assert_eq(parse_last_exit("99999999999"), 0, "11-digit input returns 0");
    assert_eq(parse_last_exit("9999999999999999999999"), 0, "22-digit input returns 0");
    return 0;
}

# Within 10 digits but > 65535 → clamp to 65535.
fn test_parse_last_exit_clamps_overlarge_value(): i64 {
    assert_eq(parse_last_exit("65536"), 65535, "65536 clamps to 65535");
    assert_eq(parse_last_exit("999999"), 65535, "999999 clamps to 65535");
    return 0;
}

fn test_parse_last_exit_rejects_negative(): i64 {
    assert_eq(parse_last_exit("-1"),  0, "\"-1\" returns 0");
    assert_eq(parse_last_exit("-99"), 0, "\"-99\" returns 0");
    return 0;
}

# ---- audit F-8: find_in_path_with rejects relative entries ----

fn test_find_in_path_rejects_relative(): i64 {
    # PATH is just "bin" (relative). Walker must skip it.
    assert_eq(find_in_path_with("bin", "sh"), 0, "relative PATH entry skipped");
    return 0;
}

fn test_find_in_path_rejects_dot(): i64 {
    # `.` and `..` are the canonical attacker entries. Skip them.
    assert_eq(find_in_path_with(".",  "sh"), 0, "PATH=\".\" skipped");
    assert_eq(find_in_path_with("..", "sh"), 0, "PATH=\"..\" skipped");
    # Mix: PATH=":./bin" should skip both the empty and the relative.
    assert_eq(find_in_path_with(":./bin", "sh"), 0, "PATH=\":./bin\" skipped");
    return 0;
}

fn test_find_in_path_absolute_works(): i64 {
    # PATH with one valid absolute entry should still find `sh`.
    var hit = find_in_path_with("/bin", "sh");
    assert_neq(hit, 0, "absolute PATH entry resolves");
    if (hit != 0) {
        _streq_or_dump(hit, "/bin/sh", "PATH=\"/bin\" finds /bin/sh");
    }
    # Even with a leading relative entry, the absolute one downstream
    # wins: `bin:/bin` → skip `bin`, hit `/bin`.
    var hit2 = find_in_path_with("bin:/bin", "sh");
    _streq_or_dump(hit2, "/bin/sh", "relative entry skipped, absolute entry resolves");
    return 0;
}

fn test_cache_get_refuses_symlink(): i64 {
    cache_init();
    cache_put("tst_nofollow", "/cwd/nofollow", "legit", 5);
    var path = _cache_path("tst_nofollow", "/cwd/nofollow");

    # Replace the cache file with a symlink. unlink + symlink as a pair is the
    # canonical attacker move. The target is a valid entry for this cwd, so the only
    # thing that can refuse it is O_NOFOLLOW: the key inside the entry would pass.
    var target = "/tmp/cmdrs-test-nofollow-target";
    var key = _cache_key_hex("/cwd/nofollow");
    var entry = alloc(CACHE_KEY_DIGITS + 5);
    memcpy(entry, key, CACHE_KEY_DIGITS);
    memcpy(entry + CACHE_KEY_DIGITS, "forge", 5);
    file_write_all(target, entry, CACHE_KEY_DIGITS + 5);
    assert_eq(syscall(SYS_UNLINK, path), 0, "unlink legitimate cache file");
    assert_eq(syscall(88, target, path), 0, "create symlink to a forged entry");   # SYS_SYMLINK

    var v = cache_get("tst_nofollow", "/cwd/nofollow", 60);
    assert_eq(v, 0, "cache_get on a symlink refuses (O_NOFOLLOW → 0)");

    # Cleanup the symlink so the test is hermetic.
    syscall(SYS_UNLINK, path);
    syscall(SYS_UNLINK, target);
    return 0;
}

# ---- pathlookup ----

# Find `sh` on PATH — present on every conceivable POSIX host. Skip
# when PATH itself is unset (stripped-container case) so the suite
# stays green outside a normal shell environment.
fn test_pathlookup_finds_sh(): i64 {
    if (getenv("PATH") == 0) {
        assert(1, "pathlookup_finds_sh skipped (PATH unset)");
        return 0;
    }
    var hit = find_in_path("sh");
    assert_neq(hit, 0, "find_in_path(\"sh\") returns non-null");
    if (hit != 0) {
        var n = strlen(hit);
        var ok = 0;
        if (n >= 3) {
            if (load8(hit + n - 3) == 47) {                  # '/'
                if (load8(hit + n - 2) == 115) {             # 's'
                    if (load8(hit + n - 1) == 104) {         # 'h'
                        ok = 1;
                    }
                }
            }
        }
        assert(ok, "find_in_path(\"sh\") result ends in \"/sh\"");
        assert_eq(syscall(SYS_ACCESS, hit, 1), 0, "find_in_path(\"sh\") result passes access(X_OK)");
    }
    return 0;
}

# Garbage name that nobody would ship: returns 0, no crash.
fn test_pathlookup_misses_unknown(): i64 {
    if (getenv("PATH") == 0) {
        assert(1, "pathlookup_misses_unknown skipped (PATH unset)");
        return 0;
    }
    var hit = find_in_path("__cmdrs_does_not_exist_xyz__");
    assert_eq(hit, 0, "find_in_path(garbage) returns 0");
    return 0;
}

fn test_shellout_happy_path(): i64 {
    if (syscall(SYS_ACCESS, "/bin/echo", 1) != 0) {
        assert(1, "shellout_happy_path skipped (no /bin/echo)");
        return 0;
    }
    var argv = alloc(24);
    store64(argv, "/bin/echo");
    store64(argv + 8, "hello");
    store64(argv + 16, 0);
    var envp = alloc(8);
    store64(envp, 0);
    var buf[64];
    var n = shellout_capture("/bin/echo", argv, envp, 1000, &buf, 64);
    assert_eq(n, 6, "echo hello → 6 bytes (h e l l o \\n)");
    if (n == 6) {
        var ok = 1;
        if (load8(&buf) != 104)  { ok = 0; }  # h
        if (load8(&buf + 1) != 101) { ok = 0; } # e
        if (load8(&buf + 2) != 108) { ok = 0; } # l
        if (load8(&buf + 3) != 108) { ok = 0; } # l
        if (load8(&buf + 4) != 111) { ok = 0; } # o
        if (load8(&buf + 5) != 10)  { ok = 0; } # \n
        assert(ok, "echo hello → buf == \"hello\\n\"");
    }
    return 0;
}

fn test_shellout_timeout_kills_child(): i64 {
    if (syscall(SYS_ACCESS, "/bin/sleep", 1) != 0) {
        assert(1, "shellout_timeout_kills_child skipped (no /bin/sleep)");
        return 0;
    }
    var argv = alloc(24);
    store64(argv, "/bin/sleep");
    store64(argv + 8, "1");                 # 1 second
    store64(argv + 16, 0);
    var envp = alloc(8);
    store64(envp, 0);
    var buf[64];
    var start_ms = clock_now_ms();
    var n = shellout_capture("/bin/sleep", argv, envp, 10, &buf, 64);
    var elapsed_ms = clock_now_ms() - start_ms;
    assert_eq(n, 0 - 2, "sleep 1 with 10ms budget → -2 (timeout)");
    var fast_enough = 0;
    if (elapsed_ms < 200) { fast_enough = 1; }
    assert(fast_enough, "sleep 1 returned in well under 1s (child was killed, not waited out)");
    return 0;
}

# Regression guard for a load-bearing ORDERING in shellout_capture
# (audit 2026-08-26, P-05 — investigated as a suspected deadlock, confirmed
# SAFE, and pinned here so it stays that way).
#
# When a child writes MORE than the capture buffer holds, the read loop stops
# early with `timed_out == 0`, so the child is never SIGKILLed. The child is
# still writing, and once the 64 KB pipe buffer fills it blocks in write().
# If the parent then called waitpid() while still holding the read end open,
# both sides would block forever and the shell's prompt would hang — exactly
# what the watchdog exists to prevent.
#
# It does not hang, for one reason: `sys_close(rfd)` runs BEFORE
# `sys_waitpid` in src/shellout.cyr. Closing the last read end makes the
# blocked child's next write fail with EPIPE/SIGPIPE, so it dies and waitpid
# reaps it immediately. Swap those two lines and the prompt deadlocks.
#
# Verified live at audit time: a child flooding 200 KB through a 256-byte
# buffer returned in 5 ms. This test keeps that true.
fn test_shellout_oversized_child_does_not_hang(): i64 {
    if (syscall(SYS_ACCESS, "/bin/sh", 1) != 0) {
        assert(1, "shellout_oversized_child skipped (no /bin/sh)");
        return 0;
    }
    var argv = alloc(32);
    store64(argv, "/bin/sh");
    store64(argv + 8, "-c");
    # ~256 KB of output, far past both the capture buffer and the pipe.
    store64(argv + 16, "i=0; while [ $i -lt 4096 ]; do printf '%064d' $i; i=$((i+1)); done");
    store64(argv + 24, 0);
    var envp = alloc(8);
    store64(envp, 0);
    var buf[256];
    var start_ms = clock_now_ms();
    # Generous 2 s budget: we are NOT testing the timeout here. If the
    # buffer-full path deadlocked, the budget would not save us either —
    # the parent blocks in waitpid, which no deadline covers.
    var n = shellout_capture("/bin/sh", argv, envp, 2000, &buf, 256);
    var elapsed_ms = clock_now_ms() - start_ms;
    var bounded = 0;
    if (n <= 256) { bounded = 1; }
    assert(bounded, "oversized child output is capped at the buffer size");
    var no_hang = 0;
    if (elapsed_ms < 1500) { no_hang = 1; }
    assert(no_hang, "buffer-full path returns promptly (close(rfd) precedes waitpid)");
    return 0;
}

# The hang the buffer-full test does NOT cover (audit 2026-08-26, A-02 HIGH).
#
# A child that closes or redirects its stdout and then keeps running makes the
# read loop exit on EOF (`n <= 0`) with `timed_out == 0`. Before A-02 the child
# was only killed when the deadline fired, so this path went straight to
# waitpid on a live child — and the EPIPE trick that rescues the buffer-full
# case does nothing here, because the child is not writing and never notices
# the closed pipe. Nothing covers a parent parked in waitpid: the budget is
# enforced by epoll_wait, which we have already left.
#
# Measured before the fix with a fake `cyrius` doing `exec 1>&-; sleep 30`:
# the prompt blocked for the full 30 s against a 5 ms budget. Fixed by killing
# the child unconditionally before the wait.
fn test_shellout_eof_with_live_child_does_not_hang(): i64 {
    if (syscall(SYS_ACCESS, "/bin/sh", 1) != 0) {
        assert(1, "shellout_eof_with_live_child skipped (no /bin/sh)");
        return 0;
    }
    var argv = alloc(32);
    store64(argv, "/bin/sh");
    store64(argv + 8, "-c");
    # Close stdout, then outlive the budget by a wide margin.
    store64(argv + 16, "exec 1>&-; sleep 5");
    store64(argv + 24, 0);
    var envp = alloc(8);
    store64(envp, 0);
    var buf[256];
    var start_ms = clock_now_ms();
    var n = shellout_capture("/bin/sh", argv, envp, 20, &buf, 256);
    var elapsed_ms = clock_now_ms() - start_ms;
    # The child produced nothing before closing stdout.
    var empty = 0;
    if (n <= 0) { empty = 1; }
    assert(empty, "child that closes stdout yields no captured bytes");
    # The point of the test: we must not have waited out the child's 5 s.
    var no_hang = 0;
    if (elapsed_ms < 1000) { no_hang = 1; }
    assert(no_hang, "EOF-with-live-child returns promptly (child killed before waitpid)");
    return 0;
}

# ---- cli (cmdit adoption, 1.1.5) ----
#
# These drive cmdit's PURE core, `cmdit_parse_argv`, over a synthetic argv:
# no /proc read, no environment, no process spawn. That is the whole reason
# `src/cli.cyr` exists as a module — the hand-rolled `_parse_side` it replaced
# read the real process argv from inside `src/main.cyr` (a file no test can
# include, since it ends in a bare `_agnos_entry();`), so it had zero coverage.

fn _mk_argv(a0, a1, a2): i64 {
    var n = 1;
    if (a1 != 0) { n = 2; }
    if (a2 != 0) { n = 3; }
    var v = alloc(n * 8);
    store64(v, a0);
    if (a1 != 0) { store64(v + 8, a1); }
    if (a2 != 0) { store64(v + 16, a2); }
    return v;
}

fn _argc_of(a1, a2): i64 {
    if (a2 != 0) { return 3; }
    if (a1 != 0) { return 2; }
    return 1;
}

# Full pipeline under test: register the table, parse synthetic argv, map the
# result to a side through the degrade policy.
fn _side_of(a1, a2): i64 {
    var cli = cmdit_new("cmdrs");
    var f = cli_register(cli);
    var pr = cmdit_parse_argv(cli, _argc_of(a1, a2), _mk_argv("cmdrs", a1, a2));
    return cli_side_for(cli, f, pr);
}

# The raw cmdit result, for the cases where the RESULT is the assertion.
fn _parse_result_of(a1, a2): i64 {
    var cli = cmdit_new("cmdrs");
    cli_register(cli);
    return cmdit_parse_argv(cli, _argc_of(a1, a2), _mk_argv("cmdrs", a1, a2));
}

# The guard that makes the compiled-in version literal trustworthy: if someone
# bumps VERSION and forgets src/cli.cyr, `cmdrs --version` would confidently
# print the old number. Fail the suite instead.
fn test_cli_version_matches_version_file(): i64 {
    var from_file = read_trimmed_file_at(".", "/VERSION");
    assert_nonnull(from_file, "VERSION file readable from repo root");
    assert_streq(cmdrs_version(), from_file,
      "cmdrs_version() matches the VERSION file (bump both)");
    return 0;
}

fn test_cli_default_is_left(): i64 {
    assert_eq(_side_of(0, 0), 0, "no flags → left (side 0)");
    return 0;
}

fn test_cli_side_right(): i64 {
    assert_eq(_side_of("--side=right", 0), 1, "--side=right → right (side 1)");
    return 0;
}

fn test_cli_side_left_explicit(): i64 {
    assert_eq(_side_of("--side=left", 0), 0, "--side=left → left (side 0)");
    return 0;
}

# getopt-long space form. The hand-rolled walk only ever matched the single
# attached string `--side=right`, so this shape is new in 1.1.5 — additive,
# and free with the parser.
fn test_cli_side_space_form(): i64 {
    assert_eq(_side_of("--side", "right"), 1, "--side right (space form) → right");
    return 0;
}

# The degrade policy. Both of these rendered the left prompt in 1.1.4 by
# falling through; they still do, but now via an explicit parse error that
# cmdit_print_error names on stderr.
fn test_cli_bad_enum_degrades_to_left(): i64 {
    assert_eq(_parse_result_of("--side=bogus", 0), CMDIT_RESULT_ERR,
      "--side=bogus → parse error (choice set validated)");
    assert_eq(_side_of("--side=bogus", 0), 0, "--side=bogus still renders left, not empty");
    return 0;
}

fn test_cli_unknown_flag_degrades_to_left(): i64 {
    assert_eq(_parse_result_of("--nope", 0), CMDIT_RESULT_ERR, "--nope → parse error");
    assert_eq(_side_of("--nope", 0), 0, "unknown flag still renders left, not empty");
    return 0;
}

# Audit 2026-08-26, A-07 — the case the 1.1.5 CLI tests missed. They checked
# that a bad flag ALONE renders the left prompt, which is just the default, and
# so passed for the wrong reason. The real question is what happens when a VALID
# `--side=right` is combined with a bad flag: the old code discarded the parsed
# side and rendered the LEFT prompt, which the zsh adapter would paste into
# RPROMPT.
fn test_cli_side_survives_an_unrelated_parse_error(): i64 {
    assert_eq(_parse_result_of("--side=right", "--nope"), CMDIT_RESULT_ERR,
      "--side=right --nope is still a parse error");
    assert_eq(_side_of("--side=right", "--nope"), 1,
      "a successfully parsed --side=right survives an unrelated bad flag");
    return 0;
}

fn test_cli_help_short_circuits(): i64 {
    assert_eq(_parse_result_of("--help", 0), CMDIT_HELP, "--help → CMDIT_HELP");
    assert_eq(_parse_result_of("-h", 0), CMDIT_HELP, "-h → CMDIT_HELP");
    return 0;
}

fn test_cli_version_short_circuits(): i64 {
    assert_eq(_parse_result_of("--version", 0), CMDIT_VERSION, "--version → CMDIT_VERSION");
    assert_eq(_parse_result_of("-V", 0), CMDIT_VERSION, "-V → CMDIT_VERSION");
    return 0;
}

# A bare positional is not an error and must not disturb the side. agnoshi's
# adapter contract passes no positionals, but a user experimenting at the shell
# should still get their prompt.
fn test_cli_positional_ignored(): i64 {
    assert_eq(_parse_result_of("somearg", 0), CMDIT_OK, "positional parses clean");
    assert_eq(_side_of("somearg", 0), 0, "positional → left, no error");
    return 0;
}

