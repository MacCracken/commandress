# ---- vcs budget_ms (1.2.2) ----
fn test_config_vcs_budget_ms(): i64 {
    var c = config_load(0);
    assert_eq(cfg_vcs_budget_ms(c), VCS_BUDGET_MS, "default budget_ms");

    var path = _write_test_config("budget", "[[segments.vcs]]\nbudget_ms = 40\n");
    assert_eq(cfg_vcs_budget_ms(config_load(path)), 40, "budget_ms override");
    syscall(SYS_UNLINK, path);

    path = _write_test_config("budgetc", "[[segments.vcs]]\nbudget_ms = 1000 # slow disk\n");
    assert_eq(cfg_vcs_budget_ms(config_load(path)), 1000, "the cap itself is accepted, with a comment");
    syscall(SYS_UNLINK, path);

    assert_eq(_budget_ms_value(str_from("1")), 1, "the floor is accepted");
    assert_eq(_budget_ms_value(str_from("0")), 0, "zero is refused");
    assert_eq(_budget_ms_value(str_from("1001")), 0, "past the cap is refused");
    assert_eq(_budget_ms_value(str_from("99999999")), 0, "a long number is refused");
    assert_eq(_budget_ms_value(str_from("-5")), 0, "a sign is refused");
    assert_eq(_budget_ms_value(str_from("5ms")), 0, "a unit is refused");
    assert_eq(_budget_ms_value(str_from("1a")), 0, "a letter that stays under the cap is refused");
    assert_eq(_budget_ms_value(str_from("")), 0, "empty is refused");

    path = _write_test_config("budgetb", "[[segments.vcs]]\nbudget_ms = 100000\n");
    assert_eq(cfg_vcs_budget_ms(config_load(path)), VCS_BUDGET_MS, "a refused value keeps the default");
    syscall(SYS_UNLINK, path);
    return 0;
}

