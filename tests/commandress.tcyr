# commandress test suite — M1 segments + config loader.
#
# Unit tests for the cwd + exit segments and the CYML config loader.
# Each segment is a pure fn of its inputs (per ADR 0002), so the
# harness fabricates inputs and inspects the returned cstring directly.
# Config-loader tests write a temp config file under /tmp, load it, and
# inspect the resulting Config struct.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/fnptr.cyr"
include "lib/atomic.cyr"
include "lib/math.cyr"
include "lib/slice.cyr"
include "lib/bayan-cyml.cyr"
include "lib/bayan-toml.cyr"
include "lib/bayan-json.cyr"
include "lib/tagged.cyr"
include "lib/chrono.cyr"
include "lib/pwd.cyr"
include "lib/process.cyr"
include "lib/assert.cyr"
include "lib/args.cyr"
include "lib/cmdit.cyr"

# The same order as src/main.cyr. render.cyr brings in context, config and the segments.
include "src/pathlookup.cyr"
include "src/fslookup.cyr"
include "src/color.cyr"
include "src/cache.cyr"
include "src/cli.cyr"
include "src/shellout.cyr"
include "src/render.cyr"

fn _streq_or_dump(got, want, name): i64 {
    # A missing value must fail this assertion, not fault the whole run.
    if (got == 0) { assert_neq(got, 0, name); return 0; }
    if (streq(got, want) == 1) {
        assert(1, name);
    } else {
        assert(0, name);
        syscall(1, 2, "    got:  ", 10);
        syscall(1, 2, got, strlen(got));
        syscall(1, 2, "\n    want: ", 11);
        syscall(1, 2, want, strlen(want));
        syscall(1, 2, "\n", 1);
    }
    return 0;
}

# ---- exit segment ----

fn test_exit_zero_empty(): i64 {
    var out = exit_render(0);
    assert_eq(out, 0, "exit(0) renders empty");
    return 0;
}

fn test_exit_nonzero_brackets(): i64 {
    var out = exit_render(42);
    assert_neq(out, 0, "exit(42) not empty");
    _streq_or_dump(out, "[42]", "exit(42) == \"[42]\"");
    return 0;
}

fn test_exit_negative(): i64 {
    var out = exit_render(0 - 1);
    assert_neq(out, 0, "exit(-1) not empty");
    _streq_or_dump(out, "[-1]", "exit(-1) == \"[-1]\"");
    return 0;
}

# ---- cwd segment ----

fn test_cwd_no_home(): i64 {
    var out = cwd_render(0, 0);
    assert_neq(out, 0, "cwd_render(home=0) returns a path");
    assert_eq(load8(out), 47, "cwd_render(home=0) starts with '/'");
    return 0;
}

fn test_cwd_home_mismatch(): i64 {
    var out = cwd_render("/nonexistent/never/matches/this", 0);
    assert_neq(out, 0, "cwd_render(bad-home) returns a path");
    assert_eq(load8(out), 47, "cwd_render(bad-home) keeps absolute path");
    return 0;
}

fn test_cwd_home_prefix_exact(): i64 {
    var buf[4096];
    var n = syscall(SYS_GETCWD, &buf, 4096);
    if (n <= 2) { assert(1, "cwd_home_prefix_exact skipped (cwd too short)"); return 0; }
    n = n - 1;
    var fake = alloc(n + 1);
    memcpy(fake, &buf, n);
    store8(fake + n, 0);
    var out = cwd_render(fake, 0);
    _streq_or_dump(out, "~", "cwd_render(home==cwd) == \"~\"");
    return 0;
}

fn test_cwd_home_strict_prefix(): i64 {
    var buf[4096];
    var n = syscall(SYS_GETCWD, &buf, 4096);
    if (n <= 2) { assert(1, "cwd_home_strict_prefix skipped"); return 0; }
    n = n - 1;
    var sep = 0 - 1;
    var si = 0;
    while (si < n) {
        if (load8(&buf + si) == 47) { sep = si; }
        si = si + 1;
    }
    if (sep <= 0) { assert(1, "cwd_home_strict_prefix skipped (cwd is root)"); return 0; }
    var fake = alloc(sep + 1);
    memcpy(fake, &buf, sep);
    store8(fake + sep, 0);
    var out = cwd_render(fake, 0);
    assert_neq(out, 0, "cwd_render(home==parent) not empty");
    assert_eq(load8(out), 126, "cwd_render(home==parent) starts '~'");
    assert_eq(load8(out + 1), 47, "cwd_render(home==parent) byte 1 == '/'");
    return 0;
}

# max_length truncation — driven by the pure _truncate_cwd helper so
# we can assert exact bytes without depending on the test process's
# actual cwd length.

fn test_truncate_cwd_no_op_zero(): i64 {
    var p = "/home/user/Repos/commandress";
    var out = _truncate_cwd(p, strlen(p), 0);
    assert_eq(out, p, "max_length=0 returns input unchanged");
    return 0;
}

fn test_truncate_cwd_no_op_within_budget(): i64 {
    var p = "/short";
    var out = _truncate_cwd(p, strlen(p), 40);
    assert_eq(out, p, "path within budget returns input unchanged");
    return 0;
}

fn test_truncate_cwd_collapses_at_slash(): i64 {
    var p = "/home/macro/Repos/commandress/src";    # 33 bytes
    var out = _truncate_cwd(p, strlen(p), 20);
    # budget = 17. Earliest '/' with suffix <= 17 is at index 17 ('/'
    # before "commandress"). Result: "..." + "/commandress/src" = 19.
    _streq_or_dump(out, ".../commandress/src", "truncate(20) keeps suffix at '/' boundary");
    return 0;
}

fn test_truncate_cwd_exact_budget(): i64 {
    var p = "/a/bb/ccc/dddd";       # 14 bytes
    var out = _truncate_cwd(p, strlen(p), 14);
    assert_eq(out, p, "exact-length path returns unchanged");
    return 0;
}

fn test_truncate_cwd_keeps_only_leaf(): i64 {
    var p = "/home/user/Repos/very/deep/nested/project";   # 41 bytes
    var out = _truncate_cwd(p, strlen(p), 11);
    # budget = 8. Earliest '/' with suffix <= 8 is at index 33
    # ('/' before "project"). Result: "..." + "/project" = 11 bytes.
    _streq_or_dump(out, ".../project", "truncate(11) keeps just leaf");
    return 0;
}

fn test_truncate_cwd_pathologically_small(): i64 {
    var p = "/some/path";
    var out = _truncate_cwd(p, strlen(p), 3);
    _streq_or_dump(out, "...", "max_length=3 emits three dots");

    var out2 = _truncate_cwd(p, strlen(p), 1);
    _streq_or_dump(out2, ".", "max_length=1 emits one dot");
    return 0;
}

fn test_truncate_cwd_no_slash_fits_in_budget(): i64 {
    # A path with one early '/' and a long tail past budget — no
    # qualifying '/' exists, so we chop into the tail mid-component.
    var p = "/longComponentNameThatHasNoSlashes";   # 34 bytes
    var out = _truncate_cwd(p, strlen(p), 10);
    # budget = 7. Earliest '/' is at index 0; suffix len = 34 > 7.
    # No more '/'s. Fallback: "..." + last 7 bytes = ".." + "Slashes" → "...Slashes" (10).
    _streq_or_dump(out, "...Slashes", "fallback chops mid-component when no '/' fits");
    return 0;
}

fn test_truncate_cwd_via_render(): i64 {
    # Exercise the full cwd_render path with max_length set. Use a
    # bogus HOME so home-shorten is bypassed and we get the absolute
    # cwd, then truncate it. We don't assert the exact output (depends
    # on the runner's cwd length) — just that the returned cstring is
    # bounded by max_length.
    var out = cwd_render("/nonexistent/never/matches/this", 10);
    assert_neq(out, 0, "cwd_render(_, 10) returns non-null");
    var olen = strlen(out);
    var ok = 0;
    if (olen <= 10) { ok = 1; }
    assert(ok, "cwd_render with max_length=10 bounded under 10 bytes");
    return 0;
}

# ---- config loader ----

fn test_config_defaults(): i64 {
    var c = config_default();
    assert_neq(c, 0, "config_default() returns non-null");
    _streq_or_dump(cfg_separator(c), " ", "default separator == \" \"");
    _streq_or_dump(cfg_trailer(c), " $ ", "default trailer == \" $ \"");
    assert_eq(cfg_cwd_home_shorten(c), 1, "default cwd_home_shorten == 1");
    assert_eq(cfg_exit_hide_zero(c), 1, "default exit_hide_zero == 1");
    var segs = cfg_segments(c);
    assert_eq(vec_len(segs), 3, "default segments length == 3");
    _streq_or_dump(vec_get(segs, 0), "cwd",  "default segments[0] == \"cwd\"");
    _streq_or_dump(vec_get(segs, 1), "vcs",  "default segments[1] == \"vcs\" (M6: cache makes default-on)");
    _streq_or_dump(vec_get(segs, 2), "exit", "default segments[2] == \"exit\"");
    return 0;
}

fn test_config_load_missing_returns_defaults(): i64 {
    var c = config_load("/nonexistent/path/.commandress.cyml");
    assert_neq(c, 0, "config_load(missing) returns non-null");
    _streq_or_dump(cfg_separator(c), " ", "config_load(missing) separator == default");
    assert_eq(cfg_cwd_home_shorten(c), 1, "config_load(missing) cwd_home_shorten == default");
    return 0;
}

fn test_config_load_null_path_returns_defaults(): i64 {
    var c = config_load(0);
    assert_neq(c, 0, "config_load(0) returns non-null");
    _streq_or_dump(cfg_trailer(c), " $ ", "config_load(0) trailer == default");
    return 0;
}

# Write `content` to /tmp/cmdrs-test-<name>.cyml and return the path
# (heap-allocated). Tests use unique names so they can run in any order
# without interfering.
fn _write_test_config(name, content): i64 {
    var path = alloc(64);
    memcpy(path, "/tmp/cmdrs-test-", 16);
    var nlen = strlen(name);
    memcpy(path + 16, name, nlen);
    memcpy(path + 16 + nlen, ".cyml", 5);
    store8(path + 16 + nlen + 5, 0);
    var clen = strlen(content);
    file_write_all(path, content, clen);
    return path;
}

# Doc sweep 2026-08-26: single-bracket `[section]` config ALREADY WORKS, and
# nothing said so.
#
# `src/config.cyr`'s header explained the `[[X]]` schema as a workaround —
# "the stdlib's `toml_parse` recognises array-of-tables but not single-bracket
# `[name]`. Treat `[[X]]` as our spelling of `[X]` for now" — and
# `rustup_env.cyr` deferred `rust-toolchain.toml` to the same gap (Cyrius
# papercut Item 3). Tested against the 6.5.35 stdlib: `toml_get_sections` finds
# a single-bracket `[toolchain]` section, and the loader below reads a
# single-bracket `[prompt]` end to end. The limitation is gone; the comments
# outlived it.
#
# `[[X]]` stays the documented canonical spelling — every shipped theme and
# example uses it, and changing that would churn every user's config for no
# gain. This test pins the fact that `[X]` ALSO works, so the now-accurate
# documentation of it cannot silently regress.
fn test_config_accepts_single_bracket_sections(): i64 {
    var content = "[prompt]\nsegments = [\"exit\"]\ntrailer = \" > \"\n\n[segments.exit]\nhide_zero = false\n";
    var path = _write_test_config("singlebracket", content);
    var c = config_load(path);
    _streq_or_dump(cfg_trailer(c), " > ", "single-bracket [prompt] trailer applies");
    assert_eq(cfg_exit_hide_zero(c), 0, "single-bracket [segments.exit] applies");
    var segs = cfg_segments(c);
    assert_eq(vec_len(segs), 1, "single-bracket [prompt] segments applies");
    _streq_or_dump(vec_get(segs, 0), "exit", "single-bracket segments[0] == \"exit\"");
    syscall(SYS_UNLINK, path);
    return 0;
}

# ---- config parsing through bayan (ADR 0009) ----
# The first group is defects the forked `lib/toml.cyr` had, each reproduced against
# the real binary before the swap. The second is rules the loader has to keep across
# it: bayan changes the parser's output in ways a plain swap would have leaked out.

fn test_config_bool_with_inline_comment(): i64 {
    var content = "[[segments.exit]]\nhide_zero = false # always show it\n";
    var path = _write_test_config("inlinecmt", content);
    var c = config_load(path);
    assert_eq(cfg_exit_hide_zero(c), 0, "a trailing comment does not defeat a bool");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_crlf_bool(): i64 {
    var content = "[[segments.exit]]\r\nhide_zero = false\r\n";
    var path = _write_test_config("crlfbool", content);
    var c = config_load(path);
    assert_eq(cfg_exit_hide_zero(c), 0, "a CRLF line ending does not defeat a bool");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_crlf_divider(): i64 {
    var content = "[[prompt]]\r\ntrailer = \"> \"\r\n---\r\n[[segments.exit]]\r\nhide_zero = false\r\n";
    var path = _write_test_config("crlfdiv", content);
    var c = config_load(path);
    _streq_or_dump(cfg_trailer(c), "> ", "the header above a CRLF --- divider is read");
    assert_eq(cfg_exit_hide_zero(c), 1, "notes below a CRLF --- divider are not read as config");
    syscall(SYS_UNLINK, path);
    return 0;
}

# Audit 2026-11-06, O-1. A render uses a few KB, and with THP set to `always` the
# first heap touch made the kernel zero a whole 2 MB page. PR_GET_THP_DISABLE is 42.
fn test_thp_opt_out(): i64 {
    thp_opt_out();
    var got = syscall(SYS_PRCTL, 42, 0, 0, 0, 0);
    if (got >= 0) { assert_eq(got, 1, "the process has opted out of transparent huge pages"); }
    return 0;
}

# Build a config of exactly `size` bytes: a trailer, then comment padding.
fn _sized_config(size): i64 {
    var head = "[[prompt]]\ntrailer = \"AA> \"\n";
    var hlen = strlen(head);
    var buf = alloc(size + 1);
    memcpy(buf, head, hlen);
    var i = hlen;
    while (i < size) { store8(buf + i, 35); i = i + 1; }
    store8(buf + size, 0);
    return buf;
}

# Audit 2026-11-06, D-03. A file past the cap used to be cut at the cap and parsed, so
# the keys after the cut vanished with no warning, and a cut inside a string blanked
# that value. A half-read config is worse than none, so it is all or nothing.
fn test_config_over_cap_falls_back_to_defaults(): i64 {
    var path = _write_test_config("overcap", _sized_config(CONFIG_CAP + 1));
    _streq_or_dump(cfg_trailer(config_load(path)), " $ ", "a config past the cap is not half-read");
    syscall(SYS_UNLINK, path);
    return 0;
}

fn test_config_at_cap_still_loads(): i64 {
    var path = _write_test_config("atcap", _sized_config(CONFIG_CAP));
    _streq_or_dump(cfg_trailer(config_load(path)), "AA> ", "a config of exactly the cap still loads");
    syscall(SYS_UNLINK, path);
    return 0;
}

# 1.2.2: the key was a 32-bit djb2, where these two sibling names always collide
# (33 * 'a' + 'z' == 33 * 'b' + 'Y') and one directory showed the other's branch.
fn test_cache_key_separates_djb2_collisions(): i64 {
    assert_eq(streq(_cache_key_hex("/p/az"), _cache_key_hex("/p/bY")), 0, "az and bY get separate keys");
    assert_eq(streq(_cache_key_hex("/p/Ez"), _cache_key_hex("/p/FY")), 0, "Ez and FY get separate keys");
    return 0;
}

# Published FNV-1a 64 test vectors, so the hash cannot be subtly wrong.
fn test_cache_key_is_fnv1a64(): i64 {
    _streq_or_dump(_cache_key_hex("a"), "af63dc4c8601ec8c", "FNV-1a 64 of 'a'");
    _streq_or_dump(_cache_key_hex("foobar"), "85944171f73967e8", "FNV-1a 64 of 'foobar'");
    _streq_or_dump(_cache_key_hex(""), "cbf29ce484222325", "the offset basis for empty input");
    return 0;
}

# Audit 2026-11-06, eviction. A file name is one of 256 slots, so the directory cannot
# grow past 256 entries per segment however many directories the user visits.
fn test_cache_path_is_a_bounded_slot(): i64 {
    var dir_len = strlen(cache_dir());
    assert_eq(strlen(_cache_path("s", "a")), dir_len + 1 + 1 + 1 + 2, "a slot is two hex digits");
    _streq_or_dump(_cache_path("s", "a") + dir_len + 3, "8c", "the slot is the low byte of the key");
    return 0;
}

# Two directories in one slot: each write replaces the other, and neither ever reads
# the other's value. The key inside the entry is what keeps 1.2.2's fix.
fn test_cache_slot_collision_is_a_miss(): i64 {
    cache_init();
    var first = "/slot/0";
    var other = 0;
    var name = alloc(32);
    var i = 1;
    while (other == 0) {
        memcpy(name, "/slot/", 6);
        var nlen = fmt_int_buf(i, name + 6);
        store8(name + 6 + nlen, 0);
        if (streq(_cache_path("tst_slot", first), _cache_path("tst_slot", name)) == 1) { other = name; }
        i = i + 1;
    }
    cache_put("tst_slot", first, "ONE", 3);
    assert_eq(cache_get("tst_slot", other, 1), 0, "a slot neighbour does not read this value");
    cache_put("tst_slot", other, "TWO", 3);
    assert_eq(cache_get("tst_slot", first, 1), 0, "a slot neighbour replaced the entry");
    _streq_or_dump(cache_get("tst_slot", other, 1), "TWO", "the latest writer reads its value");
    syscall(SYS_UNLINK, _cache_path("tst_slot", first));
    return 0;
}

# A FIFO at an entry used to hang: the open blocked. The test stalls here if it does.
fn test_cache_fifo_entry_does_not_hang(): i64 {
    cache_init();
    var path = _cache_path("tst_fifo", "/cwd/fifo");
    syscall(SYS_UNLINK, path);
    assert_eq(syscall(SYS_MKNODAT, 0 - 100, path, 0x1180, 0), 0, "mkfifo fixture");
    assert_eq(cache_get("tst_fifo", "/cwd/fifo", 60), 0, "a FIFO is a miss");
    syscall(SYS_UNLINK, path);
    return 0;
}

# Audit 2026-08-26, A-12. An mtime in the future counts as a miss, or a backwards clock
# step would pin the entry for the life of the file. That audit checked this by hand and
# left no test. Mutation testing in 2026-11-06 found the gap.
fn test_cache_future_mtime_is_a_miss(): i64 {
    cache_init();
    cache_put("tst_future", "/cwd/future", "x", 1);
    var path = _cache_path("tst_future", "/cwd/future");
    var times[32];
    store64(&times, 0);
    store64(&times + 8, 0);
    store64(&times + 16, clock_epoch_secs() + 3600);
    store64(&times + 24, 0);
    assert_eq(syscall(SYS_UTIMENSAT, 0 - 100, path, &times, 0), 0, "set a future mtime");
    assert_eq(cache_get("tst_future", "/cwd/future", 60), 0, "a future mtime is a miss");
    syscall(SYS_UNLINK, path);
    return 0;
}

# No real value is this long, so an entry this size is refused before it is allocated.
fn test_cache_oversized_entry_is_a_miss(): i64 {
    cache_init();
    var len = CACHE_ENTRY_MAX + 1;
    var big = alloc(len);
    memset(big, 65, len);
    memcpy(big, _cache_key_hex("/cwd/big"), CACHE_KEY_DIGITS);
    var path = _cache_path("tst_big", "/cwd/big");
    file_write_all(path, big, len);
    assert_eq(cache_get("tst_big", "/cwd/big", 60), 0, "an oversized entry is a miss");
    syscall(SYS_UNLINK, path);
    return 0;
}

# <path>.tmp.<pid>, the name cache_put gives its temp.
fn _cache_tmp_name(path): i64 {
    var plen = strlen(path);
    var out = alloc(plen + 32);
    memcpy(out, path, plen);
    memcpy(out + plen, ".tmp.", 5);
    var n = fmt_int_buf(syscall(SYS_GETPID), out + plen + 5);
    store8(out + plen + 5 + n, 0);
    return out;
}

# A rename that fails must not leave the temp behind. A directory at the entry fails it.
fn test_cache_failed_rename_leaves_no_temp(): i64 {
    cache_init();
    var path = _cache_path("tst_ren", "/cwd/ren");
    syscall(SYS_RMDIR, path);
    assert_eq(syscall(SYS_MKDIR, path, 0x1C0), 0, "directory fixture");
    cache_put("tst_ren", "/cwd/ren", "x", 1);
    assert_neq(syscall(SYS_ACCESS, _cache_tmp_name(path), 0), 0, "the temp is gone");
    syscall(SYS_RMDIR, path);
    return 0;
}

# `ulimit -f 0` used to kill the process with SIGXFSZ inside cache_put: the prompt was
# cut short and a temp was left behind on every redraw. Runs in a child, because the
# limit and the signal both belong to the process.
fn test_cache_put_survives_file_size_limit(): i64 {
    cache_init();
    var pid = sys_fork();
    if (pid == 0) {
        var lim[16];
        store64(&lim, 0);
        store64(&lim + 8, 0);
        syscall(160, 1, &lim);                          # setrlimit(RLIMIT_FSIZE)
        cache_put("tst_lim", "/cwd/lim", "x", 1);
        var path = _cache_path("tst_lim", "/cwd/lim");
        if (syscall(SYS_ACCESS, _cache_tmp_name(path), 0) == 0) { sys_exit(3); }
        sys_exit(0);
    }
    var status[8];
    sys_waitpid(pid, &status, 0);
    assert_eq(load32(&status), 0, "cache_put survives RLIMIT_FSIZE and leaves no temp");
    return 0;
}

# Audit 2026-11-06. SIGKILL is not synchronous: a child stuck on a wedged filesystem, or
# held by a ptracer, stays unreapable, and a blocking wait had no deadline at all.
fn test_shellout_reap_does_not_block(): i64 {
    var pid = sys_fork();
    if (pid == 0) {
        sleep_ms(500);
        sys_exit(0);
    }
    var start_ms = clock_now_ms();
    _shellout_reap(pid);
    var elapsed_ms = clock_now_ms() - start_ms;
    assert(elapsed_ms < 100, "reaping gives up rather than waiting for a live child");
    sys_kill(pid, SIGKILL);
    var status[8];
    sys_waitpid(pid, &status, 0);
    return 0;
}

fn _sh_argv(script): i64 {
    var argv = alloc(32);
    store64(argv, "/bin/sh");
    store64(argv + 8, "-c");
    store64(argv + 16, script);
    store64(argv + 24, 0);
    return argv;
}

# With stderr closed, /dev/null opens as fd 2, and the old dup2-then-close closed it
# again, so the child's next open became its stderr.
fn test_shellout_stderr_closed_at_exec(): i64 {
    var envp = alloc(8);
    store64(envp, 0);
    var saved = syscall(SYS_DUP, 2);
    syscall(SYS_CLOSE, 2);
    var buf[64];
    var n = shellout_capture("/bin/sh", _sh_argv("if [ -e /proc/self/fd/2 ]; then echo open; else echo closed; fi"), envp, 2000, &buf, 63);
    sys_dup2(saved, 2);
    syscall(SYS_CLOSE, saved);
    assert_eq(n, 5, "the child reports on its stderr");
    assert_eq(memeq(&buf, "open", 4), 1, "the child has a stderr");
    return 0;
}

# With stdin and stdout closed, the pipe's write end IS fd 1, and the old dup2-then-close
# closed the child's stdout, so nothing it printed reached us.
fn test_shellout_stdout_closed_at_exec(): i64 {
    var envp = alloc(8);
    store64(envp, 0);
    var saved0 = syscall(SYS_DUP, 0);
    var saved1 = syscall(SYS_DUP, 1);
    syscall(SYS_CLOSE, 0);
    syscall(SYS_CLOSE, 1);
    var buf[64];
    var n = shellout_capture("/bin/sh", _sh_argv("echo ok"), envp, 2000, &buf, 63);
    sys_dup2(saved0, 0);
    sys_dup2(saved1, 1);
    syscall(SYS_CLOSE, saved0);
    syscall(SYS_CLOSE, saved1);
    assert_eq(n, 3, "the child's stdout reaches the capture");
    return 0;
}

# A stop and continue interrupts epoll_wait with EINTR even with no handler installed.
# That read as a hard failure, and the empty result was then cached for the TTL.
fn test_shellout_survives_stop_and_continue(): i64 {
    var envp = alloc(8);
    store64(envp, 0);
    var me = syscall(SYS_GETPID);
    var helper = sys_fork();
    if (helper == 0) {
        sleep_ms(30);
        sys_kill(me, 19);                               # SIGSTOP
        sleep_ms(20);
        sys_kill(me, 18);                               # SIGCONT
        sys_exit(0);
    }
    var buf[64];
    var n = shellout_capture("/bin/sh", _sh_argv("sleep 0.2; echo ok"), envp, 2000, &buf, 63);
    var status[8];
    sys_waitpid(helper, &status, 0);
    assert_eq(n, 3, "the capture carries on after a stop and continue");
    return 0;
}

# A path 2,000 levels deep made the four env segments take 472 ms a redraw, because each
# access(2) re-walks the whole path. Past the cap the walk does not start.
fn test_find_ancestor_depth_cap(): i64 {
    _rustup_tree_clean();
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_rt_tst", 0x1FF), 0, "mkdir root");
    file_write_all("/tmp/cmdrs_rt_tst/.nvmrc", "20", 2);
    var p = alloc(2048);
    memcpy(p, "/tmp/cmdrs_rt_tst", 17);
    var n = 17;
    var d = 2;
    while (d < ANCESTOR_DEPTH_MAX) {
        store8(p + n, 47);
        store8(p + n + 1, 120);
        n = n + 2;
        d = d + 1;
    }
    store8(p + n, 0);
    assert_neq(find_ancestor_with(p, "/.nvmrc"), 0, "a path at the cap walks");
    store8(p + n, 47);
    store8(p + n + 1, 120);
    store8(p + n + 2, 0);
    assert_eq(find_ancestor_with(p, "/.nvmrc"), 0, "a path past the cap does not");
    syscall(SYS_UNLINK, "/tmp/cmdrs_rt_tst/.nvmrc");
    _rustup_tree_clean();
    return 0;
}

# The kernel can hand back `(unreachable)/...`, which is relative to the real cwd.
fn test_find_ancestor_refuses_relative_paths(): i64 {
    assert_eq(find_ancestor_with("tests", "/commandress.tcyr"), 0, "a relative start is not walked");
    return 0;
}

# rustup: exactly one line is the legacy format, anything else is TOML. The 1.2.2 sniff
# looked for a leading `[`, so a commented file printed itself as the channel.
fn test_rustup_env_comment_before_table(): i64 {
    _rustup_tree_clean();
    assert_eq(syscall(SYS_MKDIR, "/tmp/cmdrs_rt_tst", 0x1FF), 0, "mkdir root");
    _rustup_write("/tmp/cmdrs_rt_tst/rust-toolchain", "# pinned\n[toolchain]\nchannel = \"1.80\"\n");
    _streq_or_dump(rustup_env_for("/tmp/cmdrs_rt_tst"), "1.80", "a comment before the table is still TOML");
    _rustup_write("/tmp/cmdrs_rt_tst/rust-toolchain", "stable\nnightly\n");
    assert_eq(rustup_env_for("/tmp/cmdrs_rt_tst"), 0, "two lines are neither legacy nor TOML");
    _rustup_write("/tmp/cmdrs_rt_tst/rust-toolchain", "\n  1.75.0 \r\n\n");
    _streq_or_dump(rustup_env_for("/tmp/cmdrs_rt_tst"), "1.75.0", "blank lines around one line stay legacy");
    _rustup_tree_clean();
    return 0;
}

# A channel is a string. Anything else used to render as its source text.
fn test_rustup_env_channel_must_be_a_string(): i64 {
    assert_eq(rustup_env_parse_toml("[toolchain]\nchannel = 1\n", 23), 0, "a number is not a channel");
    assert_eq(rustup_env_parse_toml("[toolchain]\nchannel = true\n", 26), 0, "a bool is not a channel");
    assert_eq(rustup_env_parse_toml("[toolchain]\nchannel = [\"x\"]\n", 27), 0, "an array is not a channel");
    _streq_or_dump(rustup_env_parse_toml("[toolchain]\nchannel = 'x'\n", 25), "x", "a literal string is");
    return 0;
}

# Real `sit` lists an untracked name indented by two spaces, so a repo could add a file
# called this and hide its own dirty marker from a substring scan.
fn test_vcs_clean_message_is_a_whole_line(): i64 {
    var s = "On branch main\n\nUntracked files:\n  nothing to commit, working tree clean\n";
    _streq_or_dump(vcs_parse_render(s, strlen(s), "*"), "main*", "a file with that name does not read as clean");
    var c = "On branch main\n\nnothing to commit, working tree clean\n";
    _streq_or_dump(vcs_parse_render(c, strlen(c), "*"), "main", "the real message still does");
    var t = "On branch main\n\nnothing to commit, working tree clean, really\n";
    _streq_or_dump(vcs_parse_render(t, strlen(t), "*"), "main*", "it must be the whole line");
    return 0;
}

fn test_config_literal_strings(): i64 {
    var content = "[[prompt]]\nsegments = ['exit', 'cwd']\ntrailer = '> '\n[[segments.cwd]]\nfg = 'red'\n";
    var path = _write_test_config("literal", content);
    var c = config_load(path);
    _streq_or_dump(cfg_trailer(c), "> ", "a literal string loses its quotes");
    _streq_or_dump(cfg_sgr_cwd(c), "\x1b[31m", "a literal colour resolves");
    assert_eq(vec_len(cfg_segments(c)), 2, "literal array elements are read");
    _streq_or_dump(vec_get(cfg_segments(c), 0), "exit", "literal element is unquoted");
    syscall(SYS_UNLINK, path);
    return 0;
}

