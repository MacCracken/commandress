# commandress benchmarks — per-segment + full-prompt render time.
#
# Per architecture/001 the full-prompt budget is 5 ms cold start and the
# per-segment default is 500 µs. This file tracks both the leaf segment
# fns and the full `render_prompt(cfg, ctx)` pipeline as we layer in
# more segments.
#
# `render_prompt` writes to stdout. To keep bench output clean we dup
# fd 1 to /dev/null for the timed section and restore it before the
# report. The dup2 itself costs ~200 ns and is amortized across the
# batch.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/fnptr.cyr"
include "lib/cyml.cyr"
include "lib/toml.cyr"
include "lib/tagged.cyr"
include "lib/process.cyr"
include "lib/chrono.cyr"
include "lib/pwd.cyr"
include "lib/bench.cyr"

include "src/pathlookup.cyr"
include "src/fslookup.cyr"
include "src/shellout.cyr"
include "src/render.cyr"

var _saved_stdout = 0;

fn _silence_stdout(): i64 {
    _saved_stdout = syscall(SYS_DUP, STDOUT);
    var devnull = file_open("/dev/null", O_WRONLY, 0);
    if (devnull >= 0) { syscall(SYS_DUP2, devnull, STDOUT); syscall(SYS_CLOSE, devnull); }
    return 0;
}

fn _restore_stdout(): i64 {
    if (_saved_stdout > 0) {
        syscall(SYS_DUP2, _saved_stdout, STDOUT);
        syscall(SYS_CLOSE, _saved_stdout);
    }
    return 0;
}

# ---- segment-level micro-benchmarks ----

fn bench_cwd_segment(): i64 {
    var b = bench_new("cwd_render");
    var home = getenv("HOME");
    var rounds = 100;
    var batch = 1000;
    var ri = 0;
    while (ri < rounds) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < batch) {
            cwd_render(home);
            bi = bi + 1;
        }
        bench_batch_stop(b, batch);
        ri = ri + 1;
    }
    bench_report(b);
    return 0;
}

fn bench_exit_segment(): i64 {
    var b = bench_new("exit_render(nonzero)");
    var rounds = 100;
    var batch = 10000;
    var ri = 0;
    while (ri < rounds) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < batch) {
            exit_render(42);
            bi = bi + 1;
        }
        bench_batch_stop(b, batch);
        ri = ri + 1;
    }
    bench_report(b);
    return 0;
}

# ---- config-loader bench ----
# Defaults path only — file-loading bench can land once we have a known
# config file under tests/ (and a way to time the syscalls separately
# from the parse).

fn bench_config_default(): i64 {
    var b = bench_new("config_default");
    var rounds = 100;
    var batch = 1000;
    var ri = 0;
    while (ri < rounds) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < batch) {
            config_default();
            bi = bi + 1;
        }
        bench_batch_stop(b, batch);
        ri = ri + 1;
    }
    bench_report(b);
    return 0;
}

# Parser micro-benchmark — no fork, no exec, just the byte-scan.
fn bench_vcs_parser(): i64 {
    var b = bench_new("vcs_parse_render");
    var s = "On branch main\n\nUnstaged changes:\n  modified:  foo.txt\n";
    var slen = strlen(s);
    var rounds = 100;
    var batch = 10000;
    var ri = 0;
    while (ri < rounds) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < batch) {
            vcs_parse_render(s, slen, "*");
            bi = bi + 1;
        }
        bench_batch_stop(b, batch);
        ri = ri + 1;
    }
    bench_report(b);
    return 0;
}

# Full-segment bench — includes the fork+exec round-trip. Run inside
# the cyrius/commandress repo; if `sit` isn't on PATH or there's no
# sit repo above cwd, the segment renders empty (segment-empty is its
# own valid measurement — captures the find-on-path cost).
fn bench_vcs_segment(): i64 {
    var b = bench_new("vcs_render (fork+sit status)");
    _silence_stdout();
    var rounds = 20;
    var batch = 5;
    var ri = 0;
    while (ri < rounds) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < batch) {
            vcs_render("*");
            bi = bi + 1;
        }
        bench_batch_stop(b, batch);
        ri = ri + 1;
    }
    _restore_stdout();
    bench_report(b);
    return 0;
}

# Pure-parser bench for `cyrius --version` output. No fork, just the
# prefix-match + newline scan — should sit near vcs_parse_render's
# ~230 ns. Cheap baseline to catch parser regressions.
fn bench_cyrius_env_parser(): i64 {
    var b = bench_new("cyrius_env_parse_version");
    var s = "cyrius 5.11.63\nmanifest-pin: 5.11.63\n";
    var slen = strlen(s);
    var rounds = 100;
    var batch = 10000;
    var ri = 0;
    while (ri < rounds) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < batch) {
            cyrius_env_parse_version(s, slen);
            bi = bi + 1;
        }
        bench_batch_stop(b, batch);
        ri = ri + 1;
    }
    bench_report(b);
    return 0;
}

# Full-segment bench. The cwd-walk + VERSION-file read path (no shellout)
# — runs inside this project's tree so the segment always hits the file
# branch; the shellout fallback never fires. Captures the cost of
# getcwd + ancestor walk + open/read/trim on a real filesystem.
fn bench_cyrius_env_segment(): i64 {
    var b = bench_new("cyrius_env_render (file path)");
    var rounds = 50;
    var batch = 100;
    var ri = 0;
    while (ri < rounds) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < batch) {
            cyrius_env_render();
            bi = bi + 1;
        }
        bench_batch_stop(b, batch);
        ri = ri + 1;
    }
    bench_report(b);
    return 0;
}

# ---- full-prompt benchmark ----

fn bench_prompt(): i64 {
    var b = bench_new("render_prompt (cwd+exit)");
    var cfg = config_default();
    var ctx = context_new(getenv("HOME"), 1);
    _silence_stdout();
    var rounds = 50;
    var batch = 500;
    var ri = 0;
    while (ri < rounds) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < batch) {
            render_prompt(cfg, ctx);
            bi = bi + 1;
        }
        bench_batch_stop(b, batch);
        ri = ri + 1;
    }
    _restore_stdout();
    bench_report(b);
    return 0;
}

fn main(): i64 {
    alloc_init();
    println("=== commandress benchmarks ===");
    bench_cwd_segment();
    bench_exit_segment();
    bench_config_default();
    bench_vcs_parser();
    bench_vcs_segment();
    bench_cyrius_env_parser();
    bench_cyrius_env_segment();
    bench_prompt();
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
