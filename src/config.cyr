# config.cyr — CYML config loader for ~/.commandress.
#
# Schema (TOML in the header zone of a CYML file — sub-tables use the
# `[[name]]` form because the stdlib's `toml_parse` recognises array-of-
# tables but not single-bracket `[name]`. Treat `[[X]]` as our spelling
# of `[X]` for now; single-bracket support is a stdlib follow-up):
#
#   [[prompt]]
#   segments  = ["cwd", "exit"]
#   separator = " "
#   trailer   = "$ "
#
#   [[segments.cwd]]
#   home_shorten = true
#   fg    = "cyan"          # named color or "default"; v0.6.0 named-only
#   bg    = "default"
#   style = "bold"          # space-separated: bold | italic | underline | reverse
#
#   [[segments.exit]]
#   hide_zero = true
#   fg = "red"
#   style = "bold"
#
#   [[segments.vcs]]
#   show_dirty   = true
#   dirty_marker = "*"
#   fg = "yellow"
#
#   [[segments.<env_segment>]]            # cyrius_env / python_env / node_env / rustup_env
#   fg = "..."                            # color-only knobs for the env segments
#
#   [[palette]]
#   primary = "cyan"                      # define named slots that segments can reference
#   accent  = "magenta"
#
#   [[segments.cwd]]
#   fg = "palette:primary"                # `palette:<name>` resolves at config-load time
#
#   ---
#   The body zone (after `---`) is ignored; reserved for user notes.
#
# Missing file → all defaults. Missing field → that field's default. A
# segment section that touches *any* of fg/bg/style is a complete style
# override for that segment (missing color fields default to absent,
# not the default theme's value). A section with no color fields keeps
# the default theme intact — important for boolean-only overrides.
# Unknown fields warn to stderr but don't fail (allow-list is the
# validation gate; see _warn_unknown_pairs).

var CFG_SEGMENTS = 0;
var CFG_SEPARATOR = 8;
var CFG_TRAILER = 16;
var CFG_CWD_HOME_SHORTEN = 24;
var CFG_EXIT_HIDE_ZERO = 32;
var CFG_VCS_SHOW_DIRTY = 40;
var CFG_VCS_DIRTY_MARKER = 48;
var CFG_TIME_FORMAT = 56;
var CFG_SGR_CWD = 64;
var CFG_SGR_EXIT = 72;
var CFG_SGR_VCS = 80;
var CFG_SGR_TIME = 88;
var CFG_SGR_HOSTNAME = 96;
var CFG_SGR_USER = 104;
var CFG_SGR_CYRIUS_ENV = 112;
var CFG_SGR_PYTHON_ENV = 120;
var CFG_SGR_NODE_ENV = 128;
var CFG_SGR_RUSTUP_ENV = 136;
var CFG_CWD_MAX_LENGTH = 144;
var CFG_SIZE = 152;

fn cfg_segments(c): i64           { return load64(c + CFG_SEGMENTS); }
fn cfg_separator(c): i64          { return load64(c + CFG_SEPARATOR); }
fn cfg_trailer(c): i64            { return load64(c + CFG_TRAILER); }
fn cfg_cwd_home_shorten(c): i64   { return load64(c + CFG_CWD_HOME_SHORTEN); }
fn cfg_exit_hide_zero(c): i64     { return load64(c + CFG_EXIT_HIDE_ZERO); }
fn cfg_vcs_show_dirty(c): i64     { return load64(c + CFG_VCS_SHOW_DIRTY); }
fn cfg_vcs_dirty_marker(c): i64   { return load64(c + CFG_VCS_DIRTY_MARKER); }
fn cfg_time_format(c): i64        { return load64(c + CFG_TIME_FORMAT); }
fn cfg_sgr_cwd(c): i64            { return load64(c + CFG_SGR_CWD); }
fn cfg_sgr_exit(c): i64           { return load64(c + CFG_SGR_EXIT); }
fn cfg_sgr_vcs(c): i64            { return load64(c + CFG_SGR_VCS); }
fn cfg_sgr_time(c): i64           { return load64(c + CFG_SGR_TIME); }
fn cfg_sgr_hostname(c): i64       { return load64(c + CFG_SGR_HOSTNAME); }
fn cfg_sgr_user(c): i64           { return load64(c + CFG_SGR_USER); }
fn cfg_sgr_cyrius_env(c): i64     { return load64(c + CFG_SGR_CYRIUS_ENV); }
fn cfg_sgr_python_env(c): i64     { return load64(c + CFG_SGR_PYTHON_ENV); }
fn cfg_sgr_node_env(c): i64       { return load64(c + CFG_SGR_NODE_ENV); }
fn cfg_sgr_rustup_env(c): i64     { return load64(c + CFG_SGR_RUSTUP_ENV); }
fn cfg_cwd_max_length(c): i64     { return load64(c + CFG_CWD_MAX_LENGTH); }

# Build the default Config. Used when no file is present, and as the
# base for partial overrides — a config that sets only `separator`
# inherits every other default.
fn config_default(): i64 {
    var c = alloc(CFG_SIZE);
    var segs = vec_new();
    vec_push(segs, "cwd");
    vec_push(segs, "exit");
    store64(c + CFG_SEGMENTS, segs);
    store64(c + CFG_SEPARATOR, " ");
    # Leading space in the trailer matches the v0.1.0 output shape
    # (`<segments> $ `). Users overriding the trailer in their config
    # are responsible for any surrounding spacing they want.
    store64(c + CFG_TRAILER, " $ ");
    store64(c + CFG_CWD_HOME_SHORTEN, 1);
    store64(c + CFG_EXIT_HIDE_ZERO, 1);
    store64(c + CFG_VCS_SHOW_DIRTY, 1);
    store64(c + CFG_VCS_DIRTY_MARKER, "*");
    store64(c + CFG_TIME_FORMAT, "%H:%M");

    # Opinionated default theme. Per-segment color choices follow the
    # principle "each segment paints in a colour that matches the thing
    # it represents" — directory cyan-bold, errors red-bold, time dim,
    # env segments in their language's conventional colour. Users opt
    # back to plain via `fg = "default"` (or any color override) in
    # their `~/.commandress`. Out-of-box look beats "make it
    # bearable" — starship-equivalent themability lands later (palette
    # layer in v0.6.x, theme files in v0.8.0).
    store64(c + CFG_SGR_CWD,        sgr_open_for("cyan",         0, "bold"));
    store64(c + CFG_SGR_EXIT,       sgr_open_for("red",          0, "bold"));
    store64(c + CFG_SGR_VCS,        sgr_open_for("yellow",       0, 0));
    store64(c + CFG_SGR_TIME,       sgr_open_for("bright_black", 0, 0));
    store64(c + CFG_SGR_HOSTNAME,   sgr_open_for("blue",         0, 0));
    store64(c + CFG_SGR_USER,       sgr_open_for("green",        0, "bold"));
    store64(c + CFG_SGR_CYRIUS_ENV, sgr_open_for("magenta",      0, 0));
    store64(c + CFG_SGR_PYTHON_ENV, sgr_open_for("yellow",       0, 0));
    store64(c + CFG_SGR_NODE_ENV,   sgr_open_for("green",        0, 0));
    store64(c + CFG_SGR_RUSTUP_ENV, sgr_open_for("red",          0, 0));
    # 0 = no truncation. Users opt in via `[[segments.cwd]] max_length = N`.
    store64(c + CFG_CWD_MAX_LENGTH, 0);
    return c;
}

# Parse a TOML-style bool ("true"/"false") or numeric flag ("1"/"0").
# Returns `dflt` on null or any other value (don't fail loud over
# typos — the per-field allow-list catches genuine mistakes elsewhere).
fn _parse_bool(s, dflt): i64 {
    if (s == 0) { return dflt; }
    if (str_eq_cstr(s, "true") == 1) { return 1; }
    if (str_eq_cstr(s, "false") == 1) { return 0; }
    if (str_eq_cstr(s, "1") == 1) { return 1; }
    if (str_eq_cstr(s, "0") == 1) { return 0; }
    return dflt;
}

# Parse a TOML array literal — `["a", "b"]` — into a vec of heap-
# allocated NUL-terminated cstrings. Empty / malformed input returns
# an empty vec.
fn _parse_str_array(s): i64 {
    var out = vec_new();
    if (s == 0) { return out; }
    var data = str_data(s);
    var slen = str_len(s);
    var i = 0;
    while (i < slen) {
        var c = load8(data + i);
        if (c == 34) {
            i = i + 1;
            var start = i;
            var seek = 1;
            while (seek == 1) {
                if (i >= slen) { seek = 0; }
                else { if (load8(data + i) == 34) { seek = 0; } else { i = i + 1; } }
            }
            var slen2 = i - start;
            var cstr = alloc(slen2 + 1);
            if (slen2 > 0) { memcpy(cstr, data + start, slen2); }
            store8(cstr + slen2, 0);
            vec_push(out, cstr);
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return out;
}

# Look up `name` in a palette table (flat vec of alternating
# cstrings: [k0, v0, k1, v1, ...]). Returns the value cstring or 0
# when the name isn't bound. Linear scan — palettes are small (~10
# entries in practice); a hashmap would be over-engineering.
fn _palette_lookup(palette, name): i64 {
    if (palette == 0) { return 0; }
    if (name == 0) { return 0; }
    var pn = vec_len(palette);
    var pi = 0;
    while (pi + 1 < pn) {
        if (streq(vec_get(palette, pi), name) == 1) {
            return vec_get(palette, pi + 1);
        }
        pi = pi + 2;
    }
    return 0;
}

# Resolve a color value cstring through the palette. Values that begin
# with `palette:` are looked up; the prefix is stripped and the
# remainder used as the slot name. An unknown name resolves to 0 (no
# code emitted — same path as "default") so users get muted output
# instead of a crash on a typo.
fn _resolve_color_value(value, palette): i64 {
    if (value == 0) { return 0; }
    var prefix = "palette:";
    var prefix_len = strlen(prefix);
    var vlen = strlen(value);
    if (vlen <= prefix_len) { return value; }
    if (memeq(value, prefix, prefix_len) == 0) { return value; }
    return _palette_lookup(palette, value + prefix_len);
}

# Overwrite the SGR slot at `c + offset` from this section's `fg` / `bg`
# / `style` pairs, but ONLY if at least one of those keys is present.
# Sections with no color fields leave the default-theme SGR intact —
# important so boolean-only overrides (e.g. `home_shorten = false`)
# don't accidentally strip the cwd's default cyan-bold. `palette` is
# the table parsed from the optional [[palette]] section (or 0).
fn _apply_seg_style(c, offset, pairs, palette): i64 {
    var fg_v = toml_get(pairs, "fg");
    var bg_v = toml_get(pairs, "bg");
    var style_v = toml_get(pairs, "style");
    if (fg_v == 0) {
        if (bg_v == 0) {
            if (style_v == 0) { return 0; }
        }
    }
    var fg = 0;
    var bg = 0;
    var style = 0;
    if (fg_v != 0)    { fg = _resolve_color_value(str_cstr(fg_v), palette); }
    if (bg_v != 0)    { bg = _resolve_color_value(str_cstr(bg_v), palette); }
    if (style_v != 0) { style = str_cstr(style_v); }
    store64(c + offset, sgr_open_for(fg, bg, style));
    return 0;
}

# Emit a stderr warning for any key in `pairs` not on `allowed`.
# `allowed` is a NUL-terminated vec-of-cstrings; section_name is the
# `[[name]]` we're scoped to.
fn _warn_unknown_pairs(pairs, allowed, section_name): i64 {
    var pn = vec_len(pairs);
    var pi = 0;
    while (pi < pn) {
        var p = vec_get(pairs, pi);
        var key = toml_pair_key(p);
        var known = 0;
        var ai = 0;
        var an = vec_len(allowed);
        while (ai < an) {
            if (str_eq_cstr(key, vec_get(allowed, ai)) == 1) { known = 1; }
            ai = ai + 1;
        }
        if (known == 0) {
            syscall(SYS_WRITE, STDERR, "warning: unknown config field '", 31);
            syscall(SYS_WRITE, STDERR, str_data(key), str_len(key));
            syscall(SYS_WRITE, STDERR, "' in [[", 7);
            syscall(SYS_WRITE, STDERR, section_name, strlen(section_name));
            syscall(SYS_WRITE, STDERR, "]] (ignored)\n", 13);
        }
        pi = pi + 1;
    }
    return 0;
}

# Helper for segments whose [[segments.X]] block carries ONLY color
# knobs (no booleans / strings of its own). Loads, allow-lists fg/bg/
# style, applies. Used by hostname / user / the four env segments —
# all introduced as configurable-only-for-color sections in v0.6.0.
fn _load_color_only_section(c, sgr_offset, sections, name, palette): i64 {
    var secs = toml_get_sections(sections, name);
    if (vec_len(secs) == 0) { return 0; }
    var sec = vec_get(secs, 0);
    var pairs = toml_section_pairs(sec);
    var allowed = vec_new();
    vec_push(allowed, "fg");
    vec_push(allowed, "bg");
    vec_push(allowed, "style");
    _warn_unknown_pairs(pairs, allowed, name);
    _apply_seg_style(c, sgr_offset, pairs, palette);
    return 0;
}

# Load the [[palette]] section into a flat alternating-cstring vec.
# Returns an empty vec when the section is absent so callers can pass
# it through `_resolve_color_value` without a null check.
fn _load_palette(sections): i64 {
    var p = vec_new();
    var secs = toml_get_sections(sections, "palette");
    if (vec_len(secs) == 0) { return p; }
    var sec = vec_get(secs, 0);
    var pairs = toml_section_pairs(sec);
    var pn = vec_len(pairs);
    var pi = 0;
    while (pi < pn) {
        var pair = vec_get(pairs, pi);
        var key = toml_pair_key(pair);
        var val = toml_pair_value(pair);

        # Promote key from a `str` (data+len, possibly unterminated)
        # into an owned NUL-terminated cstring so streq lookups work.
        var klen = str_len(key);
        var kcs = alloc(klen + 1);
        if (klen > 0) { memcpy(kcs, str_data(key), klen); }
        store8(kcs + klen, 0);
        vec_push(p, kcs);
        vec_push(p, str_cstr(val));
        pi = pi + 1;
    }
    return p;
}

# Load config from `path`. On read failure (file missing / unreadable)
# returns defaults silently — a missing config file is the normal case,
# not an error. Parse failures fall back to defaults for the offending
# section but keep already-applied overrides.
fn config_load(path): i64 {
    var c = config_default();
    if (path == 0) { return c; }

    var buf = alloc(65536);
    var n = file_read_all(path, buf, 65536);
    if (n <= 0) { return c; }

    var doc = cyml_parse(buf, n);
    var hdr = cyml_doc_header(doc);
    var hlen = cyml_doc_header_len(doc);
    if (hlen == 0) { return c; }

    var sections = toml_parse(str_new(hdr, hlen));

    # [[palette]] — optional named-slot table parsed first so every
    # segment block below can resolve `palette:<name>` references in
    # its fg/bg fields. Absent → empty vec (resolution falls through
    # to "no code emitted" on any palette ref it can't bind).
    var palette = _load_palette(sections);

    # [[prompt]] — segment order + separator + trailer.
    var prompt_secs = toml_get_sections(sections, "prompt");
    if (vec_len(prompt_secs) > 0) {
        var prompt = vec_get(prompt_secs, 0);
        var prompt_pairs = toml_section_pairs(prompt);

        var prompt_allowed = vec_new();
        vec_push(prompt_allowed, "segments");
        vec_push(prompt_allowed, "separator");
        vec_push(prompt_allowed, "trailer");
        _warn_unknown_pairs(prompt_pairs, prompt_allowed, "prompt");

        var sep_v = toml_get(prompt_pairs, "separator");
        if (sep_v != 0) { store64(c + CFG_SEPARATOR, str_cstr(sep_v)); }

        var trail_v = toml_get(prompt_pairs, "trailer");
        if (trail_v != 0) { store64(c + CFG_TRAILER, str_cstr(trail_v)); }

        var segs_v = toml_get(prompt_pairs, "segments");
        if (segs_v != 0) {
            var parsed = _parse_str_array(segs_v);
            if (vec_len(parsed) > 0) { store64(c + CFG_SEGMENTS, parsed); }
        }
    }

    # [[segments.cwd]] — cwd-segment options.
    var cwd_secs = toml_get_sections(sections, "segments.cwd");
    if (vec_len(cwd_secs) > 0) {
        var cwd = vec_get(cwd_secs, 0);
        var cwd_pairs = toml_section_pairs(cwd);

        var cwd_allowed = vec_new();
        vec_push(cwd_allowed, "home_shorten");
        vec_push(cwd_allowed, "max_length");
        vec_push(cwd_allowed, "fg");
        vec_push(cwd_allowed, "bg");
        vec_push(cwd_allowed, "style");
        _warn_unknown_pairs(cwd_pairs, cwd_allowed, "segments.cwd");

        var hs_v = toml_get(cwd_pairs, "home_shorten");
        store64(c + CFG_CWD_HOME_SHORTEN, _parse_bool(hs_v, cfg_cwd_home_shorten(c)));

        var ml_v = toml_get(cwd_pairs, "max_length");
        if (ml_v != 0) { store64(c + CFG_CWD_MAX_LENGTH, atoi(str_cstr(ml_v))); }
        _apply_seg_style(c, CFG_SGR_CWD, cwd_pairs, palette);
    }

    # [[segments.exit]] — exit-segment options.
    var exit_secs = toml_get_sections(sections, "segments.exit");
    if (vec_len(exit_secs) > 0) {
        var exit = vec_get(exit_secs, 0);
        var exit_pairs = toml_section_pairs(exit);

        var exit_allowed = vec_new();
        vec_push(exit_allowed, "hide_zero");
        vec_push(exit_allowed, "fg");
        vec_push(exit_allowed, "bg");
        vec_push(exit_allowed, "style");
        _warn_unknown_pairs(exit_pairs, exit_allowed, "segments.exit");

        var hz_v = toml_get(exit_pairs, "hide_zero");
        store64(c + CFG_EXIT_HIDE_ZERO, _parse_bool(hz_v, cfg_exit_hide_zero(c)));
        _apply_seg_style(c, CFG_SGR_EXIT, exit_pairs, palette);
    }

    # [[segments.vcs]] — vcs-segment options.
    var vcs_secs = toml_get_sections(sections, "segments.vcs");
    if (vec_len(vcs_secs) > 0) {
        var vcs = vec_get(vcs_secs, 0);
        var vcs_pairs = toml_section_pairs(vcs);

        var vcs_allowed = vec_new();
        vec_push(vcs_allowed, "show_dirty");
        vec_push(vcs_allowed, "dirty_marker");
        vec_push(vcs_allowed, "fg");
        vec_push(vcs_allowed, "bg");
        vec_push(vcs_allowed, "style");
        _warn_unknown_pairs(vcs_pairs, vcs_allowed, "segments.vcs");

        var sd_v = toml_get(vcs_pairs, "show_dirty");
        store64(c + CFG_VCS_SHOW_DIRTY, _parse_bool(sd_v, cfg_vcs_show_dirty(c)));

        var dm_v = toml_get(vcs_pairs, "dirty_marker");
        if (dm_v != 0) { store64(c + CFG_VCS_DIRTY_MARKER, str_cstr(dm_v)); }
        _apply_seg_style(c, CFG_SGR_VCS, vcs_pairs, palette);
    }

    # [[segments.time]] — time-segment options.
    var time_secs = toml_get_sections(sections, "segments.time");
    if (vec_len(time_secs) > 0) {
        var time_sec = vec_get(time_secs, 0);
        var time_pairs = toml_section_pairs(time_sec);

        var time_allowed = vec_new();
        vec_push(time_allowed, "format");
        vec_push(time_allowed, "fg");
        vec_push(time_allowed, "bg");
        vec_push(time_allowed, "style");
        _warn_unknown_pairs(time_pairs, time_allowed, "segments.time");

        var fmt_v = toml_get(time_pairs, "format");
        if (fmt_v != 0) { store64(c + CFG_TIME_FORMAT, str_cstr(fmt_v)); }
        _apply_seg_style(c, CFG_SGR_TIME, time_pairs, palette);
    }

    # Color-only sections — segments with no non-color knobs of their
    # own. Each gets its [[segments.X]] block in v0.6.0 so users can
    # recolor without having to touch the dispatcher in code.
    _load_color_only_section(c, CFG_SGR_HOSTNAME,   sections, "segments.hostname",   palette);
    _load_color_only_section(c, CFG_SGR_USER,       sections, "segments.user",       palette);
    _load_color_only_section(c, CFG_SGR_CYRIUS_ENV, sections, "segments.cyrius_env", palette);
    _load_color_only_section(c, CFG_SGR_PYTHON_ENV, sections, "segments.python_env", palette);
    _load_color_only_section(c, CFG_SGR_NODE_ENV,   sections, "segments.node_env",   palette);
    _load_color_only_section(c, CFG_SGR_RUSTUP_ENV, sections, "segments.rustup_env", palette);

    return c;
}
