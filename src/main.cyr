# commandress — main entry point.
#
# Builds the prompt context (env vars, last exit code) and hands it to
# the render pipeline. One redraw per invocation; the shell invokes
# `cmdrs` fresh each prompt.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"

include "src/render.cyr"

fn main(): i64 {
    alloc_init();

    var home = getenv("HOME");
    var last_exit_str = getenv("AGNOSHI_LAST_EXIT");
    var last_exit = 0;
    if (last_exit_str != 0) { last_exit = atoi(last_exit_str); }

    render_prompt(home, last_exit);
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
