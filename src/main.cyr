# commandress — main entry point.
#
# Loads ~/.commandress (defaults baked in if absent), builds the
# per-invocation Context from env vars, and hands both to the render
# pipeline. One redraw per invocation; the shell invokes `cmdrs` fresh
# each prompt.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/fnptr.cyr"
include "lib/cyml.cyr"
include "lib/toml.cyr"
include "lib/tagged.cyr"
include "lib/chrono.cyr"
include "lib/pwd.cyr"
include "lib/process.cyr"
include "lib/args.cyr"
include "lib/cmdit.cyr"

include "src/pathlookup.cyr"
include "src/fslookup.cyr"
include "src/color.cyr"
include "src/cache.cyr"
include "src/cli.cyr"
include "src/shellout.cyr"
include "src/render.cyr"

# Build the default config-file path: `$HOME/.commandress`. Returns
# 0 when HOME is unset (caller falls back to baked-in defaults). The
# canonical name drops the `.cyml` extension to match the dotfile
# convention (`.bashrc`, `.zshrc`, `.gitconfig`, ...) — see ADR 0006.
fn _default_config_path(home): i64 {
    if (home == 0) { return 0; }
    var hlen = strlen(home);
    var suffix = "/.commandress";
    var suflen = strlen(suffix);
    var path = alloc(hlen + suflen + 1);
    memcpy(path, home, hlen);
    memcpy(path + hlen, suffix, suflen);
    store8(path + hlen + suflen, 0);
    return path;
}

# Our own stderr writer.
#
# Audit 2026-08-26, P-08: this used to call cmdit's `_cmdit_eprint`. That is an
# underscore-prefixed INTERNAL helper, not one of the 54 public `cmdit_*`
# entry points, so it sits outside the frozen-1.0.0 API that ADR 0008's
# tag pin is predicated on. cmdit is free to rename or drop it in a patch
# release without that counting as a break — and our build would fail on a
# routine pin bump, for a two-line helper we can own outright.
fn _eprint(s): i64 {
    if (s == 0) { return 0; }
    syscall(SYS_WRITE, STDERR, s, strlen(s));
    return 0;
}

# Usage banner. cmdit_help generates `Usage:` + the flag table from the
# registrations themselves, so the flag list cannot drift from the parser the
# way a hand-written help wall does. Everything printed here goes to STDERR,
# which is what makes `--help` safe in a prompt renderer: a shell doing
# `PROMPT="$(cmdrs --help)"` captures stdout and gets an empty string, not a
# help wall pasted into the prompt.
fn _print_help(cli): i64 {
    _eprint("commandress — structured prompt renderer for agnoshi.\n\n");
    cmdit_help(cli);
    _eprint("\nContext is taken from the environment, not from flags:\n");
    _eprint("  HOME                 config lookup (~/.commandress) + `~` shortening\n");
    _eprint("  AGNOSHI_LAST_EXIT    last command's exit status, for the `exit` segment\n");
    return 0;
}

fn main(): i64 {
    alloc_init();
    cache_init();

    # CLI parsing via cmdit (the [deps.cmdit] distlib) as of 1.1.5 — see ADR
    # 0008. The whole surface is one flag; the value of the swap is that
    # `--side`'s choice set is now validated by the parser rather than by a
    # byte-compare against the single string `--side=right`, and that --help /
    # --version (reserved by ADR 0007 and never delivered) come registered for
    # free and stay tied to the table.
    #
    # No explicit args_init() here any more: cmdit_argv calls it, and it is NOT
    # idempotent — it allocates ARG_MAX (2 MB) and re-reads /proc/self/cmdline
    # on every call, so calling it here as well would allocate 4 MB per prompt.
    # getenv is unaffected either way; it reads /proc/self/environ directly (and
    # the parked init rsp on agnos), never args_init's buffer.
    var side = 0;
    var cli = cmdit_new("cmdrs");

    # cmdit_new returns 0 only if the heap is exhausted, and cmdit_argv /
    # cmdit_parse / cmdit_enum do not guard a 0 handle (they would wild-read at
    # a small absolute address). Unreachable in practice — the three allocations
    # are compile-time constants well inside ALLOC_MAX — but a prompt renderer
    # that segfaults takes the user's shell prompt with it, so the one
    # comparison is worth it. On that path we render the default left prompt.
    if (cli != 0) {
        var f_side = cli_register(cli);
        var pr = cmdit_parse(cli);

        if (pr == CMDIT_HELP) {
            _print_help(cli);
            return CMDIT_EXIT_OK;
        }
        if (pr == CMDIT_VERSION) {
            return cmdit_version(cli, cmdrs_version());
        }

        # Diagnose on stderr, then fall through: `cli_side_for` maps any
        # non-clean parse to the left prompt rather than exiting non-zero, so a
        # typo never blanks the user's prompt. Policy + rationale in src/cli.cyr.
        if (pr == CMDIT_RESULT_ERR) {
            cmdit_print_error(cli);
        }
        side = cli_side_for(cli, f_side, pr);
    }

    var home = getenv("HOME");
    var last_exit = parse_last_exit(getenv("AGNOSHI_LAST_EXIT"));

    var cfg = config_load(_default_config_path(home));
    var ctx = context_new(home, last_exit);

    render_prompt(cfg, ctx, side);
    return CMDIT_EXIT_OK;
}

# Bare-call entry: on agnos a `var = main()` top-level runs main as a gvar-init
# BEFORE cyrius's init-rsp capture (6.1.14), so argc()/argv() read 0/null. A bare
# statement runs after the capture, so args resolve.
fn _agnos_entry(): i64 {
    var r = main();
    syscall(SYS_EXIT, r);
    return 0;
}
_agnos_entry();
