# fslookup.cyr — shared filesystem helpers for env-probe segments.
#
# Two utilities used by cyrius_env / python_env / node_env:
#
#   find_ancestor_with(start_dir, marker)
#       Walks `start_dir` upward and returns the nearest ancestor
#       directory in which `<dir><marker>` exists (per access(F_OK)),
#       or 0 when the walk reaches "/" without a hit. `marker` must
#       start with "/" (e.g. "/cyrius.cyml", "/.python-version",
#       "/.nvmrc") so the root-case join "/" + marker still produces a
#       valid path; POSIX collapses leading "//" to "/".
#
#   read_trimmed_file_at(root, suffix)
#       Reads `<root><suffix>` (e.g. "/VERSION", "/.python-version",
#       "/.nvmrc") and returns its trimmed contents as a heap-alloc'd
#       cstring, or 0 on missing / unreadable / whitespace-only files.
#       Trim covers space / tab / \n / \r at both ends. 256-byte fixed
#       read cap — pin files hold semver-shaped strings, not data.
#
# Both lifted from `src/segments/cyrius_env.cyr` and `python_env.cyr`
# in v0.5.0 once M4 produced three call sites apiece. Each segment's
# project-detection + version-file read now boils down to two lines.
#
# Allocation: returns are heap-alloc'd cstrings (no trailing slash on
# the dir form, except "/" itself which keeps its one slash). Caller
# owns; bump allocator reclaims at end of redraw.

enum ProbeFile {
    PROBE_FILE_CAP = 256;
    # Deepest start directory an ancestor walk will take. Each access(2) re-walks the
    # whole path, so the cost is quadratic in depth: a 2,043-level cwd took four env
    # segments 472 ms a redraw. At this depth they take about 3 ms. No project pins a
    # toolchain 128 levels up, so past it the segments render empty.
    ANCESTOR_DEPTH_MAX = 128;
}

# 1 if `<dir><marker>` exists. `path` holds `<dir>` in its first `cl` bytes and has
# room for the marker and a NUL after them.
fn _marker_exists(path, cl, marker, marker_len): i64 {
    memcpy(path + cl, marker, marker_len);
    store8(path + cl + marker_len, 0);
    # Existence check. AGNOS has no access(2); it has stat#33
    # (path, pathlen, statbuf) → 0 if the inode exists, and a real ext2 FS,
    # so marker detection (.git etc.) works natively. Linux uses access F_OK.
    #ifdef CYRIUS_TARGET_AGNOS
    var stbuf[48];
    if (syscall(SYS_STAT, path, cl + marker_len, &stbuf) == 0) { return 1; }
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (syscall(SYS_ACCESS, path, 0) == 0) { return 1; }        # F_OK
    #endif
    return 0;
}

# The nearest ancestor of `start_dir` holding `marker` or `marker2`, with `which` set
# to 1 or 2 for the one it found. In one directory `marker` wins. `marker2` may be 0.
# One walk, so a file found near the cwd stops the search for both names.
fn find_ancestor_with_either(start_dir, marker, marker2, which): i64 {
    store64(which, 0);
    if (start_dir == 0) { return 0; }
    if (marker == 0) { return 0; }
    var len = strlen(start_dir);
    if (len == 0) { return 0; }
    var marker_len = strlen(marker);
    if (marker_len == 0) { return 0; }

    # Absolute paths only. getcwd can return `(unreachable)/...`, and walking that
    # would probe paths relative to the real cwd.
    if (load8(start_dir) != 47) { return 0; }
    var depth = 0;
    var di = 0;
    while (di < len) {
        if (load8(start_dir + di) == 47) { depth = depth + 1; }
        di = di + 1;
    }
    if (depth > ANCESTOR_DEPTH_MAX) { return 0; }

    var marker2_len = 0;
    if (marker2 != 0) { marker2_len = strlen(marker2); }
    var room = marker_len;
    if (marker2_len > room) { room = marker2_len; }

    # Working copy of the starting dir, shortened as we walk. Each marker is written
    # after the current end, so one buffer serves every candidate path.
    var cur = alloc(len + room + 1);
    if (cur == 0) { return 0; }
    memcpy(cur, start_dir, len);
    var cl = len;

    # Strip trailing '/'s from the input, but never collapse the lone
    # root "/" — at cl == 1 we stop, so the loop bottoms out cleanly.
    var strip = 1;
    while (strip == 1) {
        if (cl <= 1) { strip = 0; }
        else { if (load8(cur + cl - 1) == 47) { cl = cl - 1; }
            else { strip = 0; }
        }
    }

    var hit = 0;
    var done = 0;
    while (done == 0) {
        var found = _marker_exists(cur, cl, marker, marker_len);
        if (found == 0) {
            if (marker2_len > 0) {
                if (_marker_exists(cur, cl, marker2, marker2_len) == 1) { found = 2; }
            }
        }
        if (found != 0) {
            var out = alloc(cl + 1);
            if (out != 0) {
                memcpy(out, cur, cl);
                store8(out + cl, 0);
                hit = out;
                store64(which, found);
            }
            done = 1;
        } else {
            if (cl <= 1) { done = 1; }                          # walk hit "/"
            else {
                # Back up to the last '/'. The path is absolute, so there always is one.
                var last = cl - 1;
                while (load8(cur + last) != 47) { last = last - 1; }
                if (last == 0) { cl = 1; }
                else { cl = last; }
            }
        }
    }
    return hit;
}

fn find_ancestor_with(start_dir, marker): i64 {
    var which[8];
    return find_ancestor_with_either(start_dir, marker, 0, &which);
}

# Read a file that an ATTACKER may have chosen the type of.
#
# Audit 2026-08-26, A-01 (HIGH). `file_read_all` opens with plain
# `open(path, O_RDONLY)`. On a FIFO with no writer, open(2) BLOCKS FOREVER —
# and nothing in this program covers that: the only watchdog is
# `shellout_capture`'s epoll deadline, which wraps fork+exec, not file reads,
# and main() installs no alarm. `find_ancestor_with` selects candidates with
# `access(F_OK)`, which succeeds on a FIFO, so a non-regular file is picked and
# then opened blocking.
#
# Confirmed against the shipped binary, all five reachable paths: a hostile
# repo shipping `VERSION`, `.python-version`, `.nvmrc` or `rust-toolchain` as a
# FIFO — and tar preserves FIFOs, so `git clone`/untar is enough — hangs
# `cmdrs` indefinitely (`timeout 6` -> rc 124, /proc/<pid>/wchan reads
# `wait_for_partner`). `PROMPT="$(cmdrs)"` then never returns and the user has
# no prompt and no input loop until they kill it. Same for `~/.commandress`
# itself under a hostile HOME.
#
# Two guards, because either alone is insufficient:
#   - O_NONBLOCK makes the OPEN return instead of parking in fifo_open.
#   - fstat + S_IFREG rejects the file anyway, which also covers device nodes
#     whose *reads* stall (a FIFO opened O_NONBLOCK would read EOF, but
#     /dev/zero would read forever into our cap, and a tty could stall).
# Checking on the already-open fd, not by path, also closes the TOCTOU between
# the access(F_OK) that selected the path and the open that follows it.
#
# AGNOS: both guards are unavailable and the exposure does not exist there.
# `O_NONBLOCK` is defined only in the Linux/macOS syscall peers (2048), not in
# the agnos one, so naming it would fail the `--agnos` build; and agnos's
# `sys_fstat` is a hard stub (`return 0 - 1;` in syscalls_x86_64_agnos.cyr), so
# an unconditional S_IFREG gate would reject EVERY file and silently revert
# agnos users to baked-in defaults. Agnos keeps the plain read.
fn read_regular_file(path, buf, cap): i64 {
    if (path == 0) { return 0 - 1; }
    #ifdef CYRIUS_TARGET_AGNOS
    return file_read_all(path, buf, cap);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fd = file_open(path, O_NONBLOCK, 0);            # O_RDONLY is 0
    if (fd < 0) { return 0 - 1; }
    # 144 = sizeof(struct stat) on Linux x86_64 (same as src/cache.cyr). A
    # smaller frame array would let the kernel write past it.
    var stbuf[144];
    if (sys_fstat(fd, &stbuf) != 0) { file_close(fd); return 0 - 1; }
    var st_mode = load32(&stbuf + 24);                  # struct stat: st_mode @ 24
    if ((st_mode & 0xF000) != 0x8000) {                 # S_IFMT / S_IFREG
        file_close(fd);
        return 0 - 1;
    }
    var total = 0;
    var going = 1;
    while (going == 1) {
        if (total >= cap) { going = 0; }
        else {
            var n = file_read(fd, buf + total, cap - total);
            if (n <= 0) { going = 0; }
            else { total = total + n; }
        }
    }
    file_close(fd);
    return total;
    #endif
}

# The `n` bytes at `buf`, trimmed at both ends, as a heap-alloc'd cstring, or 0 when
# nothing is left.
fn trimmed_copy(buf, n): i64 {
    var start = 0;
    var ltrim = 1;
    while (ltrim == 1) {
        if (start >= n) { ltrim = 0; }
        else {
            var c = load8(buf + start);
            if (c == 32) { start = start + 1; }
            else { if (c == 9) { start = start + 1; }
                else { if (c == 10) { start = start + 1; }
                    else { if (c == 13) { start = start + 1; }
                        else { ltrim = 0; }
                    }}}
        }
    }

    var end = n;
    var rtrim = 1;
    while (rtrim == 1) {
        if (end <= start) { rtrim = 0; }
        else {
            var c = load8(buf + end - 1);
            if (c == 32) { end = end - 1; }
            else { if (c == 9) { end = end - 1; }
                else { if (c == 10) { end = end - 1; }
                    else { if (c == 13) { end = end - 1; }
                        else { rtrim = 0; }
                    }}}
        }
    }

    var content_len = end - start;
    if (content_len == 0) { return 0; }
    var out = alloc(content_len + 1);
    if (out == 0) { return 0; }
    memcpy(out, buf + start, content_len);
    store8(out + content_len, 0);
    return out;
}

# `<root><suffix>` as a heap-alloc'd cstring, or 0 if alloc refuses.
fn join_path(root, suffix): i64 {
    var root_len = strlen(root);
    var suffix_len = strlen(suffix);
    var path = alloc(root_len + suffix_len + 1);
    if (path == 0) { return 0; }
    memcpy(path, root, root_len);
    memcpy(path + root_len, suffix, suffix_len);
    store8(path + root_len + suffix_len, 0);
    return path;
}

fn read_trimmed_file_at(root, suffix): i64 {
    if (root == 0) { return 0; }
    if (suffix == 0) { return 0; }
    var path = join_path(root, suffix);
    if (path == 0) { return 0; }

    var buf[PROBE_FILE_CAP];
    var n = read_regular_file(path, &buf, PROBE_FILE_CAP);   # audit A-01: FIFO/device-safe
    if (n <= 0) { return 0; }
    return trimmed_copy(&buf, n);
}
