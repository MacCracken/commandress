# fslookup.cyr — shared filesystem-ancestor walker.
#
# `find_ancestor_with(start_dir, marker)` walks `start_dir` upward and
# returns the nearest ancestor directory in which `<dir><marker>` exists
# (per `access(F_OK)`), or 0 when the walk reaches "/" without a hit.
#
# `marker` must start with "/" (e.g. "/cyrius.cyml", "/.python-version",
# "/.nvmrc"). The leading slash is part of the marker so that the join
# at the root case ("/" + marker) still produces a valid path; POSIX
# collapses any leading "//" to "/".
#
# Lifted from `src/segments/cyrius_env.cyr` in v0.5.0 once the M4
# language-env segments showed two-plus consumers of the same walk
# (cyrius_env's cyrius.cyml, python_env's .python-version, node_env's
# .nvmrc / package.json). Each segment's project-detection now boils
# down to a single call.
#
# Allocation: returns a heap-alloc'd cstring of the matching directory
# (no trailing slash, except "/" itself which keeps its one slash).
# Caller owns; bump allocator reclaims at end of redraw.

fn find_ancestor_with(start_dir, marker): i64 {
    if (start_dir == 0) { return 0; }
    if (marker == 0) { return 0; }
    var len = strlen(start_dir);
    if (len == 0) { return 0; }
    var marker_len = strlen(marker);
    if (marker_len == 0) { return 0; }

    # Working copy of the starting dir — truncated in place as we walk.
    # 4096 matches PATH_MAX, same bound cwd.cyr / cyrius_env.cyr use.
    var cur = alloc(4097);
    memcpy(cur, start_dir, len);
    store8(cur + len, 0);
    var cl = len;

    # Strip trailing '/'s from the input, but never collapse the lone
    # root "/" — at cl == 1 we stop, so the loop bottoms out cleanly.
    var strip = 1;
    while (strip == 1) {
        if (cl <= 1) { strip = 0; }
        else { if (load8(cur + cl - 1) == 47) { cl = cl - 1; store8(cur + cl, 0); }
        else { strip = 0; }
        }
    }

    var hit = 0;
    var done = 0;
    while (done == 0) {
        var candidate = alloc(cl + marker_len + 1);
        memcpy(candidate, cur, cl);
        memcpy(candidate + cl, marker, marker_len);
        store8(candidate + cl + marker_len, 0);
        if (syscall(SYS_ACCESS, candidate, 0) == 0) {           # F_OK
            var out = alloc(cl + 1);
            memcpy(out, cur, cl);
            store8(out + cl, 0);
            hit = out;
            done = 1;
        } else {
            if (cl <= 1) { done = 1; }                          # walk hit "/"
            else {
                var last = 0 - 1;
                var i = 0;
                while (i < cl) {
                    if (load8(cur + i) == 47) { last = i; }
                    i = i + 1;
                }
                if (last < 0) { done = 1; }
                else {
                    if (last == 0) { cl = 1; store8(cur + 1, 0); }
                    else { cl = last; store8(cur + cl, 0); }
                }
            }
        }
    }
    return hit;
}
