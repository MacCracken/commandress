# pathlookup.cyr — shared $PATH resolver for shellout-backed segments.
#
# `find_in_path(name)` walks the colon-separated $PATH and returns a
# heap-alloc'd absolute-path cstring (`<dir>/<name>`) for the first
# entry that satisfies `access(X_OK)`, or 0 when nothing matches.
#
# Why this lives outside the stdlib: Linux `execve(2)` does NOT do PATH
# lookup — that's a libc-`execvp` thing — and no stdlib helper exposes
# the equivalent today (Cyrius papercut Item 8, deferred to v6.x). Lifted
# out of `src/segments/vcs.cyr` in M4 (v0.5.0) so the new shellout-backed
# language-env probes (python_env, rustup_env) share one implementation
# instead of each copy-pasting the loop.
#
# Contract:
#   name — caller-owned NUL-terminated cstring (e.g. "sit", "python3")
#   returns — heap-alloc'd absolute-path cstring (caller owns), or 0 on:
#     - PATH unset
#     - empty PATH entry that doesn't match
#     - PATH entry that isn't absolute (audit F-7: skip — see below)
#     - no PATH entry's <dir>/<name> passes access(X_OK)
#
# Audit finding F-8 (2026-05-18): only absolute `$PATH` entries are
# accepted. Empty entries (consecutive `::`) and entries that don't
# start with `/` (`.`, `bin`, `../tools`) are skipped. This closes
# the canonical "`.` in PATH" pitfall (historic sudo cases): a
# malicious cwd containing `sit` or `cyrius` binaries would never
# get exec'd by `cmdrs` even if the user's PATH includes `.`.
#
# Allocation note: each successful call allocates exactly one cstring of
# size strlen(dir) + 1 + strlen(name) + 1. The bump allocator owns the
# memory for the redraw's lifetime; segments don't free.

# Same as `find_in_path` but takes the `$PATH`-style cstring directly.
# Splitting the env-read from the walker lets tests drive the walker
# with fabricated PATH strings (Cyrius stdlib has no setenv today).

# Shared current-working-directory fetch. Linux uses getcwd(2). AGNOS has
# no getcwd syscall — CWD is userland-owned (the shell tracks it, see the
# agnos ABI), so there's no kernel cwd to query yet — return 0 (the
# cwd-dependent segments degrade to empty). A real agnos CWD source (PWD
# passed by agnsh, or a cwd primitive) can fill this in later.
fn cmdrs_getcwd(buf, cap): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(SYS_GETCWD, buf, cap);
    #endif
}

fn find_in_path_with(path, name): i64 {
    if (path == 0) { return 0; }
    var nlen = strlen(name);
    var plen = strlen(path);
    var pi = 0;
    var hit = 0;
    var done = 0;
    while (done == 0) {
        if (pi >= plen) { done = 1; }
        else {
            var end = pi;
            var seek = 1;
            while (seek == 1) {
                if (end >= plen) { seek = 0; }
                else { if (load8(path + end) == 58) { seek = 0; } else { end = end + 1; } }
            }
            var dir_len = end - pi;
            # F-8: skip non-absolute entries — must start with '/'.
            # `dir_len > 0` filters empty entries (consecutive `::`,
            # which POSIX treats as `.`); the load8 check filters `.`
            # and any other relative path.
            if (dir_len > 0) {
                if (load8(path + pi) == 47) {                  # '/' = 47
                    var candidate = alloc(dir_len + 1 + nlen + 1);
                    memcpy(candidate, path + pi, dir_len);
                    store8(candidate + dir_len, 47);
                    memcpy(candidate + dir_len + 1, name, nlen);
                    store8(candidate + dir_len + 1 + nlen, 0);
                    # AGNOS has no access(2) (capability gates, not access checks)
                    # and no PATH/env — agnsh tools are builtins — so PATH-based
                    # executable lookup degrades to not-found; the prompt's
                    # tool-detection segments simply don't fire.
                    #ifndef CYRIUS_TARGET_AGNOS
                    if (syscall(SYS_ACCESS, candidate, 1) == 0) {
                        hit = candidate;
                        done = 1;
                    }
                    #endif
                }
            }
            pi = end + 1;
        }
    }
    return hit;
}

fn find_in_path(name): i64 {
    return find_in_path_with(getenv("PATH"), name);
}
