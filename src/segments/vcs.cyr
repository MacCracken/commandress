# vcs.cyr — VCS context segment (sit-based).
#
# Shells out to `sit status` via `shellout_capture` (src/shellout.cyr),
# parses the captured stdout for branch name + dirty/clean flag, and
# emits `<branch>` (clean) or `<branch><dirty_marker>` (dirty).
#
# Returns 0 (renders empty) when sit isn't on PATH, when sit exits
# without output, when the watchdog times sit out, or when the output
# doesn't start with the expected `On branch ` prefix. The empty render
# covers: not a sit repo, sit not installed, sit errored, sit hung,
# detached HEAD (no `On branch <name>` line). Per ADR 0004.
#
# Pre-v0.4.0 history: this file used to inline its own fork+pipe+
# execve (`_vcs_capture`) to avoid lib/process.cyr::_exec3's byte-
# contract bug + missing stderr dup2 — both fixed upstream in Cyrius
# 5.11.60. The watchdog (shellout.cyr) replaced the inline path in
# v0.4.0 alongside the per-segment timeout work carried forward from
# M2 / M3. The inline `_find_in_path` helper moved to
# `src/pathlookup.cyr` in v0.5.0 so the M4 language-env probes share
# one implementation (still pending Cyrius v6.x Item 8 upstream).

# Per-redraw budget for the `sit status` shellout. The healthy-host
# measurement was ~1.8 ms (CHANGELOG [0.3.0]); 5 ms gives ~2.5× safety
# margin while keeping the segment well inside the 5 ms total prompt
# budget. Config-overridable via [[segments.vcs]] budget_ms = N lands
# in a follow-up slot — for v0.4.0 the budget is fixed in code.
enum VcsBudget {
    VCS_BUDGET_MS = 5;
}

# Pure parser. Given the raw stdout bytes from `sit status` and a
# dirty_marker cstring (or 0 for no marker), returns a heap-alloc'd
# NUL-terminated cstring formatted per the contract above, or 0 on
# any parse failure. Splitting this from the shell-out path lets tests
# fabricate `sit status` outputs without forking a real subprocess.
fn vcs_parse_render(buf, n, dirty_marker): i64 {
    var prefix = "On branch ";
    var prefix_len = strlen(prefix);
    if (n < prefix_len) { return 0; }
    if (memeq(buf, prefix, prefix_len) == 0) { return 0; }

    var i = prefix_len;
    var seek = 1;
    while (seek == 1) {
        if (i >= n) { seek = 0; }
        else { if (load8(buf + i) == 10) { seek = 0; } else { i = i + 1; } }
    }
    var branch_len = i - prefix_len;
    if (branch_len == 0) { return 0; }

    var clean_msg = "nothing to commit, working tree clean";
    var cmlen = strlen(clean_msg);
    var dirty = 1;
    if (n >= cmlen) {
        var ci = 0;
        var scan = 1;
        while (scan == 1) {
            if (ci + cmlen > n) { scan = 0; }
            else {
                if (memeq(buf + ci, clean_msg, cmlen) == 1) {
                    dirty = 0;
                    scan = 0;
                } else {
                    ci = ci + 1;
                }
            }
        }
    }

    var marker_len = 0;
    if (dirty == 1) {
        if (dirty_marker != 0) { marker_len = strlen(dirty_marker); }
    }
    var out = alloc(branch_len + marker_len + 1);
    memcpy(out, buf + prefix_len, branch_len);
    if (marker_len > 0) { memcpy(out + branch_len, dirty_marker, marker_len); }
    store8(out + branch_len + marker_len, 0);
    return out;
}

# Cache TTL (seconds). 1 s is the M6 sweet spot — fast enough that a
# user touching files sees their dirty marker update on the next
# prompt cycle; slow enough that rapid typing inside a single keystroke
# burst pays the fork+exec at most once. Tuning lower would need
# sub-second `sys_stat` mtime resolution we don't have today.
enum VcsCacheTtl {
    VCS_CACHE_TTL_SECS = 1;
}

# Shell-out path. Finds `sit` on PATH, runs `sit status` under the
# watchdog, hands the captured bytes to the parser. Returns 0 on any
# failure mode (not in PATH, timeout, system error, no output, parse
# fail) — segment renders empty.
#
# v0.7.0: wrapped with a per-cwd 1-second TTL cache. First call in a
# fresh shell pays the fork+exec; subsequent calls within 1 s read the
# cached cstring from `/tmp/commandress-<uid>/vcs-<hash>`. An empty
# cached value means "no sit repo / sit not on PATH for this cwd" —
# we short-circuit the find_in_path + shellout in that case too.
fn vcs_render(dirty_marker): i64 {
    var cwd_buf[4096];
    var cwd_n = cmdrs_getcwd(&cwd_buf, 4096);
    if (cwd_n > 0) {
        cwd_n = cwd_n - 1;
        var cwd = alloc(cwd_n + 1);
        memcpy(cwd, &cwd_buf, cwd_n);
        store8(cwd + cwd_n, 0);
        var cached = cache_get("vcs", cwd, VCS_CACHE_TTL_SECS);
        if (cached != 0) {
            if (strlen(cached) == 0) { return 0; }
            return cached;
        }
    }

    var result = 0;
    var sit_path = find_in_path("sit");
    if (sit_path != 0) {
        var argv = alloc(24);
        store64(argv, sit_path);
        store64(argv + 8, "status");
        store64(argv + 16, 0);
        var envp = alloc(8);
        store64(envp, 0);

        var buf[8192];
        var n = shellout_capture(sit_path, argv, envp, VCS_BUDGET_MS, &buf, 8192);
        if (n > 0) { result = vcs_parse_render(&buf, n, dirty_marker); }
    }

    # Cache the result keyed by current cwd. Empty result → cache ""
    # so the next redraw skips find_in_path + shellout too.
    if (cwd_n > 0) {
        var cwd2 = alloc(cwd_n + 1);
        memcpy(cwd2, &cwd_buf, cwd_n);
        store8(cwd2 + cwd_n, 0);
        if (result != 0) {
            cache_put("vcs", cwd2, result, strlen(result));
        } else {
            cache_put("vcs", cwd2, "", 0);
        }
    }
    return result;
}
