# rustup_env.cyr — Rust toolchain segment.
#
# Resolution (file-first; no shellout), following rustup's own search:
#   1. Walk up from the cwd. The nearest directory holding `rust-toolchain` or
#      `rust-toolchain.toml` wins. If one directory holds both, `rust-toolchain`
#      wins.
#   2. `rust-toolchain.toml` is TOML: show `[toolchain] channel`.
#   3. `rust-toolchain` is the legacy one-line format (its first word), or TOML,
#      which rustup also accepts under that name. More than one line means TOML,
#      which is rustup's own rule.
#   4. With `shellout = true`, under a `Cargo.toml` and with no channel from a file →
#      `rustup show active-toolchain`, run from `/`. See src/probe.cyr.
#   5. Otherwise empty.
#
# ⚠ REPO-CONTROLLED INPUT. These files come from whatever directory the user is
# in, so this is the first path where bytes an attacker chose reach the TOML
# parser; everything else it reads is the user's own `~/.commandress`. Four
# things bound that:
#   - `read_pin_file` refuses a FIFO or device (audit A-01), and a symlink to a file of
#     another name (ADR 0015).
#   - RUSTUP_FILE_CAP bounds the parse. A real file is well under 1 KB, and the
#     cap keeps bayan's worst case far below the render budget.
#   - `pin_shape_ok` bounds the output. Without it a hostile file could put nearly
#     the whole read cap into every redraw. Anything over PIN_WORD_MAX, or not shaped
#     like a toolchain name, renders empty.
#   - The channel goes through `sanitize_segment_output` like all segment output,
#     so an escape-spelled control byte is stripped before it reaches the terminal.
#
# Never probe `rustc --version` instead: through a `path` toolchain it runs a binary the
# repo chose. `rustup show` only prints the name.

enum RustupEnv {
    RUSTUP_FILE_CAP = 4096;
}

# Pure parser: `channel` from `[toolchain]`, in the `n` bytes at `buf`. Returns a
# heap-alloc'd cstring, or 0 when the table or the key is absent or empty.
fn rustup_env_parse_toml(buf, n): i64 {
    if (n <= 0) { return 0; }
    var sections = bayan_toml_parse(str_new(buf, n));
    if (sections == 0) { return 0; }
    var pairs = _section_pairs(sections, "toolchain");
    if (pairs == 0) { return 0; }
    var pair = bayan_toml_get_pair_by_cstr(pairs, "channel");
    if (pair == 0) { return 0; }
    if (bayan_toml_pair_is_string(pair) == false) { return 0; }
    var channel = bayan_toml_pair_value(pair);
    if (pin_shape_ok(str_data(channel), str_len(channel), PIN_WORD_MAX, 0) == 0) { return 0; }
    return str_cstr(channel);
}

# 1 if `rust-toolchain` content is TOML. This is rustup's own rule: exactly one line is
# the legacy format, anything else is TOML. Blank lines around that one line do not
# count here, which is kinder than rustup and harmless. A lone `[...]` line counts as
# TOML too: it can only be a table header, and it is no channel name.
fn _rustup_text_is_toml(buf, n): i64 {
    var start = 0;
    var end = n;
    var trim = 1;
    while (trim == 1) {
        if (end <= start) { trim = 0; }
        else {
            var c = load8(buf + end - 1);
            if (c == 32 || c == 9 || c == 10 || c == 13) { end = end - 1; }
            else { trim = 0; }
        }
    }
    trim = 1;
    while (trim == 1) {
        if (start >= end) { trim = 0; }
        else {
            var c = load8(buf + start);
            if (c == 32 || c == 9 || c == 10 || c == 13) { start = start + 1; }
            else { trim = 0; }
        }
    }
    if (start >= end) { return 0; }
    if (load8(buf + start) == 91) { return 1; }
    var i = start;
    while (i < end) {
        if (load8(buf + i) == 10) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The value of the toolchain file `<root><suffix>`. `is_toml` is 1 for a file that
# can only be TOML, 0 for `rust-toolchain`, whose format is decided by its content.
#
# The buffer is heap, not frame: the caller already holds a 4 KB cwd buffer, and a
# frame this size has caused trouble on agnos before (audit A-08).
fn _rustup_file_value(root, suffix, is_toml): i64 {
    var path = join_path(root, suffix);
    if (path == 0) { return 0; }

    var buf = alloc(RUSTUP_FILE_CAP);
    if (buf == 0) { return 0; }
    var n = read_pin_file(path, buf, RUSTUP_FILE_CAP);
    if (n <= 0) { return 0; }
    if (is_toml == 1) { return rustup_env_parse_toml(buf, n); }

    if (_rustup_text_is_toml(buf, n) == 1) { return rustup_env_parse_toml(buf, n); }
    return pin_word_of_file(buf, n, PROBE_FILE_CAP);
}

# The toolchain in force at `cwd`, or 0.
fn rustup_env_for(cwd): i64 {
    var which[8];
    var root = find_ancestor_with_either(cwd, "/rust-toolchain", "/rust-toolchain.toml", &which);
    if (root == 0) { return 0; }
    if (load64(&which) == 2) { return _rustup_file_value(root, "/rust-toolchain.toml", 1); }
    return _rustup_file_value(root, "/rust-toolchain", 0);
}

# The machine's default toolchain, for a project at or above `cwd` with no toolchain file,
# even one that names no channel: a `path` toolchain is not the default. `budget_ms` 0 is
# off.
fn rustup_env_probe(cwd, tool, budget_ms): i64 {
    if (budget_ms == 0) { return 0; }
    if (tool == 0) { return 0; }
    var which[8];
    if (find_ancestor_with_either(cwd, "/rust-toolchain", "/rust-toolchain.toml", &which) != 0) { return 0; }
    if (find_ancestor_with(cwd, "/Cargo.toml") == 0) { return 0; }
    return probe_run("rustup_env", tool, "show", "active-toolchain", budget_ms, &probe_parse_rustup);
}

fn rustup_env_render(probe_ms): i64 {
    var buf[4096];
    var n = cmdrs_getcwd(&buf, 4096);
    if (n <= 0) { return 0; }
    n = n - 1;

    var cwd = alloc(n + 1);
    if (cwd == 0) { return 0; }
    memcpy(cwd, &buf, n);
    store8(cwd + n, 0);

    var pinned = rustup_env_for(cwd);
    if (pinned != 0) { return pinned; }
    if (probe_ms == 0) { return 0; }
    return rustup_env_probe(cwd, find_in_path("rustup"), probe_ms);
}
