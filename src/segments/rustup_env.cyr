# rustup_env.cyr — Rust toolchain segment.
#
# Resolution (file-first; no shellout), following rustup's own search:
#   1. Walk up from the cwd. The nearest directory holding `rust-toolchain` or
#      `rust-toolchain.toml` wins. If one directory holds both, `rust-toolchain`
#      wins.
#   2. `rust-toolchain.toml` is TOML: show `[toolchain] channel`.
#   3. `rust-toolchain` is the legacy one-line format (trimmed contents), or TOML,
#      which rustup also accepts under that name. A first non-blank byte of `[`
#      means TOML.
#   4. A file with no `channel` (a `path` toolchain, say) renders empty.
#
# ⚠ REPO-CONTROLLED INPUT. These files come from whatever directory the user is
# in, so this is the first path where bytes an attacker chose reach the TOML
# parser; everything else it reads is the user's own `~/.commandress`. Three
# things bound that:
#   - `read_regular_file` refuses a FIFO or device (audit A-01).
#   - RUSTUP_FILE_CAP bounds the parse. A real file is well under 1 KB, and the
#     cap keeps bayan's worst case far below the render budget.
#   - RUSTUP_CHANNEL_MAX bounds the output. Without it a hostile file could put
#     nearly the whole read cap into every redraw, where the plain format stops at
#     255 bytes. A longer value is no real toolchain, so it renders empty.
#   - The channel goes through `sanitize_segment_output` like all segment output,
#     so an escape-spelled control byte is stripped before it reaches the terminal.
#
# `rustup show active-toolchain` shellout stays parked per the file-first policy.
# See roadmap.md for its slot.

enum RustupEnv {
    RUSTUP_FILE_CAP = 4096;
    RUSTUP_CHANNEL_MAX = 255;
}

# Pure parser: `channel` from `[toolchain]`, in the `n` bytes at `buf`. Returns a
# heap-alloc'd cstring, or 0 when the table or the key is absent or empty.
fn rustup_env_parse_toml(buf, n): i64 {
    if (n <= 0) { return 0; }
    var sections = bayan_toml_parse(str_new(buf, n));
    if (sections == 0) { return 0; }
    var pairs = _section_pairs(sections, "toolchain");
    if (pairs == 0) { return 0; }
    var channel = bayan_toml_get_by_cstr(pairs, "channel");
    if (channel == 0) { return 0; }
    if (str_len(channel) == 0) { return 0; }
    if (str_len(channel) > RUSTUP_CHANNEL_MAX) { return 0; }
    return str_cstr(channel);
}

# The value of the toolchain file `<root><suffix>`. `is_toml` is 1 for a file that
# can only be TOML, 0 for `rust-toolchain`, whose format is decided by its content.
#
# The buffer is heap, not frame: agnos gives ring-3 about 12 KB of init stack
# (audit A-08), and the caller already holds a 4 KB cwd buffer.
fn _rustup_file_value(root, suffix, is_toml): i64 {
    var root_len = strlen(root);
    var suffix_len = strlen(suffix);
    var path = alloc(root_len + suffix_len + 1);
    if (path == 0) { return 0; }
    memcpy(path, root, root_len);
    memcpy(path + root_len, suffix, suffix_len);
    store8(path + root_len + suffix_len, 0);

    var buf = alloc(RUSTUP_FILE_CAP);
    if (buf == 0) { return 0; }
    var n = read_regular_file(path, buf, RUSTUP_FILE_CAP);
    if (n <= 0) { return 0; }
    if (is_toml == 1) { return rustup_env_parse_toml(buf, n); }

    var i = 0;
    var seek = 1;
    while (seek == 1) {
        if (i >= n) { seek = 0; }
        else {
            var c = load8(buf + i);
            if (c == 32 || c == 9 || c == 10 || c == 13) { i = i + 1; }
            else { seek = 0; }
        }
    }
    if (i >= n) { return 0; }
    if (load8(buf + i) == 91) { return rustup_env_parse_toml(buf, n); }
    return read_trimmed_file_at(root, suffix);
}

# The toolchain in force at `cwd`, or 0. Both roots are ancestors of `cwd`, so the
# longer path is the nearer directory, and a tie is the same directory.
fn rustup_env_for(cwd): i64 {
    var plain = find_ancestor_with(cwd, "/rust-toolchain");
    var toml = find_ancestor_with(cwd, "/rust-toolchain.toml");
    if (toml != 0) {
        var use_toml = 1;
        if (plain != 0) {
            if (strlen(plain) >= strlen(toml)) { use_toml = 0; }
        }
        if (use_toml == 1) { return _rustup_file_value(toml, "/rust-toolchain.toml", 1); }
    }
    if (plain == 0) { return 0; }
    return _rustup_file_value(plain, "/rust-toolchain", 0);
}

fn rustup_env_render(): i64 {
    var buf[4096];
    var n = cmdrs_getcwd(&buf, 4096);
    if (n <= 0) { return 0; }
    n = n - 1;

    var cwd = alloc(n + 1);
    memcpy(cwd, &buf, n);
    store8(cwd + n, 0);
    return rustup_env_for(cwd);
}
