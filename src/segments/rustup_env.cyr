# rustup_env.cyr — Rust toolchain segment.
#
# Resolution (file-first; no shellout in v0.5.0):
#   1. <ancestor>/rust-toolchain → trimmed contents
#   2. empty
#
# `rust-toolchain` is the legacy plain-text format (one line: a channel
# like `1.75.0` or `stable`). Modern projects use `rust-toolchain.toml`
# instead — `[toolchain] channel = "..."`.
#
# That was deferred because the Cyrius stdlib could not parse single-bracket
# sections (papercut Item 3). **The gap is closed**: verified 2026-08-26 that
# `toml_get_sections` finds a single-bracket `[toolchain]`, and that the config
# loader reads single-bracket sections end to end. This segment is therefore
# UNBLOCKED, not gated — it is scheduled work, roadmap 1.3.0. Add a `.toml`
# branch before the plain check; keep the plain-file path, both formats are
# in the wild.
#
# `rustup show active-toolchain` shellout is similarly parked pre-v1
# per the file-first policy — version probes get cheap once M6
# caching makes them affordable on every redraw.

fn rustup_env_render(): i64 {
    var buf[4096];
    var n = cmdrs_getcwd(&buf, 4096);
    if (n <= 0) { return 0; }
    n = n - 1;

    var cwd = alloc(n + 1);
    memcpy(cwd, &buf, n);
    store8(cwd + n, 0);

    var root = find_ancestor_with(cwd, "/rust-toolchain");
    if (root == 0) { return 0; }
    return read_trimmed_file_at(root, "/rust-toolchain");
}
