# cyrius_env.cyr — Cyrius project-version segment.
#
# Detects a Cyrius project by walking the current directory upward
# looking for a `cyrius.cyml` marker. Inside a project, reads
# `<root>/VERSION` (per CLAUDE.md "VERSION at the project root is the
# source of truth") and emits the trimmed contents.
#
# Resolution order:
#   1. <root>/VERSION             — file read, no shellout
#   2. `cyrius --version`         — shellout via shellout_capture
#   3. empty                      — no project / no version source
#
# The shellout fallback exists so that early-stage Cyrius projects
# without a VERSION file still light up a useful segment. It uses the
# shared `find_in_path` + `shellout_capture` watchdog — same 5 ms budget
# as `vcs`, since `cyrius --version` is a stat+print and shouldn't
# touch the disk for repo scanning the way `sit status` does.
#
# Output format: just the version string (`0.5.0`, `5.11.63`, etc.).
# No "cyrius " label or glyph — those belong to the theming layer (M5).

enum CyriusEnvBudget {
    CYRIUS_ENV_BUDGET_MS = 5;
}

# Find the nearest ancestor of `start_dir` that contains `cyrius.cyml`.
# Returns a heap-alloc'd cstring of the project root (no trailing
# slash), or 0 when the walk hits "/" without finding the marker. Thin
# wrapper over the shared walker in `src/fslookup.cyr` (lifted v0.5.0
# once python_env / node_env became second + third consumers of the
# same ancestor-walk).
fn cyrius_env_find_root(start_dir): i64 {
    return find_ancestor_with(start_dir, "/cyrius.cyml");
}

# Thin delegate over read_trimmed_file_at — preserved as a named
# helper so callers + tests read naturally. Build/trim policy lives in
# `src/fslookup.cyr` (lifted v0.5.0 once python_env hit the same shape).
fn cyrius_env_read_version(root): i64 {
    return read_trimmed_file_at(root, "/VERSION");
}

# Pure parser for `cyrius --version` stdout. First line is
# `cyrius X.Y.Z`; extracts the bytes after "cyrius " up to '\n' (or
# buffer end), returns a heap-alloc'd cstring or 0 on shape mismatch.
# Factored out so tests can drive it with fabricated bytes without
# forking a real cyrius process.
fn cyrius_env_parse_version(buf, n): i64 {
    var prefix = "cyrius ";
    var prefix_len = strlen(prefix);
    if (n < prefix_len) { return 0; }
    if (memeq(buf, prefix, prefix_len) == 0) { return 0; }

    var start = prefix_len;
    var end = start;
    var seek = 1;
    while (seek == 1) {
        if (end >= n) { seek = 0; }
        else { if (load8(buf + end) == 10) { seek = 0; } else { end = end + 1; } }
    }
    var ver_len = end - start;
    if (ver_len == 0) { return 0; }

    var out = alloc(ver_len + 1);
    memcpy(out, buf + start, ver_len);
    store8(out + ver_len, 0);
    return out;
}

# Shellout fallback: `cyrius --version` via the shared watchdog. Empty
# render on missing-from-PATH, timeout, or parse failure.
fn _cyrius_env_shellout(): i64 {
    var cyrius_path = find_in_path("cyrius");
    if (cyrius_path == 0) { return 0; }

    var argv = alloc(24);
    store64(argv, cyrius_path);
    store64(argv + 8, "--version");
    store64(argv + 16, 0);
    var envp = alloc(8);
    store64(envp, 0);

    var buf[256];
    var n = shellout_capture(cyrius_path, argv, envp, CYRIUS_ENV_BUDGET_MS, &buf, 256);
    if (n <= 0) { return 0; }
    return cyrius_env_parse_version(&buf, n);
}

fn cyrius_env_render(): i64 {
    var buf[4096];
    var n = syscall(SYS_GETCWD, &buf, 4096);
    if (n <= 0) { return 0; }
    n = n - 1;                                                  # strip trailing NUL count

    var cwd = alloc(n + 1);
    memcpy(cwd, &buf, n);
    store8(cwd + n, 0);

    var root = cyrius_env_find_root(cwd);
    if (root == 0) { return 0; }

    var ver = cyrius_env_read_version(root);
    if (ver != 0) { return ver; }

    return _cyrius_env_shellout();
}
