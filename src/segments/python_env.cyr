# python_env.cyr — Python project / virtualenv segment.
#
# Resolution order (file-first; no shellout in v0.5.0):
#   1. $VIRTUAL_ENV set         → basename of the path
#   2. <ancestor>/.python-version → trimmed contents
#   3. empty
#
# The basename of $VIRTUAL_ENV is the canonical "which venv am I in"
# signal — every shell-prompt tool surfaces it. `.python-version`
# (pyenv) acts as the project-pin file: present in the project root,
# tells us the python version this tree expects. Both are file-or-env
# reads; no shellout to `python --version` until M6 caching makes
# version probes cheap enough to default on.

# Extract the basename of `path`. Returns a heap-alloc'd cstring or 0
# when `path` is null, empty, or only slashes. Trailing slashes are
# tolerated (`/foo/bar/` → `bar`). No '/' means the input is already
# a basename (`venv` → `venv`).
fn python_env_basename(path): i64 {
    if (path == 0) { return 0; }
    var len = strlen(path);
    if (len == 0) { return 0; }

    # Drop trailing slashes — but bail if the whole input is just '/'s.
    var end = len;
    var strip = 1;
    while (strip == 1) {
        if (end == 0) { strip = 0; }
        else { if (load8(path + end - 1) == 47) { end = end - 1; } else { strip = 0; } }
    }
    if (end == 0) { return 0; }

    # Walk left-to-right tracking the rightmost '/' before `end`.
    var last = 0 - 1;
    var i = 0;
    while (i < end) {
        if (load8(path + i) == 47) { last = i; }
        i = i + 1;
    }
    var start = 0;
    if (last >= 0) { start = last + 1; }
    var name_len = end - start;
    if (name_len == 0) { return 0; }

    var out = alloc(name_len + 1);
    memcpy(out, path + start, name_len);
    store8(out + name_len, 0);
    return out;
}

# Thin delegate over read_trimmed_file_at. Build/trim policy lives in
# `src/fslookup.cyr`.
fn python_env_read_pin(root): i64 {
    return read_trimmed_file_at(root, "/.python-version");
}

fn python_env_render(): i64 {
    var venv = getenv("VIRTUAL_ENV");
    if (venv != 0) {
        if (strlen(venv) > 0) {
            var name = python_env_basename(venv);
            if (name != 0) { return name; }
        }
    }

    var buf[4096];
    var n = cmdrs_getcwd(&buf, 4096);
    if (n <= 0) { return 0; }
    n = n - 1;

    var cwd = alloc(n + 1);
    memcpy(cwd, &buf, n);
    store8(cwd + n, 0);

    var root = find_ancestor_with(cwd, "/.python-version");
    if (root == 0) { return 0; }
    return python_env_read_pin(root);
}
