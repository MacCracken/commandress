# time.cyr — wall-clock segment.
#
# Formats the current epoch via a small strftime-like parser. The
# supported conversion specs cover the prompt-time common case:
#
#   %H — hour       (00..23)
#   %M — minute     (00..59)
#   %S — second     (00..59)
#   %Y — year       (e.g. 2026)
#   %y — year mod 100 (00..99)
#   %m — month      (01..12)
#   %d — day        (01..31)
#   %% — literal '%'
#
# Anything else (including unsupported specs like %a / %p / %j) passes
# through verbatim — the user sees their literal in the output and
# knows the spec wasn't recognised. Locale-aware names + AM/PM land
# alongside the i18n surface (out of v1.0 scope).
#
# Empty / null `fmt` renders the segment empty. Time is read from
# `CLOCK_REALTIME` via `clock_epoch_secs`, then shifted into the local
# zone, chosen as `date` chooses it: `TZ`, else `/etc/localtime`, else
# UTC. `utc = true` skips all of that. The zone code is darshini's
# `src/tz.cyr`, pinned as a source dep rather than written twice. See
# ADR 0016.
#
# A zone only ever moves the digits. There is no `%Z`, so no name from a
# zone file or a `TZ` string reaches the prompt, and `TZ` can name any
# file without its contents being shown.

# Pure formatter: format `epoch` (UTC seconds) per `fmt` into a
# fresh heap cstring. Split from time_render so tests can pin the
# input epoch and assert byte-for-byte. Returns 0 on null/empty fmt.
fn time_format(epoch, fmt): i64 {
    if (fmt == 0) { return 0; }
    var flen = strlen(fmt);
    if (flen == 0) { return 0; }

    var d = epoch_to_date(epoch);
    if (d == 0) { return 0; }
    var year = load64(d);
    var mon = load64(d + 8);
    var day = load64(d + 16);
    var hour = load64(d + 24);
    var min = load64(d + 32);
    var sec = load64(d + 40);

    # Worst case: every byte of fmt is a literal (1:1) plus the
    # 4-char year spec which doubles its 2-byte input. Generously
    # allocate 4× fmt length + NUL — covers any reasonable spec mix.
    var out = alloc(flen * 4 + 1);
    if (out == 0) { return 0; }                     # the size scales with the config
    var oi = 0;
    var i = 0;
    while (i < flen) {
        var c = load8(fmt + i);
        if (c == 37) {                             # '%'
            i = i + 1;
            if (i >= flen) {
                # Trailing '%' — emit it literal.
                store8(out + oi, 37);
                oi = oi + 1;
            } else {
                var spec = load8(fmt + i);
                if (spec == 72) {                  # H — hour 00-23
                    store8(out + oi, 48 + hour / 10);
                    store8(out + oi + 1, 48 + hour % 10);
                    oi = oi + 2;
                    i = i + 1;
                } else { if (spec == 77) {         # M — minute
                        store8(out + oi, 48 + min / 10);
                        store8(out + oi + 1, 48 + min % 10);
                        oi = oi + 2;
                        i = i + 1;
                    } else { if (spec == 83) {         # S — second
                            store8(out + oi, 48 + sec / 10);
                            store8(out + oi + 1, 48 + sec % 10);
                            oi = oi + 2;
                            i = i + 1;
                        } else { if (spec == 89) {         # Y — full year
                                store8(out + oi, 48 + year / 1000);
                                store8(out + oi + 1, 48 + (year / 100) % 10);
                                store8(out + oi + 2, 48 + (year / 10) % 10);
                                store8(out + oi + 3, 48 + year % 10);
                                oi = oi + 4;
                                i = i + 1;
                            } else { if (spec == 121) {        # y — year mod 100
                                    var yy = year % 100;
                                    store8(out + oi, 48 + yy / 10);
                                    store8(out + oi + 1, 48 + yy % 10);
                                    oi = oi + 2;
                                    i = i + 1;
                                } else { if (spec == 109) {        # m — month
                                        store8(out + oi, 48 + mon / 10);
                                        store8(out + oi + 1, 48 + mon % 10);
                                        oi = oi + 2;
                                        i = i + 1;
                                    } else { if (spec == 100) {        # d — day
                                            store8(out + oi, 48 + day / 10);
                                            store8(out + oi + 1, 48 + day % 10);
                                            oi = oi + 2;
                                            i = i + 1;
                                        } else { if (spec == 37) {         # %% — literal '%'
                                                store8(out + oi, 37);
                                                oi = oi + 1;
                                                i = i + 1;
                                            } else {
                                                # Unsupported spec: emit '%' + the spec char literal.
                                                store8(out + oi, 37);
                                                store8(out + oi + 1, spec);
                                                oi = oi + 2;
                                                i = i + 1;
                                            }}}}}}}}
            }
        } else {
            store8(out + oi, c);
            oi = oi + 1;
            i = i + 1;
        }
    }
    store8(out + oi, 0);
    return out;
}

enum TimeZone { TIME_OFFSET_MAX = 93600; }                  # 26 hours, past any real zone

# `t` moved by a zone's `off`, or `t` itself if no zone could have that offset. A zone file
# can claim anything, and one that sends the clock before 1970 makes `epoch_to_date` print
# junk. So it reads as UTC, the same as a file that does not parse. A clock near zero, as
# on a dead RTC, can get there with an ordinary zone, so that is checked on the sum.
fn time_shift(t, off): i64 {
    if (off > TIME_OFFSET_MAX) { return t; }
    if (off < (0 - TIME_OFFSET_MAX)) { return t; }
    var local = t + off;
    if (local < 0) { return t; }
    return local;
}

# `fmt` at the current time, local unless `utc` is 1.
fn time_render(fmt, utc): i64 {
    var t = clock_epoch_secs();
    if (utc == 0) {
        tz_init();
        t = time_shift(t, tz_offset(t));
    }
    return time_format(t, fmt);
}
