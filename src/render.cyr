# render.cyr — prompt render pipeline (config-driven, table-dispatched).
#
# Per ADR 0002 each segment is a pure fn of (cfg, ctx). render_prompt
# walks the cfg.segments array in order, resolves each name to a
# dispatcher via the segment registry, calls it, and joins non-empty
# outputs with cfg.separator. Trailing cfg.trailer paints regardless
# (cosmetic — `$ ` is part of the prompt, not a segment).
#
# Unknown segment names in the config warn to stderr but don't abort —
# the user sees a shorter prompt and a clear message, never a crash.

include "src/context.cyr"
include "src/config.cyr"
include "src/segments/cwd.cyr"
include "src/segments/exit.cyr"
include "src/segments/vcs.cyr"
include "src/segments/time.cyr"
include "src/segments/hostname.cyr"
include "src/segments/user.cyr"
include "src/segments/cyrius_env.cyr"
include "src/segments/python_env.cyr"
include "src/segments/node_env.cyr"
include "src/segments/rustup_env.cyr"

# Dispatcher for the `cwd` segment. Pulls HOME from ctx, gates the
# home-shorten path on cfg.cwd_home_shorten, forwards max_length for
# byte-bounded truncation at '/' boundaries.
fn _dispatch_cwd(cfg, ctx): i64 {
    var home = ctx_home(ctx);
    if (cfg_cwd_home_shorten(cfg) == 0) { home = 0; }
    return cwd_render(home, cfg_cwd_max_length(cfg));
}

# Dispatcher for the `exit` segment. Standard path is "empty on zero,
# `[N]` otherwise". When `hide_zero = false` we paint `[0]` too, so
# the user gets a visible success indicator.
fn _dispatch_exit(cfg, ctx): i64 {
    var code = ctx_last_exit(ctx);
    if (code != 0) { return exit_render(code); }
    if (cfg_exit_hide_zero(cfg) == 1) { return 0; }
    var out = alloc(4);
    store8(out, 91);
    store8(out + 1, 48);
    store8(out + 2, 93);
    store8(out + 3, 0);
    return out;
}

# Dispatcher for the `vcs` segment. Forwards the dirty-marker config
# (or 0 when show_dirty is off) to `vcs_render`, which shells out to
# `sit status` and parses the result. Returns 0 when not in a sit repo
# or sit isn't available — segment renders empty.
fn _dispatch_vcs(cfg, ctx): i64 {
    var marker = 0;
    if (cfg_vcs_show_dirty(cfg) == 1) { marker = cfg_vcs_dirty_marker(cfg); }
    return vcs_render(marker);
}

# Dispatcher for the `time` segment. Forwards the configured strftime-
# subset format to `time_render`. Renders empty when format is null/
# empty (won't happen with defaults, but the user can clear it).
fn _dispatch_time(cfg, ctx): i64 {
    return time_render(cfg_time_format(cfg));
}

# Dispatcher for the `hostname` segment. Pure passthrough — the
# segment has no config knobs in M3.
fn _dispatch_hostname(cfg, ctx): i64 {
    return hostname_render();
}

# Dispatcher for the `user` segment. Pure passthrough — pwd lookup +
# $USER fallback are policy decisions baked into user_render itself.
fn _dispatch_user(cfg, ctx): i64 {
    return user_render();
}

# Dispatcher for the `cyrius_env` segment. Pure passthrough — project
# detection (cyrius.cyml walk) + VERSION-file vs shellout fallback are
# all internal to cyrius_env_render.
fn _dispatch_cyrius_env(cfg, ctx): i64 {
    return cyrius_env_render();
}

# Dispatcher for the `python_env` segment. Pure passthrough —
# $VIRTUAL_ENV basename vs .python-version walk is internal.
fn _dispatch_python_env(cfg, ctx): i64 {
    return python_env_render();
}

# Dispatcher for the `node_env` segment. Pure passthrough — .nvmrc
# ancestor walk is internal.
fn _dispatch_node_env(cfg, ctx): i64 {
    return node_env_render();
}

# Dispatcher for the `rustup_env` segment. Pure passthrough —
# rust-toolchain ancestor walk is internal.
fn _dispatch_rustup_env(cfg, ctx): i64 {
    return rustup_env_render();
}

# Registry — name → dispatcher fn pointer. Returns 0 for unknown names
# so the caller can emit a single targeted warning.
fn _seg_fn_for(name): i64 {
    if (streq(name, "cwd") == 1)      { return &_dispatch_cwd; }
    if (streq(name, "exit") == 1)     { return &_dispatch_exit; }
    if (streq(name, "vcs") == 1)      { return &_dispatch_vcs; }
    if (streq(name, "time") == 1)     { return &_dispatch_time; }
    if (streq(name, "hostname") == 1) { return &_dispatch_hostname; }
    if (streq(name, "user") == 1)     { return &_dispatch_user; }
    if (streq(name, "cyrius_env") == 1) { return &_dispatch_cyrius_env; }
    if (streq(name, "python_env") == 1) { return &_dispatch_python_env; }
    if (streq(name, "node_env") == 1)   { return &_dispatch_node_env; }
    if (streq(name, "rustup_env") == 1) { return &_dispatch_rustup_env; }
    return 0;
}

# Resolve `name` to the pre-computed SGR opening cstring stored in the
# Config struct. Returns 0 for unstyled segments or unknown names (the
# caller then skips the SGR wrapper, saving 4+ bytes of stdout per
# redraw).
fn _sgr_for(cfg, name): i64 {
    if (streq(name, "cwd") == 1)        { return cfg_sgr_cwd(cfg); }
    if (streq(name, "exit") == 1)       { return cfg_sgr_exit(cfg); }
    if (streq(name, "vcs") == 1)        { return cfg_sgr_vcs(cfg); }
    if (streq(name, "time") == 1)       { return cfg_sgr_time(cfg); }
    if (streq(name, "hostname") == 1)   { return cfg_sgr_hostname(cfg); }
    if (streq(name, "user") == 1)       { return cfg_sgr_user(cfg); }
    if (streq(name, "cyrius_env") == 1) { return cfg_sgr_cyrius_env(cfg); }
    if (streq(name, "python_env") == 1) { return cfg_sgr_python_env(cfg); }
    if (streq(name, "node_env") == 1)   { return cfg_sgr_node_env(cfg); }
    if (streq(name, "rustup_env") == 1) { return cfg_sgr_rustup_env(cfg); }
    return 0;
}

# Resolve `name` to the raw bg color cstring (e.g. "blue", or 0 for
# unset). Used by the powerline render path to build transition SGRs
# at redraw time — the pre-baked SGR doesn't surface its bg back out,
# so we keep the raw bg in a parallel slot.
fn _bg_for(cfg, name): i64 {
    if (streq(name, "cwd") == 1)        { return cfg_bg_cwd(cfg); }
    if (streq(name, "exit") == 1)       { return cfg_bg_exit(cfg); }
    if (streq(name, "vcs") == 1)        { return cfg_bg_vcs(cfg); }
    if (streq(name, "time") == 1)       { return cfg_bg_time(cfg); }
    if (streq(name, "hostname") == 1)   { return cfg_bg_hostname(cfg); }
    if (streq(name, "user") == 1)       { return cfg_bg_user(cfg); }
    if (streq(name, "cyrius_env") == 1) { return cfg_bg_cyrius_env(cfg); }
    if (streq(name, "python_env") == 1) { return cfg_bg_python_env(cfg); }
    if (streq(name, "node_env") == 1)   { return cfg_bg_node_env(cfg); }
    if (streq(name, "rustup_env") == 1) { return cfg_bg_rustup_env(cfg); }
    return 0;
}

# Write all `len` bytes to stdout, tolerating short writes and EINTR.
#
# Audit 2026-08-26, P-03. Every emit in this file used to be a bare
# `syscall(SYS_WRITE, STDOUT, buf, len)` with the result discarded, which
# assumes write(2) is all-or-nothing. It is not: a write larger than
# PIPE_BUF (4096) to a pipe may be partial, and `cmdrs` writes into a pipe
# by construction — `PROMPT="$(cmdrs)"` IS a pipe — with pieces that reach
# that size (a deep `getcwd` runs to PATH_MAX, and a language-env segment
# contributes up to 255 bytes). A signal arriving mid-write returns -EINTR
# having written nothing. Either way the discarded result meant the prompt
# was silently truncated and the render still reported success.
#
# Loop on progress; retry -EINTR (raw syscalls return negative errno, so
# EINTR is -4); treat anything else — including a 0 return on a non-zero
# length, which would otherwise spin forever — as a hard failure.
fn _emit(buf, len): i64 {
    if (buf == 0) { return 0; }
    if (len <= 0) { return 0; }
    var off = 0;
    var failed = 0;
    var done = 0;
    while (done == 0) {
        if (off >= len) { done = 1; }
        else {
            var n = syscall(SYS_WRITE, STDOUT, buf + off, len - off);
            if (n > 0) { off = off + n; }
            else {
                if (n != (0 - 4)) { failed = 1; done = 1; }
            }
        }
    }
    if (failed == 1) { return 0 - 1; }
    return off;
}

# Emit a powerline transition glyph: `\x1b[<fg=prev_bg>;<bg=next_bg>m<glyph>\x1b[0m`.
# Either bg may be 0 (treated as terminal-default); when both are 0 the
# glyph paints as plain text. The transition fg comes from the prev
# segment's bg via `color_to_sgr_fg(prev_bg)` — that's correct because
# the GLYPH's fg should match the PREVIOUS BLOCK's color so the visual
# bridge between blocks renders seamlessly.
fn _emit_powerline_transition(prev_bg, next_bg, glyph): i64 {
    var glen = strlen(glyph);
    if (glen == 0) { return 0; }
    var sgr = sgr_open_for(prev_bg, next_bg, 0);
    if (sgr != 0) { _emit(sgr, strlen(sgr)); }
    _emit(glyph, glen);
    if (sgr != 0) { _emit(SGR_RESET, strlen(SGR_RESET)); }
    return 0;
}

# Paint segments to stdout. `side` selects the segment list (0 = left
# / cfg.segments; 1 = right / cfg.right_segments). Trailer paints only
# on the left — the right prompt is just segments, no `$ ` indicator
# (zsh's `RPROMPT` is static decoration, not a cursor anchor).
#
# Two render styles are dispatched here based on `cfg.separator_style`:
#
#   - plain (0): segments are joined by `cfg.separator`; SGR wraps
#     each segment individually; no transitions.
#   - powerline (1): segments form bg-blocks; the separator BETWEEN
#     segments is the glyph painted as `fg=prev_bg, bg=next_bg`; a
#     trailing glyph closes the chain (`fg=last_bg, bg=default`)
#     unless the last segment had no bg set.
fn render_prompt(cfg, ctx, side): i64 {
    var segs = cfg_segments(cfg);
    if (side != 0) { segs = cfg_right_segments(cfg); }

    var powerline = cfg_separator_style(cfg);
    var sep = cfg_separator(cfg);
    var sep_len = strlen(sep);
    var glyph = cfg_separator_glyph(cfg);
    if (side != 0) { glyph = cfg_right_separator_glyph(cfg); }

    var n = vec_len(segs);
    var painted = 0;
    var prev_bg = 0;
    var i = 0;
    while (i < n) {
        var name = vec_get(segs, i);
        var fp = _seg_fn_for(name);
        if (fp == 0) {
            # Sanitize the echoed name (audit 2026-08-26, P-02). It comes from
            # the config file, which the F-1 analysis treats as trusted — but
            # this warning re-emits it to the TERMINAL on every redraw, for as
            # long as the typo stands, and stderr is not captured by
            # `PROMPT="$(cmdrs)"`, so it reaches the terminal directly rather
            # than the prompt string. An ESC-bearing segment name was verified
            # to pass through raw here while identical bytes in segment OUTPUT
            # are stripped one branch below. Cheap to close, so close it.
            var safe_name = sanitize_segment_output(name);
            syscall(SYS_WRITE, STDERR, "warning: unknown segment '", 26);
            syscall(SYS_WRITE, STDERR, safe_name, strlen(safe_name));
            syscall(SYS_WRITE, STDERR, "' (skipped)\n", 12);
        } else {
            var out = fncall2(fp, cfg, ctx);
            if (out != 0) {
                # Sanitize before emit (audit F-1). The "safe_len > 0"
                # guard skips the whole paint when a segment's content
                # was entirely control bytes (degenerate case for
                # attacker input) — saves a stray separator from the
                # next segment.
                var safe = sanitize_segment_output(out);
                var safe_len = strlen(safe);
                if (safe_len > 0) {
                    var seg_bg = _bg_for(cfg, name);
                    if (painted == 1) {
                        if (powerline == 1) {
                            _emit_powerline_transition(prev_bg, seg_bg, glyph);
                        } else {
                            _emit(sep, sep_len);
                        }
                    }
                    var sgr = _sgr_for(cfg, name);
                    if (sgr != 0) { _emit(sgr, strlen(sgr)); }
                    _emit(safe, safe_len);
                    if (sgr != 0) { _emit(SGR_RESET, strlen(SGR_RESET)); }
                    prev_bg = seg_bg;
                    painted = 1;
                }
            }
        }
        i = i + 1;
    }

    # Trailing transition closes the final block in powerline mode
    # (fg = last segment's bg, bg = terminal default). Skipped when the
    # last segment had no bg (no block to close) — the helper returns
    # immediately when there's nothing to emit.
    if (powerline == 1) {
        if (painted == 1) {
            if (prev_bg != 0) { _emit_powerline_transition(prev_bg, 0, glyph); }
        }
    }

    if (side == 0) {
        var trailer = cfg_trailer(cfg);
        _emit(trailer, strlen(trailer));
    }
    return 0;
}
