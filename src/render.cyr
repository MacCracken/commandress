# render.cyr — prompt render pipeline (config-driven, table-dispatched).
#
# Per ADR 0002 each segment is a pure fn of (cfg, ctx). render_prompt
# walks the cfg.segments array in order, resolves each name to a
# dispatcher via the segment registry, calls it, and joins non-empty
# outputs with cfg.separator. Trailing cfg.trailer paints regardless
# (cosmetic — `$ ` is part of the prompt, not a segment).
#
# Unknown segment names in the config warn to stderr but don't abort —
# the user sees a shorter prompt and a clear message, never a crash.

include "src/context.cyr"
include "src/config.cyr"
include "src/segments/cwd.cyr"
include "src/segments/exit.cyr"
include "src/segments/vcs.cyr"
include "src/segments/time.cyr"
include "src/segments/hostname.cyr"
include "src/segments/user.cyr"
include "src/segments/cyrius_env.cyr"
include "src/segments/python_env.cyr"

# Dispatcher for the `cwd` segment. Pulls HOME from ctx, gates the
# home-shorten path on cfg.cwd_home_shorten.
fn _dispatch_cwd(cfg, ctx): i64 {
    var home = ctx_home(ctx);
    if (cfg_cwd_home_shorten(cfg) == 0) { home = 0; }
    return cwd_render(home);
}

# Dispatcher for the `exit` segment. Standard path is "empty on zero,
# `[N]` otherwise". When `hide_zero = false` we paint `[0]` too, so
# the user gets a visible success indicator.
fn _dispatch_exit(cfg, ctx): i64 {
    var code = ctx_last_exit(ctx);
    if (code != 0) { return exit_render(code); }
    if (cfg_exit_hide_zero(cfg) == 1) { return 0; }
    var out = alloc(4);
    store8(out, 91);
    store8(out + 1, 48);
    store8(out + 2, 93);
    store8(out + 3, 0);
    return out;
}

# Dispatcher for the `vcs` segment. Forwards the dirty-marker config
# (or 0 when show_dirty is off) to `vcs_render`, which shells out to
# `sit status` and parses the result. Returns 0 when not in a sit repo
# or sit isn't available — segment renders empty.
fn _dispatch_vcs(cfg, ctx): i64 {
    var marker = 0;
    if (cfg_vcs_show_dirty(cfg) == 1) { marker = cfg_vcs_dirty_marker(cfg); }
    return vcs_render(marker);
}

# Dispatcher for the `time` segment. Forwards the configured strftime-
# subset format to `time_render`. Renders empty when format is null/
# empty (won't happen with defaults, but the user can clear it).
fn _dispatch_time(cfg, ctx): i64 {
    return time_render(cfg_time_format(cfg));
}

# Dispatcher for the `hostname` segment. Pure passthrough — the
# segment has no config knobs in M3.
fn _dispatch_hostname(cfg, ctx): i64 {
    return hostname_render();
}

# Dispatcher for the `user` segment. Pure passthrough — pwd lookup +
# $USER fallback are policy decisions baked into user_render itself.
fn _dispatch_user(cfg, ctx): i64 {
    return user_render();
}

# Dispatcher for the `cyrius_env` segment. Pure passthrough — project
# detection (cyrius.cyml walk) + VERSION-file vs shellout fallback are
# all internal to cyrius_env_render.
fn _dispatch_cyrius_env(cfg, ctx): i64 {
    return cyrius_env_render();
}

# Dispatcher for the `python_env` segment. Pure passthrough —
# $VIRTUAL_ENV basename vs .python-version walk is internal.
fn _dispatch_python_env(cfg, ctx): i64 {
    return python_env_render();
}

# Registry — name → dispatcher fn pointer. Returns 0 for unknown names
# so the caller can emit a single targeted warning.
fn _seg_fn_for(name): i64 {
    if (streq(name, "cwd") == 1)      { return &_dispatch_cwd; }
    if (streq(name, "exit") == 1)     { return &_dispatch_exit; }
    if (streq(name, "vcs") == 1)      { return &_dispatch_vcs; }
    if (streq(name, "time") == 1)     { return &_dispatch_time; }
    if (streq(name, "hostname") == 1) { return &_dispatch_hostname; }
    if (streq(name, "user") == 1)     { return &_dispatch_user; }
    if (streq(name, "cyrius_env") == 1) { return &_dispatch_cyrius_env; }
    if (streq(name, "python_env") == 1) { return &_dispatch_python_env; }
    return 0;
}

fn render_prompt(cfg, ctx): i64 {
    var segs = cfg_segments(cfg);
    var sep = cfg_separator(cfg);
    var sep_len = strlen(sep);
    var trailer = cfg_trailer(cfg);
    var trailer_len = strlen(trailer);

    var n = vec_len(segs);
    var painted = 0;
    var i = 0;
    while (i < n) {
        var name = vec_get(segs, i);
        var fp = _seg_fn_for(name);
        if (fp == 0) {
            syscall(SYS_WRITE, STDERR, "warning: unknown segment '", 26);
            syscall(SYS_WRITE, STDERR, name, strlen(name));
            syscall(SYS_WRITE, STDERR, "' (skipped)\n", 12);
        } else {
            var out = fncall2(fp, cfg, ctx);
            if (out != 0) {
                if (painted == 1) { syscall(SYS_WRITE, STDOUT, sep, sep_len); }
                syscall(SYS_WRITE, STDOUT, out, strlen(out));
                painted = 1;
            }
        }
        i = i + 1;
    }

    syscall(SYS_WRITE, STDOUT, trailer, trailer_len);
    return 0;
}
