# context.cyr — per-invocation context handed to every segment.
#
# Built once in main.cyr at startup from env vars; passed read-only to
# segment dispatchers. Keeps segments pure fns of (cfg, ctx) per ADR
# 0002 — they never touch globals.

var CTX_HOME = 0;
var CTX_LAST_EXIT = 8;
var CTX_SIZE = 16;

fn ctx_home(c): i64 { return load64(c + CTX_HOME); }
fn ctx_last_exit(c): i64 { return load64(c + CTX_LAST_EXIT); }

fn context_new(home, last_exit): i64 {
    var c = alloc(CTX_SIZE);
    store64(c + CTX_HOME, home);
    store64(c + CTX_LAST_EXIT, last_exit);
    return c;
}

# Parse `$AGNOSHI_LAST_EXIT` with a length cap + range clamp. Audit
# finding F-7 (2026-05-18): bare `atoi()` on env input is unbounded
# (CVE-2019-14287 class). Cap the input at 10 digits — INT32_MAX is
# 10 digits, anything longer is either malformed or an overflow
# attempt — and clamp the parsed value to [0, 65535] which covers
# POSIX exit-status (0..255) + signal-killed values (128+sig +
# headroom). 0 on null / empty / non-numeric / over-range matches the
# segment's "treat as success" default behaviour.
fn parse_last_exit(s): i64 {
    if (s == 0) { return 0; }
    var n = strlen(s);
    if (n == 0) { return 0; }
    if (n > 10) { return 0; }
    var v = atoi(s);
    if (v < 0) { return 0; }
    if (v > 65535) { return 65535; }
    return v;
}

# Keep this process off transparent huge pages. main() must call it before the first
# heap touch.
#
# Audit 2026-11-06, O-1. stdlib `alloc` maps a 256 MB chunk, which the kernel aligns
# to a huge-page boundary, so with THP set to `always` the first touch zeroes a whole
# 2 MB page for the few KB a render uses. `args_init`'s 2 MB buffer then moves the bump
# pointer into a second one. That was 104 us of a 400 us cold start, more than
# everything else this program does put together.
#
# PR_SET_THP_DISABLE is 41. It is best effort: an EINVAL changes nothing. The setting
# survives fork and exec, so `sit` runs without THP too, which suits a process that
# gets single-digit milliseconds.
fn thp_opt_out(): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    syscall(SYS_PRCTL, 41, 1, 0, 0, 0);
    #endif
    return 0;
}
