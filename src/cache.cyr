# cache.cyr — per-cwd probe cache with mtime-based TTL.
#
# M6 piece that makes shellout-backed segments (vcs today; future
# `python --version` / `rustup show` if those ever land) cheap enough
# to keep on every redraw. Without it, vcs's ~1.8 ms fork+exec is
# paid once per keystroke; with a 1 s TTL cache, a user typing quickly
# inside a sit repo pays it once per second.
#
# Layout: `/tmp/commandress-<uid>/<segment>-<slot>`, where the slot is the low
# byte of a 64-bit hash of the cwd, as two hex digits. An entry is that hash as 16
# hex digits, then the value. Directory is 0o700 so other users can't peek; files
# are 0o600. mtime is the TTL clock (struct stat offset 88 on Linux x86_64).
#
# EVICTION IS BY CONSTRUCTION. There are 256 file names per segment, so the directory
# cannot grow past that, and a sweep has nothing to do. An entry is dead within two
# seconds of being written, so two directories sharing a slot cost a miss at most. The
# key inside the entry is what stops one reading the other's value. See ADR 0012.
#
# HOST-ONLY. The whole cache is disabled on agnos — see `_cache_stat` and
# `cache_init` below for the reasoning. Every raw `syscall(...)` in this file
# (SYS_MKDIR, SYS_UNLINK, rename #82) is Linux-shaped and is unreachable on
# agnos because `cache_init` sets `_cache_disabled` before any of them run.
#
# Cache values:
#   - heap-alloc'd cstring (possibly empty) → cached value (caller
#     decides how to interpret an empty cstring; vcs_render maps "" →
#     "no sit repo here").
#   - 0 → cache miss: no entry, an expired one, or a slot neighbour's.
#
# Public API:
#   cache_init()                              — idempotent mkdir
#   cache_get(seg, cwd, ttl_secs): i64        — cstring or 0
#   cache_put(seg, cwd, value, value_len)     — write
#
# Out of scope (M6 follow-ups if needed):
#   - Cross-process locking (temp+rename means a reader sees a whole file)
#   - Sub-second TTLs (mtime resolution is 1 s in stat; finer would
#     need stat_x's nsec field; not justified today)

enum CacheLayout {
    CACHE_SLOT_DIGITS = 2;                              # 256 slots per segment
    CACHE_KEY_DIGITS = 16;
    CACHE_ENTRY_MAX = 65536;                            # past any real value
}

# Cached dir path, lazy-built once per invocation.
var _cache_dir = 0;

# F-3 audit (2026-05-18): set to 1 by cache_init when the cache
# directory exists with the wrong owner or permissions. Once set,
# cache_get / cache_put become no-ops for the rest of the process
# lifetime — segments fall back to their uncached probe path. Closes
# the symlink-precreate + permissive-mode class
# (CVE-2023-33865 RenderDoc; CVE-2026-31979 Himmelblau; GHSA-w853-jp5j-5j7f
# py-filelock TOCTOU).
var _cache_disabled = 0;

fn cache_dir(): i64 {
    if (_cache_dir != 0) { return _cache_dir; }
    var uid = syscall(SYS_GETUID);
    var prefix = "/tmp/commandress-";
    var prefix_len = strlen(prefix);
    var uid_buf[32];
    var uid_len = fmt_int_buf(uid, &uid_buf);
    var dir = alloc(prefix_len + uid_len + 1);
    memcpy(dir, prefix, prefix_len);
    memcpy(dir + prefix_len, &uid_buf, uid_len);
    store8(dir + prefix_len + uid_len, 0);
    _cache_dir = dir;
    return dir;
}

# 64-bit FNV-1a of `s` (length `slen`).
#
# This was a 32-bit djb2 until 1.2.2, and djb2's structure makes collisions easy
# rather than merely possible: 33 * 'a' + 'z' == 33 * 'b' + 'Y', so sibling
# directories `az` and `bY` shared an entry, and whichever redrew second showed the
# other's branch. FNV-1a mixes each byte in before the multiply, which removes that
# pattern. It needs no seed: the cache is 0700 and per-UID, so nobody else can aim
# at it, and a key must stay the same across processes.
fn _cache_hash(s, slen): i64 {
    var h = 0xCBF29CE484222325;
    var i = 0;
    while (i < slen) {
        h = (h ^ load8(s + i)) * 0x100000001B3;
        i = i + 1;
    }
    return h;
}

# The low `digits` nibbles of `h`, most significant first, at `out`.
fn _cache_hex(h, digits, out): i64 {
    var i = 0;
    while (i < digits) {
        var nib = (h >> ((digits - 1 - i) * 4)) & 15;
        if (nib < 10) { store8(out + i, 48 + nib); }
        else { store8(out + i, 87 + nib); }
        i = i + 1;
    }
    return 0;
}

# The key for `cwd`: 16 hex digits and a NUL, in a fresh buffer. 0 if alloc refuses.
fn _cache_key_hex(cwd): i64 {
    var out = alloc(CACHE_KEY_DIGITS + 1);
    if (out == 0) { return 0; }
    _cache_hex(_cache_hash(cwd, strlen(cwd)), CACHE_KEY_DIGITS, out);
    store8(out + CACHE_KEY_DIGITS, 0);
    return out;
}

# Build `<cache_dir>/<seg>-<slot>`. Caller owns the returned cstring. 0 if alloc refuses.
fn _cache_path(seg_name, cwd): i64 {
    var dir = cache_dir();
    if (dir == 0) { return 0; }
    var dir_len = strlen(dir);
    var seg_len = strlen(seg_name);
    var h = _cache_hash(cwd, strlen(cwd));

    var total = dir_len + 1 + seg_len + 1 + CACHE_SLOT_DIGITS + 1;
    var out = alloc(total);
    if (out == 0) { return 0; }
    memcpy(out, dir, dir_len);
    store8(out + dir_len, 47);                                  # '/'
    memcpy(out + dir_len + 1, seg_name, seg_len);
    store8(out + dir_len + 1 + seg_len, 45);                    # '-'
    _cache_hex(h, CACHE_SLOT_DIGITS, out + dir_len + 1 + seg_len + 1);
    store8(out + total - 1, 0);
    return out;
}

# lstat(2) for the cache-directory check (audit A-11), with an explicit agnos branch.
#
# The raw `sys_*` wrappers are per-target by design, and agnos's differ. This does
# NOT route through the stdlib's portable `xstat`: that bridges the CALL but not the
# STRUCT, and every offset read below (st_mode @24, st_uid @28, st_size @48,
# st_mtim.tv_sec @88) is Linux x86_64 `struct stat`, while agnos's is a 48-byte all-u64
# record with a different field order and no `st_uid` (userland ABI §4.1). Failing
# closed on agnos is honest and costs nothing: `cache_init` disables the cache there.
#
# agnos also exposes no `sys_lstat` at all, so naming it unguarded fails the `--agnos`
# build as an undefined function even though `cache_init` returns before reaching it.
fn _cache_lstat(path, buf): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_lstat(path, buf);
    #endif
}

# Idempotent mkdir of the cache directory. EEXIST is treated as
# success; any other failure leaves the cache effectively disabled
# (cache_put will silently fail on the missing dir; cache_get's open
# will return ENOENT → miss → fall through to the real probe).
#
# F-3 audit: after mkdir, stat and verify (a) `st_uid == getuid()` and
# (b) `st_mode & 0o777 == 0o700`. On mismatch, sets `_cache_disabled`
# so cache_get / cache_put become no-ops. Closes the case where an
# attacker pre-creates `/tmp/commandress-<uid>/` as 0o777 (file mode
# 0o644 inside that would be world-readable; symlink swaps possible).
fn cache_init(): i64 {
    # AGNOS: the cache is disabled outright, and the F-3 audit is the reason.
    # It cannot be satisfied there — agnos's stat struct (userland ABI §4.1) is a
    # 48-byte all-u64 record with NO `st_uid` field at all, `getuid` is a stub
    # that returns 0 for every process, and `sys_mkdir(path, pathlen)` takes no
    # mode, so 0o700 cannot even be requested. An "audited" cache on agnos would
    # be an audit that always passes, which is worse than no cache. Nothing is
    # lost: `shellout_capture` already returns -1 on agnos (src/shellout.cyr), so
    # the only cacheable value — vcs_render's `sit status` output — is never
    # produced there. Same shape as that degrade.
    #ifdef CYRIUS_TARGET_AGNOS
    _cache_disabled = 1;
    return 0;
    #endif
    var dir = cache_dir();
    syscall(SYS_MKDIR, dir, 0x1c0);                             # 0o700
    var stbuf[144];
    # Audit 2026-08-26, A-11: LSTAT, not stat. F-3 verifies the cache dir is
    # ours and 0o700, but `stat` FOLLOWS symlinks, so a co-tenant who wins the
    # race to create `/tmp/commandress-<uid>` as a symlink pointing at some
    # other directory we own with mode 0700 (say `~/.ssh`) passes both checks —
    # and we then create and rename files inside a directory of THEIR choosing.
    # `lstat` describes the link itself, whose st_mode is S_IFLNK, so the
    # mode check below rejects it and the cache disables. The mkdir above
    # already fails with EEXIST in that case, which is why the stat is the
    # only thing standing between us and the attacker's target.
    if (_cache_lstat(dir, &stbuf) != 0) { _cache_disabled = 1; return 0; }
    var st_mode = load32(&stbuf + 24);                          # struct stat: st_mode @ 24
    # Explicit type gate (A-11). The permission check below would already
    # reject a symlink, since Linux gives symlinks mode 0777 — but relying on
    # that is relying on a coincidence. Require an actual directory.
    if ((st_mode & 0xF000) != 0x4000) { _cache_disabled = 1; return 0; }   # S_IFDIR
    var st_uid  = load32(&stbuf + 28);                          # struct stat: st_uid  @ 28
    var our_uid = syscall(SYS_GETUID);
    if (st_uid != our_uid) { _cache_disabled = 1; return 0; }
    # 0x1ff = 0o777 perm bits mask; 0x1c0 = 0o700 expected.
    if ((st_mode & 0x1ff) != 0x1c0) { _cache_disabled = 1; return 0; }
    return 0;
}

# The value in the open entry `fd`, or 0 unless it is a fresh regular file holding this
# cwd's key. Everything is read from the one fd. Taking the size from stat(path) and the
# bytes from a later open returned a clipped value when a writer renamed between the two,
# which is the wrong hit P-04 exists to prevent (audit 2026-11-06, R-05).
fn _cache_read_entry(fd, cwd, ttl_secs): i64 {
    var stbuf[144];                                             # struct stat is 144 B on x86_64
    if (sys_fstat(fd, &stbuf) != 0) { return 0; }
    if ((load32(&stbuf + 24) & 0xF000) != 0x8000) { return 0; } # S_IFREG
    var mtime_sec = load64(&stbuf + 88);                        # offset of st_mtim.tv_sec
    var now_sec = clock_epoch_secs();
    # Audit 2026-08-26, A-12: the freshness test was one-sided. A mtime in the
    # FUTURE makes `now - mtime` negative, which is never `> ttl_secs`, so the
    # entry counts as fresh forever and the segment serves it for the life of
    # the file. Reachable without an attacker: any backwards clock step (NTP
    # correction, suspend/resume, a VM restored from a snapshot) leaves entries
    # written "in the future" pinned. Treat a future mtime as a miss.
    if (mtime_sec > now_sec) { return 0; }
    if (now_sec - mtime_sec > ttl_secs) { return 0; }

    var file_size = load64(&stbuf + 48);                        # offset of st_size
    if (file_size < CACHE_KEY_DIGITS) { return 0; }
    if (file_size > CACHE_ENTRY_MAX) { return 0; }
    var buf = alloc(file_size + 1);
    if (buf == 0) { return 0; }
    var n = file_read(fd, buf, file_size);
    if (n < CACHE_KEY_DIGITS) { return 0; }
    var key = _cache_key_hex(cwd);
    if (key == 0) { return 0; }
    if (memeq(buf, key, CACHE_KEY_DIGITS) != 1) { return 0; }   # a slot neighbour's entry
    store8(buf + n, 0);
    return buf + CACHE_KEY_DIGITS;
}

# Return cached cstring (possibly empty) when this cwd has a fresh entry, else 0. The
# "possibly empty" case is real — vcs_render caches "" to remember "no sit repo here",
# short-circuiting the fork+exec on the next redraw.
#
# F-4 audit: O_NOFOLLOW so a symlink swap on the cache file (e.g. attacker symlinks
# `vcs-ab` → `/etc/shadow`) refuses to traverse — open returns ELOOP → cache miss →
# segment runs the real probe + cache_put writes a fresh file. O_NONBLOCK so a FIFO
# cannot park the open, and the S_IFREG gate above then refuses it (audit A-01).
fn cache_get(seg_name, cwd, ttl_secs): i64 {
    if (_cache_disabled == 1) { return 0; }
    var path = _cache_path(seg_name, cwd);
    if (path == 0) { return 0; }
    # O_RDONLY | O_NONBLOCK | O_NOFOLLOW = 0 + 2048 + 131072. stdlib doesn't export
    # these on every target, so they are written numerically (the file is host-only).
    var fd = file_open(path, 133120, 0);
    if (fd < 0) { return 0; }
    var value = _cache_read_entry(fd, cwd, ttl_secs);
    file_close(fd);
    return value;
}

# `ulimit -f 0` made the write below raise SIGXFSZ, which kills the process: the prompt
# was cut short, and a temp was left behind on every redraw (audit 2026-11-06, R-04).
# Ignored, the write fails with EFBIG and takes the short-write path. rt_sigaction is
# 13 on x86_64, and this file is x86_64 already (see rename below); SIG_IGN is 1.
fn _cache_ignore_sigxfsz(): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    var act[32];
    memset(&act, 0, 32);
    store64(&act, 1);
    syscall(13, 25, &act, 0, 8);
    #endif
    return 0;
}

# F-5 audit: write atomically via `<path>.tmp.<pid>` + rename.
# `O_CREAT | O_EXCL | O_NOFOLLOW` ensures we create a fresh file
# whose final-component is not a symlink — if a co-uid attacker
# pre-created the temp file or symlinked it, the open fails (EEXIST
# / ELOOP) and we skip the cache write. The rename(2) is atomic on
# POSIX so a concurrent cache_get either sees the old file or the
# new one, never a torn write. Mode 0o600 (tightened from the prior
# 0o644 file_write_all) closes F-11.
fn cache_put(seg_name, cwd, value, value_len): i64 {
    if (_cache_disabled == 1) { return 0; }
    var path = _cache_path(seg_name, cwd);
    var key = _cache_key_hex(cwd);
    var entry = alloc(CACHE_KEY_DIGITS + value_len);
    if (path == 0) { return 0; }
    if (key == 0) { return 0; }
    if (entry == 0) { return 0; }
    memcpy(entry, key, CACHE_KEY_DIGITS);
    if (value_len > 0) { memcpy(entry + CACHE_KEY_DIGITS, value, value_len); }
    var path_len = strlen(path);

    # Build "<path>.tmp.<pid>".
    var suffix = ".tmp.";
    var suffix_len = strlen(suffix);
    var pid_buf[24];
    var pid_len = fmt_int_buf(syscall(SYS_GETPID), &pid_buf);
    var tmp_path = alloc(path_len + suffix_len + pid_len + 1);
    if (tmp_path == 0) { return 0; }
    memcpy(tmp_path, path, path_len);
    memcpy(tmp_path + path_len, suffix, suffix_len);
    memcpy(tmp_path + path_len + suffix_len, &pid_buf, pid_len);
    store8(tmp_path + path_len + suffix_len + pid_len, 0);

    _cache_ignore_sigxfsz();

    # O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW = 1 | 64 | 128 | 131072.
    # 0x180 = 0o600 (owner read+write, others none).
    var flags = 1 + 64 + 128 + 131072;
    var fd = file_open(tmp_path, flags, 0x180);
    if (fd < 0) {
        # Stale temp from a crashed previous run? Unlink + retry once.
        syscall(SYS_UNLINK, tmp_path);
        fd = file_open(tmp_path, flags, 0x180);
        if (fd < 0) { return 0; }
    }
    # Audit 2026-08-26, P-04: the write result used to be discarded. The
    # temp+rename dance (F-5) buys atomicity — a reader never sees a torn
    # file — but atomicity is not integrity: renaming a SHORT write into
    # place publishes a truncated value as though it were complete, and
    # cache_get has no way to tell. The next redraw then renders a clipped
    # branch name from cache for the whole TTL. Verify the byte count and
    # abandon the temp if it is short, so a failed write degrades to a
    # cache MISS (correct, just uncached) instead of a wrong hit.
    var entry_len = CACHE_KEY_DIGITS + value_len;
    var written = file_write(fd, entry, entry_len);
    file_close(fd);
    if (written != entry_len) {
        syscall(SYS_UNLINK, tmp_path);
        return 0;
    }

    # SYS_RENAME = 82 on x86_64 Linux. Atomic — concurrent readers see
    # the old file or the new one, never a torn write.
    if (syscall(82, tmp_path, path) != 0) { syscall(SYS_UNLINK, tmp_path); }
    return 0;
}
