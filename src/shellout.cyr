# shellout.cyr — generic fork+exec helper with a per-call time budget.
#
# Used by segments that shell out and need to respect the render-time
# budget (vcs today, language-env in M4). Forks the child, captures
# stdout into the caller's buffer, redirects stderr to /dev/null,
# enforces a millisecond-resolution deadline via epoll_wait, and
# kills the child on overrun.
#
# Contract:
#   shellout_capture(cmd_path, argv, envp, budget_ms, buf, buflen)
# returns:
#   >= 0   — bytes captured into `buf` (may be 0 if the child wrote
#            nothing before exiting cleanly)
#   -1     — system error during setup (pipe / fork / epoll failed);
#            caller should treat as empty render
#   -2     — child exceeded `budget_ms`; SIGKILL'd and reaped; caller
#            should treat as empty render
#
# `argv` and `envp` are caller-owned NULL-terminated arrays of cstring
# pointers — this fn never allocates them. `budget_ms` is clamped to a
# 1 ms minimum because epoll_wait timeout is ms-resolution; sub-ms
# budgets land in M6 alongside parallel segment evaluation.

fn shellout_capture(cmd_path, argv, envp, budget_ms, buf, buflen): i64 {
    # AGNOS has no userland fork/exec-of-external-binaries yet — that lands with
    # the 1.43.x execwait work. So this fork+exec+wait helper returns -1
    # ("no output") on agnos; callers (git/tool prompt segments) treat that as
    # "unavailable" and skip the segment. The static prompt still renders.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var budget = budget_ms;
    if (budget < 1) { budget = 1; }

    var pipefd[16];
    if (sys_pipe(&pipefd) < 0) { return 0 - 1; }
    var rfd = load32(&pipefd);
    var wfd = load32(&pipefd + 4);

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(rfd);
        sys_close(wfd);
        return 0 - 1;
    }
    if (pid == 0) {
        sys_close(rfd);
        sys_dup2(wfd, 1);
        sys_close(wfd);
        # O_WRONLY = 1 (mirrors lib/process.cyr::run_capture's literal;
        # io.cyr's constants are a different dependency footgun).
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) {
            sys_dup2(devnull, 2);
            sys_close(devnull);
        }
        sys_execve(cmd_path, argv, envp);
        sys_exit(127);
    }

    # Parent: arm an epoll watch on the read end + a clock_now_ms
    # deadline. Each iteration: poll for budget remaining, read on
    # readiness, exit when the child closes the pipe (n == 0) or the
    # deadline expires.
    sys_close(wfd);

    var ep = sys_epoll_create();
    if (ep < 0) {
        sys_kill(pid, SIGKILL);
        sys_close(rfd);
        var stbuf_err[8];
        sys_waitpid(pid, &stbuf_err, 0);
        return 0 - 1;
    }
    var ev = epoll_event_new(EPOLLIN, rfd);
    sys_epoll_ctl(ep, EPOLL_CTL_ADD, rfd, ev);

    var deadline_ms = clock_now_ms() + budget;
    var events_buf = alloc(16);
    var total = 0;
    var timed_out = 0;
    var sys_err = 0;
    var done = 0;
    while (done == 0) {
        var remaining = deadline_ms - clock_now_ms();
        if (remaining <= 0) {
            timed_out = 1;
            done = 1;
        } else {
            var nev = sys_epoll_wait(ep, events_buf, 1, remaining);
            if (nev < 0) {
                sys_err = 1;
                done = 1;
            } else {
                if (nev == 0) {
                    timed_out = 1;
                    done = 1;
                } else {
                    var space = buflen - total;
                    if (space <= 0) { done = 1; }
                    else {
                        var n = sys_read(rfd, buf + total, space);
                        if (n <= 0) { done = 1; }
                        else { total = total + n; }
                    }
                }
            }
        }
    }

    sys_close(ep);

    # KILL UNCONDITIONALLY, then close, then wait. All three, in this order.
    # (audit 2026-08-26, A-02 HIGH / P-05.)
    #
    # The read loop has three exits and only ONE of them used to kill the
    # child. Both of the others leave a live child and a parent about to
    # block in waitpid, which NO DEADLINE COVERS — the budget is enforced by
    # epoll_wait, and by this point we have left that loop for good:
    #
    #   - buffer full (`space <= 0`): child still running, still writing.
    #     This one happened to be survivable, because closing the read end
    #     below makes its next write die on EPIPE/SIGPIPE. Verified: a child
    #     flooding 200 KB through a 256-byte buffer returned in 5 ms.
    #   - EOF (`n <= 0`) with the child STILL ALIVE: a child that closes or
    #     redirects its stdout and then keeps running hits this, and the
    #     EPIPE trick does NOT save us — it is not writing, so it never
    #     notices the closed pipe. Verified as a real hang: a fake `cyrius`
    #     on PATH doing `exec 1>&-; sleep 30` parked the prompt for the full
    #     30 s against a 5 ms budget.
    #
    # So the kill is no longer conditional on `timed_out`. Once we have
    # stopped reading, the child's exit status is irrelevant — `stbuf` is
    # discarded, and the return value is decided by the flags below — so
    # there is nothing to lose by killing it and everything to lose by
    # waiting on it. SIGKILL on an already-exited child is a harmless no-op
    # (it is a zombie until we reap it, and kill(2) on a zombie succeeds).
    #
    # `timed_out` still decides the RETURN VALUE; it just no longer decides
    # whether we are willing to hang.
    sys_kill(pid, SIGKILL);

    # close(rfd) still precedes waitpid — belt and braces for the buffer-full
    # case, and it releases the fd before we block. Pinned by
    # tests/commandress.tcyr::test_shellout_oversized_child_does_not_hang and
    # ::test_shellout_eof_with_live_child_does_not_hang.
    sys_close(rfd);
    var stbuf[8];
    sys_waitpid(pid, &stbuf, 0);

    if (sys_err == 1) { return 0 - 1; }
    if (timed_out == 1) { return 0 - 2; }
    return total;
    #endif
}
