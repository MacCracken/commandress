# monokai — vivid neon palette.
#
# Source: TextMate / Sublime Text default — ported everywhere.
# Aesthetic: bright greens + magentas + warm yellow + cyan, all on
# dark grey. The original "code looks like art" palette.
#
# Best with a terminal running a monokai 16-color theme. Default-
# palette terminals still work — the bindings just resolve to your
# normal green / magenta / etc.

[[prompt]]
segments  = ["cwd", "vcs", "cyrius_env", "python_env", "node_env", "rustup_env", "exit"]
separator = " "
trailer   = " $ "

[[palette]]
neon_green = "bright_green"    # monokai green — strings / clean
hot_pink   = "bright_magenta"  # monokai pink — keywords / accents
warm_amber = "bright_yellow"   # monokai yellow — emphasis
cool_cyan  = "bright_cyan"     # monokai cyan — info
violet     = "magenta"         # monokai purple — numbers / context
orange_red = "bright_red"      # monokai orange — errors / warnings
cream      = "white"           # neutral foreground
dim        = "bright_black"    # comment / muted

[[segments.cwd]]
fg    = "palette:cool_cyan"
style = "bold"

[[segments.vcs]]
fg = "palette:warm_amber"

[[segments.time]]
fg = "palette:dim"

[[segments.hostname]]
fg = "palette:violet"

[[segments.user]]
fg    = "palette:neon_green"
style = "bold"

[[segments.cyrius_env]]
fg = "palette:hot_pink"

[[segments.python_env]]
fg = "palette:warm_amber"

[[segments.node_env]]
fg = "palette:neon_green"

[[segments.rustup_env]]
fg = "palette:orange_red"

[[segments.exit]]
fg    = "palette:orange_red"
style = "bold"
