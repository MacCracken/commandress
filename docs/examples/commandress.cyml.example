# Annotated commandress config — every knob, with the reasoning.
# Copy to ~/.commandress (no extension) and delete what you don't need;
# anything omitted falls back to the baked-in default.
#
# SECTION SPELLING: `[[name]]` is canonical and is what every shipped theme
# uses. Single-bracket `[name]` is also accepted and behaves identically —
# the `[[X]]` form began as a workaround for a stdlib parser gap that has
# since closed. Either works; pick one and be consistent.

# Optional, and must sit above the first table: picks a [[palettes.<name>]] below. It
# overrides [[palette]] slot by slot, so a palette only names what it changes. An
# unknown name warns on stderr and leaves [[palette]] in force.
# palette = "light"

[[prompt]]
# Segment order — left-to-right. Names must match registered segments
# (see render.cyr::_seg_fn_for). Unknown names warn to stderr; they
# don't abort the prompt.
segments = ["cwd", "vcs", "exit"]

# Inserted between adjacent painted segments.
separator = " "

# Painted unconditionally at the end of the line. Include any leading
# whitespace you want before the prompt-character.
trailer = " $ "

[[segments.cwd]]
# Every segment takes `fg`, `bg` and `style`. A color is one of the 16 names ("red",
# "bright_cyan"), a 256-colour index ("117"), or hex ("#8be9fd"), which needs a
# truecolor terminal. Anything else renders with no color and no warning. `style` is
# any of: bold italic underline reverse.
#
# When true and the cwd is exactly $HOME or under it, the HOME prefix
# is rewritten as "~". Strict prefix only — /home/macroX won't match
# /home/macro.
home_shorten = true

[[segments.exit]]
# When true (default), exit code 0 paints nothing — a clean prompt for
# the common case. Set false to always show "[N]" including "[0]".
hide_zero = true

[[segments.vcs]]
# When true (default), a dirty tree shows the marker character after
# the branch name (e.g. "main*"). Set false to suppress the marker.
show_dirty = true

# Single character (or short string) appended to the branch name when
# the working tree is dirty. The default "*" matches the convention
# from starship/p10k.
dirty_marker = "*"

# Every segment takes max_length, in bytes, 0 for no limit. A cut ends in
# "...", and this one keeps the dirty marker. It defaults to 128 here and
# on the language segments, because a repo chooses the text. The other
# segments default to no limit.
# max_length = 32

# Milliseconds `sit status` may run before the segment renders empty. A
# whole number from 1 to 1000; anything else warns and keeps the default.
# Raise it for a slow disk or a very large repo. A hung `sit` then costs
# this much on every redraw outside the 1-second cache.
budget_ms = 5

[[segments.node_env]]
# The time segment shows local time, as `date` does: TZ, else /etc/localtime,
# else UTC. utc = true shows UTC whatever the zone.
#
# A pin is the first word of its first line that is not blank or a # comment,
# at most 64 ASCII characters. A pin that is a symlink must end at a file of
# the same name. See docs/adr/0015.
#
# python_env, node_env and rustup_env can ask the tool when there is no pin file, inside a
# project. Off by default. It runs from / so a repo cannot steer it, which means it shows
# your machine's version, cached for 60 s. See docs/adr/0014.
# shellout  = true
# budget_ms = 100

---

# Notes zone

Everything below the `---` is ignored by the loader. Use it for theme
references, segment recipes, links — anything you want to keep next to
the config it documents.

## Available segments (v0.3.0)

- `cwd` — current working directory (optional `~` home-shortening).
- `vcs` — current branch + dirty/clean state via [sit](https://github.com/MacCracken/sit). Renders empty when not in a `sit` repo or `sit` isn't on PATH.
- `exit` — last-command exit code (optional hide on success).

More segments land in M3+ (time, hostname, user, language env).
