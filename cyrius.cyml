[package]
name = "commandress"
version = "${file:VERSION}"
description = "commandress — structured prompt renderer for agnoshi (cmdrs binary)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.1.14"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "cmdrs"

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert"]
---
