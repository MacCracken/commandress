[package]
name = "commandress"
version = "0.1.0"
description = "commandress — structured prompt renderer for agnoshi (cmdrs binary)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "5.11.54"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "cmdrs"

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert"]
---
